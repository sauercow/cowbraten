/* Cowbraten 1.1.0 / match score HUD
   Drawn at top center, BELOW the normal short console's safe area.
   If your console uses more rows, increase `top` here rather than moving it left. */
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
    pointer-events: none;
}
.cow-match-hud-top {
    position: absolute;
    top: 25px;
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    pointer-events: none;
}
.cow-match-hud-strip {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}
.cow-match-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 47px;
    min-width: 86px;
    padding: 0 13px;
    margin: 0 3px;
    border-width: 1px;
    border-style: solid;
    border-radius: 9px;
    background-color: #131B27EC;
    color: #F7FAFF;
}
.cow-match-chip-blue {
    background-color: #092847ED;
    border-color: #168FFF;
    color: #68BDFF;
}
.cow-match-chip-clock {
    min-width: 118px;
    padding: 0 15px;
    background-color: #141D2BED;
    border-color: #607388;
    color: #FFFFFF;
}
.cow-match-chip-red {
    background-color: #422028ED;
    border-color: #F04454;
    color: #FF7180;
}
.cow-match-value {
    font-size: 31px;
    font-weight: bold;
    text-align: center;
}
.cow-match-clock-value {
    font-size: 27px;
    font-weight: bold;
    text-align: center;
}
@media (max-width: 1000px) {
    .cow-match-hud-top { top: 48px; }
    .cow-match-chip {
        height: 38px;
        min-width: 64px;
        padding: 0 9px;
        margin: 0 2px;
    }
    .cow-match-chip-clock { min-width: 90px; }
    .cow-match-value { font-size: 24px; }
    .cow-match-clock-value { font-size: 21px; }
}
