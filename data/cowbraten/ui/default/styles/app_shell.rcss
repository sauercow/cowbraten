body
{
    background-color: transparent;
}

.app-shell
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-background);
}

.app-header
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 72dp;
    padding: 0 24dp;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.app-lockup
{
    display: flex;
    align-items: center;
    gap: 16dp;
}

.app-mark
{
    box-sizing: border-box;
    width: 40dp;
    height: 40dp;
    flex: none;
    background-color: var(--color-secondary);
    border-width: 1dp;
    border-color: var(--color-secondary-hover);
    border-radius: var(--radius-control);
    color: var(--color-background);
    font-size: 24dp;
    line-height: 38dp;
    text-align: center;
}

.app-lockup-copy,
.app-product,
.app-product-subtitle
{
    display: block;
}

.app-product
{
    color: var(--color-text);
    font-size: 18dp;
    line-height: 20dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.app-product-subtitle
{
    color: var(--color-primary);
    font-size: 10dp;
    line-height: 15dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.app-return
{
    min-width: 184dp;
}

.app-return .cb-ico
{
    margin-right: 9dp;
}

.app-frame
{
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

.app-sidebar
{
    box-sizing: border-box;
    display: flex;
    flex: 0 0 280dp;
    width: 280dp;
    min-width: 280dp;
    max-width: 280dp;
    min-height: 0;
    padding: 24dp;
    flex-direction: column;
    background-color: var(--color-background);
    border-right-width: 1dp;
    border-right-color: var(--color-border);
}

.app-navigation-label
{
    display: block;
    margin-bottom: 16dp;
    color: var(--color-primary);
    font-size: 12dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.app-sidebar .app-navigation
{
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

.app-sidebar .app-nav-item
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 48dp;
    padding: 0 16dp;
    align-items: center;
    border-left-width: 3dp;
    border-left-color: transparent;
    line-height: 46dp;
}

.app-nav-icon
{
    display: block;
    flex: none;
    margin-right: 16dp;
    image-color: var(--color-disabled);
}

.app-nav-label
{
    display: block;
    flex: 1;
    min-width: 0;
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.app-sidebar .app-nav-item:hover,
.app-sidebar .app-nav-item:focus-visible
{
    background-color: var(--color-surface-2);
    border-left-color: var(--color-primary-hover);
    color: var(--color-text);
}

.app-page-games .app-nav-games,
.app-page-servers .app-nav-servers,
.app-page-demos .app-nav-demos,
.app-page-profile .app-nav-profile,
.app-page-settings .app-nav-settings,
.app-page-system .app-nav-system
{
    background-color: var(--color-surface-2);
    border-left-color: var(--color-primary);
    color: var(--color-primary);
}

.app-page-games .app-nav-games .app-nav-icon,
.app-page-servers .app-nav-servers .app-nav-icon,
.app-page-demos .app-nav-demos .app-nav-icon,
.app-page-profile .app-nav-profile .app-nav-icon,
.app-page-settings .app-nav-settings .app-nav-icon,
.app-page-system .app-nav-system .app-nav-icon
{
    image-color: var(--color-primary);
}

.app-sidebar .app-nav-item:hover .app-nav-icon,
.app-sidebar .app-nav-item:focus-visible .app-nav-icon
{
    image-color: var(--color-primary-hover);
}

.app-sidebar .app-nav-exit:hover .app-nav-icon,
.app-sidebar .app-nav-exit:focus-visible .app-nav-icon
{
    image-color: var(--color-error);
}

.app-sidebar-spacer
{
    flex: 1;
}

.app-navigation-utility
{
    padding-top: 16dp;
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.app-sidebar .app-nav-exit:hover,
.app-sidebar .app-nav-exit:focus-visible
{
    border-left-color: var(--color-error);
    color: var(--color-error);
}

.app-content
{
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--color-surface);
}

.app-footer
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 40dp;
    padding: 0 24dp;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface-2);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 9dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.app-footer-status
{
    color: var(--color-success);
}

.app-footer-status span
{
    display: inline-block;
    width: 7dp;
    height: 7dp;
    margin-right: 6dp;
    background-color: var(--color-success);
    border-radius: 4dp;
}

/* Existing screens now provide content only; the shared template owns chrome. */
.app-content .servers-screen,
.app-content .demos-screen,
.app-content .settings-screen,
.app-content .profile-screen
{
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: transparent;
}

.app-content .servers-shell,
.app-content .demos-shell,
.app-content .settings-shell,
.app-content .profile-shell
{
    width: 100%;
    height: 100%;
    border-width: 0;
    border-radius: 0;
}

.app-content .servers-header,
.app-content .servers-footer,
.app-content .demos-header,
.app-content .demos-footer,
.app-content .settings-header,
.app-content .settings-footer,
.app-content .profile-header,
.app-content .profile-navigation,
.app-content .profile-footer
{
    display: none;
}

.app-content .profile-content,
.app-content .settings-content
{
    width: 100%;
    height: 100%;
}

@media (max-width: 1100dp)
{
    .app-sidebar
    {
        flex-basis: 280dp;
        width: 280dp;
        min-width: 280dp;
        max-width: 280dp;
    }
}
