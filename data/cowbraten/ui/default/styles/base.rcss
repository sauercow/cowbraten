body
{
    --color-background: #0E1012;
    --color-surface: #171A1D;
    --color-surface-2: #202428;
    --color-overlay-panel: #0B1015ED;
    --color-border: #30343A;
    --color-text: #E6E7EA;
    --color-text-muted: #A8ADB3;

    --color-primary: #4EA3FF;
    --color-primary-hover: #78B9FF;
    --color-primary-pressed: #2F7CCB;
    --color-secondary: #FF8A3D;
    --color-secondary-hover: #FFA46A;
    --color-secondary-pressed: #C9682D;

    --color-success: #32C168;
    --color-warning: #E3B341;
    --color-error: #E04B4B;
    --color-error-hover: #F06464;
    --color-error-pressed: #B83939;
    --color-disabled: #5A5F66;

    --space-1: 8dp;
    --space-2: 16dp;
    --space-3: 24dp;
    --space-4: 32dp;
    --space-5: 40dp;
    --space-6: 48dp;
    --space-8: 64dp;

    --radius-control: 2dp;
    --radius-panel: 4dp;

    /*
     * Semantic typography tokens. Screens should consume these instead of
     * naming a typeface or repeating the common text sizes directly. This
     * keeps theme and future accessibility presets small and predictable.
     */
    --font-interface: Lato;
    --font-size-caption: 8dp;
    --font-size-label: 9dp;
    --font-size-control: 10dp;
    --font-size-metadata: 11dp;
    --font-size-small: 12dp;
    --font-size-body: 13dp;
    --font-size-body-large: 14dp;
    --font-size-subtitle: 16dp;
    --font-size-title: 20dp;
    --font-size-display: 32dp;
    --letter-spacing-label: 1dp;
    --letter-spacing-title: 2dp;

    margin: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;

    background-color: var(--color-background);
    color: var(--color-text);

    font-family: var(--font-interface);
    font-style: normal;
    font-weight: normal;
    font-size: var(--font-size-subtitle);
    line-height: 1.35;
}

/*
 * Keep overflow discoverable across every screen. RmlUi only creates these
 * internal elements when a container actually overflows, so the thumb is a
 * reliable indication that more content is available without reserving space
 * on short lists and pages that already fit.
 */
scrollbarvertical
{
    width: 10dp;
    background-color: transparent;
}

scrollbarvertical slidertrack
{
    width: 9dp;
    background-color: transparent;
}

scrollbarvertical sliderbar
{
    width: 6dp;
    min-height: 32dp;
    margin-left: 2dp;
    background-color: var(--color-disabled);
    border-radius: var(--radius-control);
}

scrollbarvertical sliderbar:hover
{
    background-color: var(--color-primary-pressed);
}

scrollbarvertical sliderbar:active
{
    background-color: var(--color-primary);
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc
{
    width: 0;
    height: 0;
}

scrollbarhorizontal
{
    height: 10dp;
    background-color: transparent;
}

scrollbarhorizontal slidertrack
{
    height: 9dp;
    background-color: transparent;
}

scrollbarhorizontal sliderbar
{
    height: 6dp;
    min-width: 32dp;
    margin-top: 2dp;
    background-color: var(--color-disabled);
    border-radius: var(--radius-control);
}

scrollbarhorizontal sliderbar:hover
{
    background-color: var(--color-primary-pressed);
}

scrollbarhorizontal sliderbar:active
{
    background-color: var(--color-primary);
}

scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc
{
    width: 0;
    height: 0;
}

.cube-color-0 { color: #40FF80; }
.cube-color-1 { color: #1A76FF; }
.cube-color-2 { color: #FFC040; }
.cube-color-3 { color: #ED2B2C; }
.cube-color-4 { color: #A0A0A0; }
.cube-color-5 { color: #C040C0; }
.cube-color-6 { color: #FF8000; }
.cube-color-7 { color: #FFFFFF; }
.cube-color-8 { color: #60F0FF; }
.cube-color-9 { color: #B5B5B5; }

.screen
{
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 100%;
    padding: var(--space-3);
    overflow-y: auto;
}

.workbench
{
    box-sizing: border-box;
    display: block;
    width: 1040dp;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
}

.panel
{
    box-sizing: border-box;
    display: block;
    background-color: var(--color-surface);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-panel);
}

.workbench-header
{
    display: block;
    padding: var(--space-3);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.eyebrow
{
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-primary);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-title);
    text-transform: uppercase;
}

.display-title
{
    display: block;
    font-size: var(--font-size-display);
    line-height: 1;
    letter-spacing: var(--letter-spacing-title);
    text-transform: uppercase;
}

.section-title
{
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-size: var(--font-size-subtitle);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
}

.body-copy
{
    display: block;
    color: var(--color-text-muted);
    font-size: var(--font-size-body-large);
}

.data-text
{
    display: block;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
}

.component-grid
{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3);
}

.component-card
{
    display: block;
    width: 480dp;
    min-height: 176dp;
    padding: var(--space-2);
}

.control-row
{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
}

.control-stack
{
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

.field-label
{
    color: var(--color-text-muted);
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.status-row
{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
}

.status
{
    box-sizing: border-box;
    height: 24dp;
    padding: 0 var(--space-1);
    background-color: var(--color-surface-2);
    border-left-width: 3dp;
    border-left-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 12dp;
    line-height: 24dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.status-success
{
    border-left-color: var(--color-success);
}

.status-warning
{
    border-left-color: var(--color-warning);
}

.status-error
{
    border-left-color: var(--color-error);
}
