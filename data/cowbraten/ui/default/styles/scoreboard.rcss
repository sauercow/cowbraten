body
{
    background-color: transparent;
}

.scoreboard-overlay
{
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 9, 72);
}

.scoreboard-panel
{
    box-sizing: border-box;
    display: flex;
    width: 88%;
    max-width: 1380dp;
    max-height: 90%;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-overlay-panel);
    border-width: 1dp;
    border-color: #52606D;
    border-radius: 5dp;
}

.scoreboard-header
{
    box-sizing: border-box;
    position: relative;
    display: flex;
    width: 100%;
    min-height: 86dp;
    padding: 12dp 24dp 20dp 24dp;
    flex: none;
    align-items: center;
    justify-content: space-between;
    background-color: #10161CE8;
}

.scoreboard-identity
{
    box-sizing: border-box;
    display: block;
    width: 70%;
    min-width: 0;
    padding-right: 18dp;
    flex: none;
}

.scoreboard-kicker,
.scoreboard-server,
.scoreboard-match
{
    display: block;
}

.scoreboard-kicker
{
    color: var(--color-secondary);
    font-size: 8dp;
    line-height: 11dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.scoreboard-server
{
    margin-top: 1dp;
    overflow: hidden;
    color: var(--color-text);
    font-size: 21dp;
    line-height: 24dp;
    letter-spacing: 2dp;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.scoreboard-match
{
    margin-top: 1dp;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 9dp;
    line-height: 12dp;
    letter-spacing: 2dp;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.scoreboard-time
{
    box-sizing: border-box;
    display: flex;
    width: 30%;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    gap: 9dp;
    color: var(--color-primary);
}

.scoreboard-time span
{
    width: 18dp;
    height: 18dp;
}

.scoreboard-time strong
{
    font-size: 21dp;
    font-weight: normal;
    letter-spacing: 2dp;
}

.scoreboard-header-rule
{
    position: absolute;
    display: block;
    height: 2dp;
    right: 24dp;
    bottom: 10dp;
    left: 24dp;
    background-color: #3B4651;
}

.scoreboard-header-rule span
{
    display: block;
    width: 62dp;
    height: 2dp;
    background-color: var(--color-secondary);
}

.scoreboard-scroll
{
    display: block;
    width: 100%;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 1;
    overflow-x: auto;
    overflow-y: auto;
}

.scoreboard-repeat
{
    display: block;
    width: 100%;
}

.scoreboard-row
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    min-width: 720dp;
    align-items: center;
}

.scoreboard-columns
{
    min-height: 34dp;
    padding: 0 18dp;
    background-color: #151C23E8;
    border-top-width: 1dp;
    border-top-color: #26313B;
    border-bottom-width: 1dp;
    border-bottom-color: #26313B;
    color: #CDD3DA;
    font-size: 9dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.score-column-name
{
    gap: 16dp;
}

.score-column-name i,
.score-column i
{
    flex: none;
    image-color: #D6DCE2;
}

.score-column
{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7dp;
}

.score-column b
{
    display: block;
    font-weight: normal;
}

.scoreboard-group
{
    box-sizing: border-box;
    display: block;
    min-height: 27dp;
    padding: 9dp 22dp 0 22dp;
    color: var(--color-primary);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.scoreboard-group.is-good-team
{
    color: #45A3FF;
}

.scoreboard-group.is-evil-team
{
    color: #F05A5A;
}

.scoreboard-player
{
    min-height: 37dp;
    margin: 0 12dp 4dp 12dp;
    padding: 0 10dp;
    width: auto;
    background-color: #111820;
    border-width: 1dp;
    border-color: #25313C;
    border-radius: 4dp;
    color: var(--color-text);
}

.scoreboard-player.is-local
{
    background-color: #10283DD9;
    border-left-width: 4dp;
    border-left-color: var(--color-primary);
}

.scoreboard-player.is-good-team
{
    background-color: #0D2942D9;
    border-left-width: 4dp;
    border-left-color: #1685FF;
}

.scoreboard-player.is-evil-team
{
    background-color: #35171BD9;
    border-left-width: 4dp;
    border-left-color: #E04B4B;
}

.scoreboard-player.is-local .score-name strong
{
    color: #FFFFFF;
}

.scoreboard-player.is-spectator
{
    color: var(--color-text-muted);
}

.scoreboard-player.is-dead
{
    opacity: 0.62;
}

.score-name
{
    display: flex;
    width: 240dp;
    min-width: 240dp;
    min-height: 0;
    flex: 1;
    align-items: center;
    gap: 7dp;
    overflow: hidden;
}

.score-name strong
{
    overflow: hidden;
    font-size: 11dp;
    font-weight: normal;
    letter-spacing: 1dp;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.score-name small
{
    color: var(--color-secondary);
    font-size: 8dp;
    letter-spacing: 1dp;
}

.score-player-icon
{
    flex: none;
    image-color: #AEB9C4;
}

.score-local-dot
{
    display: block;
    width: 6dp;
    height: 6dp;
    flex: none;
    background-color: var(--color-success);
    border-radius: 3dp;
}

.score-stat
{
    box-sizing: border-box;
    width: 72dp;
    min-width: 72dp;
    padding-right: 12dp;
    border-left-width: 1dp;
    border-left-color: #2D3944;
    font-size: 11dp;
    text-align: right;
}

.scoreboard-columns .score-stat
{
    padding-right: 0;
    font-size: 9dp;
    text-align: center;
}

.score-cn
{
    width: 60dp;
    min-width: 60dp;
}

.score-frags
{
    width: 88dp;
    min-width: 88dp;
}

.score-deaths
{
    width: 96dp;
    min-width: 96dp;
}

.scoreboard-teams
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    padding: 0 8dp 8dp 8dp;
    align-items: flex-start;
    gap: 8dp;
}

.scoreboard-team
{
    display: block;
    width: 50%;
    min-width: 0;
    overflow: hidden;
}

.scoreboard-team .scoreboard-group
{
    padding-left: 12dp;
}

.scoreboard-team .scoreboard-row
{
    min-width: 0;
}

.scoreboard-team .scoreboard-columns
{
    padding: 0 8dp;
}

.scoreboard-team .scoreboard-player
{
    margin-right: 0;
    margin-left: 0;
    padding: 0 7dp;
}

.scoreboard-team .score-name
{
    width: 130dp;
    min-width: 130dp;
    gap: 5dp;
}

.scoreboard-team .score-stat,
.scoreboard-team .score-frags,
.scoreboard-team .score-deaths
{
    width: 48dp;
    min-width: 48dp;
    padding-right: 0;
    text-align: center;
}

.scoreboard-team .score-cn
{
    width: 38dp;
    min-width: 38dp;
}

.scoreboard-team .scoreboard-columns .score-stat
{
    padding-right: 0;
}

.scoreboard-team .score-column b
{
    display: none;
}

.scoreboard-spectators
{
    display: block;
    padding: 0 8dp 8dp 8dp;
}

.scoreboard-spectators .scoreboard-group
{
    min-height: 24dp;
    padding: 6dp 12dp 0 12dp;
    color: var(--color-text-muted);
}

.scoreboard-spectator-grid
{
    display: flex;
    flex-wrap: wrap;
    gap: 4dp;
}

.scoreboard-spectator
{
    box-sizing: border-box;
    display: flex;
    width: 24.6%;
    min-height: 30dp;
    padding: 0 9dp;
    align-items: center;
    gap: 7dp;
    overflow: hidden;
    background-color: #111820C8;
    border-width: 1dp;
    border-color: #25313C;
    border-radius: 4dp;
    color: var(--color-text-muted);
}

.scoreboard-spectator strong
{
    overflow: hidden;
    flex: 1;
    font-size: 10dp;
    font-weight: normal;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.scoreboard-spectator small
{
    color: var(--color-text-muted);
    font-size: 9dp;
}

.scoreboard-footer
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    min-height: 38dp;
    padding: 0 20dp;
    flex: none;
    align-items: center;
    justify-content: space-between;
    background-color: #10161CE8;
    border-top-width: 1dp;
    border-top-color: #303B46;
    color: var(--color-text-muted);
    font-size: 9dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.scoreboard-footer-hint
{
    display: flex;
    align-items: center;
    gap: 9dp;
}

.scoreboard-footer-hints
{
    display: flex;
    align-items: center;
    gap: 24dp;
}

.scoreboard-footer-hint strong
{
    display: block;
    font-weight: normal;
}

.scoreboard-footer-hint b
{
    display: block;
    padding: 3dp 6dp;
    border-width: 1dp;
    border-color: #73808D;
    border-radius: 3dp;
    color: var(--color-text);
    font-size: 9dp;
    font-weight: normal;
}

.scoreboard-footer-hint i
{
    image-color: #D6DCE2;
}

@media (max-width: 900dp)
{
    .scoreboard-panel
    {
        width: 96%;
    }

    .scoreboard-header
    {
        min-height: 80dp;
        padding: 10dp 18dp 19dp 18dp;
    }

    .scoreboard-server
    {
        font-size: 19dp;
        line-height: 22dp;
    }

    .scoreboard-time strong
    {
        font-size: 19dp;
    }

    .scoreboard-header-rule
    {
        right: 18dp;
        left: 18dp;
    }
}

@media (max-width: 1150dp)
{
    .scoreboard-teams
    {
        display: block;
    }

    .scoreboard-team
    {
        width: 100%;
    }

    .scoreboard-spectator
    {
        width: 49.5%;
    }
}

@media (max-height: 600dp)
{
    .scoreboard-panel
    {
        max-height: 96%;
    }

    .scoreboard-header
    {
        min-height: 70dp;
        padding-top: 7dp;
        padding-bottom: 17dp;
    }

    .scoreboard-server
    {
        font-size: 18dp;
        line-height: 21dp;
    }
}

/*
 * The base layout is intentionally compact for 1080p and smaller viewports.
 * At QHD and above, let the scoreboard use the available canvas and increase
 * its reading size as a unit instead of only stretching empty columns.
 */
@media (min-width: 2000dp)
{
    .scoreboard-panel
    {
        width: 90%;
        max-width: 2000dp;
        max-height: 92%;
    }

    .scoreboard-header
    {
        min-height: 106dp;
        padding: 16dp 30dp 24dp 30dp;
    }

    .scoreboard-kicker
    {
        font-size: 10dp;
        line-height: 14dp;
    }

    .scoreboard-server
    {
        font-size: 26dp;
        line-height: 30dp;
    }

    .scoreboard-match
    {
        font-size: 11dp;
        line-height: 15dp;
    }

    .scoreboard-time
    {
        gap: 11dp;
    }

    .scoreboard-time span
    {
        width: 22dp;
        height: 22dp;
    }

    .scoreboard-time strong
    {
        font-size: 26dp;
    }

    .scoreboard-header-rule
    {
        right: 30dp;
        bottom: 12dp;
        left: 30dp;
    }

    .scoreboard-columns
    {
        min-height: 42dp;
        padding: 0 22dp;
        font-size: 11dp;
    }

    .scoreboard-group
    {
        min-height: 34dp;
        padding: 11dp 27dp 0 27dp;
        font-size: 12dp;
    }

    .scoreboard-player
    {
        min-height: 46dp;
        margin: 0 15dp 5dp 15dp;
        padding: 0 13dp;
    }

    .score-name
    {
        width: 300dp;
        min-width: 300dp;
        gap: 9dp;
    }

    .score-name strong,
    .score-stat
    {
        font-size: 14dp;
    }

    .score-name small
    {
        font-size: 10dp;
    }

    .score-player-icon
    {
        width: 36dp;
        height: 36dp;
    }

    .score-stat
    {
        width: 90dp;
        min-width: 90dp;
        padding-right: 15dp;
    }

    .scoreboard-columns .score-stat
    {
        font-size: 11dp;
    }

    .score-cn
    {
        width: 75dp;
        min-width: 75dp;
    }

    .score-frags
    {
        width: 110dp;
        min-width: 110dp;
    }

    .score-deaths
    {
        width: 120dp;
        min-width: 120dp;
    }

    .scoreboard-teams
    {
        padding: 0 10dp 10dp 10dp;
        gap: 10dp;
    }

    .scoreboard-team .score-name
    {
        width: 165dp;
        min-width: 165dp;
        gap: 6dp;
    }

    .scoreboard-team .score-stat,
    .scoreboard-team .score-frags,
    .scoreboard-team .score-deaths
    {
        width: 60dp;
        min-width: 60dp;
    }

    .scoreboard-team .score-cn
    {
        width: 48dp;
        min-width: 48dp;
    }

    .scoreboard-spectators
    {
        padding: 0 10dp 10dp 10dp;
    }

    .scoreboard-spectators .scoreboard-group
    {
        min-height: 30dp;
        padding: 8dp 15dp 0 15dp;
    }

    .scoreboard-spectator
    {
        min-height: 38dp;
        padding: 0 11dp;
        gap: 9dp;
    }

    .scoreboard-spectator strong
    {
        font-size: 13dp;
    }

    .scoreboard-spectator small
    {
        font-size: 11dp;
    }

    .scoreboard-footer
    {
        min-height: 48dp;
        padding: 0 25dp;
        font-size: 11dp;
    }

    .scoreboard-footer-hint b
    {
        padding: 4dp 8dp;
        font-size: 11dp;
    }
}
