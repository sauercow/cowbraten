body { background-color: transparent; }
.scoreboard-overlay
{
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 9, 165);
}
.scoreboard-panel
{
    box-sizing: border-box;
    display: flex;
    width: 88%;
    max-width: 1180dp;
    max-height: 86%;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-background);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-panel);
}
.scoreboard-header
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    min-height: 80dp;
    padding: 18dp 22dp;
    flex: none;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}
.scoreboard-identity { display: block; flex: 1; min-width: 0; }
.scoreboard-header > div, .scoreboard-server, .scoreboard-match { display: block; }
.scoreboard-server { color: var(--color-text); font-size: 20dp; letter-spacing: 1dp; }
.scoreboard-match { margin-top: 5dp; color: var(--color-text-muted); font-size: 10dp; letter-spacing: 1dp; text-transform: uppercase; }
.scoreboard-time { color: var(--color-primary); font-size: 22dp; letter-spacing: 2dp; }
.scoreboard-scroll { display: block; width: 100%; min-height: 0; overflow: auto; }
.scoreboard-repeat { display: block; width: 100%; }
.scoreboard-row
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    min-width: 620dp;
    align-items: center;
}
.scoreboard-columns
{
    min-height: 38dp;
    padding: 0 16dp;
    background-color: var(--color-surface-2);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 9dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.scoreboard-group
{
    display: block;
    min-height: 34dp;
    padding: 11dp 16dp 0 16dp;
    color: var(--color-primary);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.scoreboard-player
{
    min-height: 43dp;
    padding: 0 16dp;
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
    color: var(--color-text);
}
.scoreboard-player.is-local { background-color: rgba(79, 161, 247, 30); border-left-width: 3dp; border-left-color: var(--color-primary); }
.scoreboard-player.is-spectator { color: var(--color-text-muted); }
.scoreboard-player.is-dead { opacity: 0.62; }
.score-name { display: flex; width: 220dp; min-width: 220dp; flex: 1; align-items: center; gap: 9dp; overflow: hidden; }
.score-name strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.score-name small { color: var(--color-secondary); font-size: 8dp; letter-spacing: 1dp; }
.score-stat { width: 58dp; min-width: 58dp; text-align: right; }
.score-cn { width: 40dp; min-width: 40dp; }
.scoreboard-footer
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    min-height: 38dp;
    padding: 0 18dp;
    flex: none;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: 9dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}
