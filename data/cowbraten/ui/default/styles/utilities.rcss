.utilities-screen
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 22dp 26dp 18dp 26dp;
    flex-direction: column;
    gap: 14dp;
    overflow: hidden;
}
.utilities-header, .utilities-title, .utilities-copy { display: block; }
.utilities-title { color: var(--color-text); font-size: 25dp; line-height: 31dp; letter-spacing: 1dp; }
.utilities-copy { color: var(--color-text-muted); font-size: 11dp; line-height: 17dp; }
.utilities-tabs
{
    display: flex;
    height: 42dp;
    flex: none;
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}
.utilities-tabs button
{
    height: 42dp;
    padding: 0 22dp;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
    color: var(--color-text-muted);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.utilities-tabs button.is-selected { border-bottom-color: var(--color-primary); color: var(--color-primary); }
.utility-workspace
{
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}
.utility-toolbar
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    min-height: 54dp;
    padding: 9dp 12dp;
    flex: none;
    align-items: center;
    gap: 8dp;
    background-color: var(--color-surface-2);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 10dp;
    text-transform: uppercase;
}
.utility-toolbar > span { flex: 1; }
.utility-filename { flex: 1; min-width: 240dp; }
.utility-editor
{
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 16dp;
    flex: 1;
    background-color: var(--color-background);
    border-width: 0;
    color: var(--color-text);
    font-family: Lato;
    font-size: 12dp;
    line-height: 18dp;
}
.utility-editor:focus { border-width: 1dp; border-color: var(--color-primary); }
.utility-danger { color: var(--color-error); }
.utility-status { min-height: 16dp; flex: none; color: var(--color-text-muted); font-size: 9dp; letter-spacing: 1dp; }
