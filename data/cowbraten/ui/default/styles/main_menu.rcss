.main-screen
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.main-shell
{
    display: flex;
    flex-direction: column;
    width: 1440px;
    max-width: 100%;
    height: 800px;
    max-height: 100%;
    overflow: hidden;
}

.main-header
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 72px;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.main-lockup
{
    display: flex;
    align-items: center;
    gap: var(--space-2);
}

.main-mark
{
    box-sizing: border-box;
    width: 40px;
    height: 40px;
    background-color: var(--color-secondary);
    border-width: 1px;
    border-color: var(--color-secondary-hover);
    border-radius: var(--radius-control);
    color: var(--color-background);
    font-size: 24px;
    line-height: 38px;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
}

.main-lockup-copy
{
    display: block;
}

.main-lockup-name
{
    display: block;
    color: var(--color-text);
    font-size: 18px;
    line-height: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.main-lockup-subtitle
{
    display: block;
    color: var(--color-text-muted);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.main-close
{
    min-width: 152px;
}

.main-content
{
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: row;
}

.main-navigation
{
    box-sizing: border-box;
    display: flex;
    flex: 0 0 400px;
    min-width: 0;
    padding: var(--space-3);
    flex-direction: column;
    background-color: var(--color-background);
    border-right-width: 1px;
    border-right-color: var(--color-border);
}

.main-section-label
{
    flex: none;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.main-nav-list
{
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

.main-nav-item
{
    display: flex;
    height: 48px;
    padding: 0 var(--space-2);
    align-items: center;
    line-height: 46px;
}

.main-nav-index
{
    display: block;
    flex: none;
    width: 32px;
    color: var(--color-disabled);
    font-size: 10px;
    letter-spacing: 1px;
}

.main-nav-label
{
    display: block;
    flex: 1;
}

.main-nav-state
{
    display: block;
    flex: none;
    width: 72px;
    color: var(--color-disabled);
    font-size: 9px;
    letter-spacing: 1px;
    text-align: right;
}

.main-nav-item.is-selected .main-nav-index,
.main-nav-item.is-selected .main-nav-state
{
    color: var(--color-primary);
}

.main-nav-exit
{
    margin-top: var(--space-1);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.main-stage
{
    box-sizing: border-box;
    display: flex;
    flex: 1;
    min-width: 0;
    padding: var(--space-6);
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-surface);
}

.main-stage-copy
{
    display: block;
    margin-top: var(--space-8);
}

.main-eyebrow
{
    margin-bottom: var(--space-2);
    color: var(--color-secondary);
}

.main-brand-title
{
    color: var(--color-text);
    font-size: 72px;
    line-height: 76px;
    letter-spacing: 6px;
    text-transform: uppercase;
}

.main-brand-rule
{
    display: block;
    width: 100%;
    height: 2px;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    background-color: var(--color-border);
}

.main-brand-accent
{
    display: block;
    width: 96px;
    height: 2px;
    background-color: var(--color-secondary);
}

.main-brand-subtitle
{
    display: block;
    max-width: 640px;
    color: var(--color-text);
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 1px;
}

.main-brand-description
{
    display: block;
    max-width: 560px;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 22px;
}

.main-details
{
    display: flex;
    flex: none;
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.main-detail
{
    box-sizing: border-box;
    display: block;
    flex: 1;
    min-width: 0;
    padding: var(--space-2) var(--space-2) 0 0;
}

.main-detail-label
{
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-disabled);
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.main-detail-value
{
    display: block;
    color: var(--color-text-muted);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.main-footer
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 48px;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface-2);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.main-footer-product
{
    color: var(--color-text);
}

.main-footer-help
{
    color: var(--color-disabled);
}

.main-footer-status
{
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-success);
}

.main-status-dot
{
    display: block;
    width: 6px;
    height: 6px;
    background-color: var(--color-success);
    border-radius: 3px;
}

.main-status-text
{
    display: block;
}
