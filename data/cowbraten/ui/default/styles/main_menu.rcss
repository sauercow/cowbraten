body
{
    background-color: transparent;
}

.main-screen
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #0E101238;
}

.main-shell
{
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    overflow: hidden;
    border-width: 0;
    border-radius: 0;
}

.main-header
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 72dp;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.main-lockup
{
    display: flex;
    flex: none;
    min-width: 0;
    align-items: center;
    gap: var(--space-2);
}

.main-mark
{
    box-sizing: border-box;
    width: 40dp;
    height: 40dp;
    background-color: var(--color-secondary);
    border-width: 1dp;
    border-color: var(--color-secondary-hover);
    border-radius: var(--radius-control);
    color: var(--color-background);
    font-size: 24dp;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
    flex: none;
}

.main-lockup-copy
{
    display: block;
}

.main-lockup-name
{
    display: block;
    color: var(--color-text);
    font-size: 18dp;
    line-height: 20dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.main-lockup-subtitle
{
    display: block;
    color: var(--color-text-muted);
    font-size: 11dp;
    line-height: 16dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.main-close
{
    min-width: 152dp;
}

.main-content
{
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: row;
}

.main-navigation
{
    box-sizing: border-box;
    display: flex;
    flex: 0 0 400dp;
    min-width: 0;
    padding: var(--space-3);
    flex-direction: column;
    background-color: var(--color-background);
    border-right-width: 1dp;
    border-right-color: var(--color-border);
}

.main-section-label
{
    flex: none;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-size: 12dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.main-nav-list
{
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

.main-nav-item
{
    display: flex;
    height: 48dp;
    padding: 0 var(--space-2);
    align-items: center;
    line-height: 46dp;
}

.main-nav-icon
{
    display: block;
    flex: none;
    margin-right: 14dp;
    image-color: var(--color-disabled);
}

.main-nav-label
{
    display: block;
    flex: 1;
}

.main-nav-state
{
    display: block;
    flex: none;
    width: 72dp;
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-align: right;
}

.main-nav-item.is-selected .main-nav-state
{
    color: var(--color-primary);
}

.main-nav-item.is-selected .main-nav-icon,
.main-nav-item:hover .main-nav-icon,
.main-nav-item:focus-visible .main-nav-icon
{
    image-color: var(--color-primary);
}

.main-nav-item:disabled .main-nav-icon
{
    image-color: var(--color-disabled);
}

.main-nav-exit:hover .main-nav-icon,
.main-nav-exit:focus-visible .main-nav-icon
{
    image-color: var(--color-error);
}

.main-nav-exit
{
    margin-top: var(--space-1);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.main-stage
{
    box-sizing: border-box;
    display: flex;
    flex: 1;
    min-width: 0;
    padding: var(--space-6);
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-surface);
}

.main-stage-copy
{
    display: block;
    margin-top: var(--space-8);
}

.main-eyebrow
{
    margin-bottom: var(--space-2);
    color: var(--color-secondary);
}

.main-brand-title
{
    color: var(--color-text);
    font-size: 72dp;
    line-height: 76dp;
    letter-spacing: 6dp;
    text-transform: uppercase;
}

.main-brand-rule
{
    display: block;
    width: 100%;
    height: 2dp;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    background-color: var(--color-border);
}

.main-brand-accent
{
    display: block;
    width: 96dp;
    height: 2dp;
    background-color: var(--color-secondary);
}

.main-brand-subtitle
{
    display: block;
    max-width: 640dp;
    color: var(--color-text);
    font-size: 20dp;
    line-height: 28dp;
    letter-spacing: 1dp;
}

.main-brand-description
{
    display: block;
    max-width: 560dp;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 14dp;
    line-height: 22dp;
}

.main-details
{
    display: flex;
    flex: none;
    flex-direction: row;
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.main-detail
{
    box-sizing: border-box;
    display: block;
    flex: 1;
    min-width: 0;
    padding: var(--space-2) var(--space-2) 0 0;
}

.main-detail-label
{
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.main-detail-value
{
    display: block;
    color: var(--color-text-muted);
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.main-footer
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 48dp;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface-2);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.main-footer-product
{
    color: var(--color-text);
}

.main-footer-help
{
    color: var(--color-disabled);
}

.main-footer-status
{
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-success);
}

.main-status-dot
{
    display: block;
    width: 6dp;
    height: 6dp;
    background-color: var(--color-success);
    border-radius: 3dp;
}

.main-status-text
{
    display: block;
}

@media (max-width: 1000dp)
{
    .main-screen
    {
        padding: 0;
    }

    .main-navigation
    {
        flex-basis: 280dp;
        padding: var(--space-2);
    }

    .main-stage
    {
        padding: var(--space-3);
    }

    .main-brand-title
    {
        font-size: 52dp;
        line-height: 58dp;
        letter-spacing: 4dp;
    }
}

@media (max-height: 700dp)
{
    .main-screen
    {
        padding: 0;
    }

    .main-header
    {
        height: 64dp;
        padding: 0 var(--space-2);
    }

    .main-navigation
    {
        padding: var(--space-2);
    }

    .main-section-label
    {
        margin-bottom: var(--space-1);
    }

    .main-nav-list
    {
        gap: 2dp;
    }

    .main-nav-item
    {
        height: 40dp;
        line-height: 38dp;
    }

    .main-stage
    {
        padding: var(--space-3);
    }

    .main-stage-copy
    {
        margin-top: var(--space-2);
    }

    .main-brand-title
    {
        font-size: 48dp;
        line-height: 54dp;
    }

    .main-brand-subtitle
    {
        font-size: 18dp;
        line-height: 24dp;
    }

    .main-footer
    {
        height: 40dp;
        padding: 0 var(--space-2);
    }
}
