.editor-screen { box-sizing: border-box; display: flex; width: 100%; height: 100%; min-height: 0; padding: 22dp 26dp 18dp 26dp; flex-direction: column; gap: 14dp; overflow: hidden; }
.editor-header { display: flex; flex: none; align-items: center; justify-content: space-between; }
.editor-title { display: block; color: var(--color-text); font-size: 25dp; line-height: 30dp; letter-spacing: 1dp; }
.editor-copy { display: block; color: var(--color-text-muted); font-size: 10dp; line-height: 15dp; }
.editor-mode { box-sizing: border-box; display: flex; width: 112dp; height: 46dp; padding: 6dp 12dp; flex-direction: column; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-disabled); }
.editor-mode small { font-size: 8dp; letter-spacing: 1dp; text-transform: uppercase; }.editor-mode strong { font-size: 13dp; }.editor-mode.is-active { border-color: var(--color-success); color: var(--color-success); }
.editor-tabs { display: flex; height: 38dp; flex: none; align-items: center; gap: 8dp; }
.editor-tabs button { box-sizing: border-box; display: block; min-width: 104dp; height: 34dp; padding: 0 14dp; background-color: var(--color-surface-2); border-width: 1dp; border-color: var(--color-border); border-radius: var(--radius-control); color: var(--color-text-muted); font-family: Lato; font-size: 9dp; line-height: 32dp; letter-spacing: 1dp; text-align: center; text-transform: uppercase; }
.editor-tabs button:hover,.editor-tabs button:focus-visible { background-color: var(--color-background); border-color: var(--color-primary-hover); color: var(--color-text); }.editor-tabs button.is-selected { background-color: #2F7CCB35; border-color: var(--color-primary); color: var(--color-primary); }
.editor-scroll { display: block; flex: 1; min-height: 0; padding-right: 6dp; overflow-y: auto; }
.editor-section { display: block; width: 100%; }
.editor-grid { display: flex; width: 100%; gap: 10dp; }.editor-grid > .editor-card { flex: 1; min-width: 440dp; }.editor-grid-three > .editor-card { flex: 1; min-width: 280dp; }.editor-card { box-sizing: border-box; padding: 14dp; margin-bottom: 10dp; }
.editor-card-full { display: block; width: 100%; min-width: 900dp; }.editor-card-title { display: block; margin-bottom: 10dp; color: var(--color-text); font-size: 13dp; letter-spacing: 1dp; text-transform: uppercase; }.editor-card-heading { display: flex; align-items: center; justify-content: space-between; color: var(--color-text-muted); font-size: 10dp; }
.editor-action { box-sizing: border-box; display: flex; width: 100%; height: 38dp; padding: 0 10dp; align-items: center; justify-content: space-between; background-color: var(--color-background); border-width: 0 0 1dp 2dp; border-color: var(--color-border) var(--color-border) var(--color-border) transparent; color: var(--color-text-muted); font-family: Lato; text-align: left; }
.editor-action:hover { background-color: var(--color-surface-2); border-left-color: var(--color-primary); color: var(--color-text); }.editor-action strong { font-size: 11dp; }.editor-action small { color: var(--color-disabled); font-size: 9dp; }
.editor-toggle { box-sizing: border-box; display: flex; height: 40dp; padding: 0 8dp; align-items: center; justify-content: space-between; border-bottom-width: 1dp; border-bottom-color: var(--color-border); color: var(--color-text-muted); font-size: 11dp; }
.editor-button-grid { display: flex; flex-wrap: wrap; gap: 6dp; }.editor-tile { box-sizing: border-box; display: flex; width: 142dp; min-height: 44dp; padding: 7dp 9dp; flex-direction: column; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-text-muted); font-family: Lato; text-align: left; }.editor-tile:hover { border-color: var(--color-primary); color: var(--color-text); }.editor-tile strong { font-size: 10dp; }.editor-tile small { color: var(--color-disabled); font-size: 8dp; text-transform: uppercase; }.entity-grid .editor-tile { width: 166dp; }
.editor-inline-actions { display: flex; margin-top: 10dp; gap: 6dp; flex-wrap: wrap; }.editor-danger { color: var(--color-error); }.editor-help { display: flex; padding: 12dp 14dp; gap: 16dp; color: var(--color-text-muted); font-size: 10dp; }.editor-help strong { flex: none; color: var(--color-primary); text-transform: uppercase; }
.editor-range { display: block; margin-bottom: 9dp; color: var(--color-text-muted); font-size: 9dp; text-transform: uppercase; }.editor-range span { display: flex; margin-bottom: 3dp; justify-content: space-between; }.editor-range b { color: var(--color-text); }.editor-range input { display: block; width: 100%; height: 24dp; tab-index: auto; }
.editor-range input slidertrack { height: 4dp; margin-top: 10dp; background-color: var(--color-surface-2); border-width: 1dp; border-color: var(--color-border); }
.editor-range input sliderprogress { height: 4dp; background-color: var(--color-primary-pressed); }
.editor-range input sliderbar { width: 14dp; height: 14dp; margin-top: 5dp; margin-left: -7dp; margin-right: -7dp; background-color: var(--color-primary); border-width: 2dp; border-color: var(--color-background); border-radius: 7dp; }
.editor-range input sliderarrowdec,.editor-range input sliderarrowinc { width: 0; height: 0; }
.editor-subtitle { margin: 10dp 0 7dp 0; color: var(--color-primary); font-size: 9dp; letter-spacing: 1dp; text-transform: uppercase; }
.editor-choice-list { display: flex; margin-bottom: 8dp; flex-wrap: wrap; gap: 4dp; }.editor-choice-list button { box-sizing: border-box; height: 27dp; padding: 0 8dp; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-text-muted); font-family: Lato; font-size: 8dp; }.editor-choice-list button:hover { border-color: var(--color-primary); }.editor-choice-list button.is-selected { background-color: var(--color-primary); border-color: var(--color-primary); color: var(--color-background); }
.editor-filter { width: 100%; margin-bottom: 8dp; }.model-list { display: flex; max-height: 240dp; overflow-y: auto; flex-wrap: wrap; gap: 4dp; }.model-list button { box-sizing: border-box; display: flex; width: 222dp; height: 34dp; padding: 0 8dp; align-items: center; gap: 8dp; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-text-muted); font-family: Lato; font-size: 9dp; text-align: left; }.model-list button:hover { border-color: var(--color-primary); color: var(--color-text); }.model-list small { color: var(--color-primary); }
.editor-field { display: block; color: var(--color-text-muted); font-size: 9dp; text-transform: uppercase; }.editor-field input { width: 100%; margin-top: 5dp; }.editor-card > .button { width: 100%; margin-top: 7dp; }
.selection-editor { min-height: 260dp; }.selection-type { display: block; color: var(--color-primary); font-size: 18dp; }.selection-attrs { display: flex; margin: 18dp 0 12dp 0; gap: 8dp; }.selection-attrs label { flex: 1; color: var(--color-text-muted); font-size: 9dp; text-transform: uppercase; }.selection-attrs input { width: 100%; margin-top: 5dp; }
.editor-empty { width: 100%; padding: 24dp; color: var(--color-disabled); font-size: 11dp; text-align: center; }.editor-status { min-height: 15dp; flex: none; color: var(--color-text-muted); font-size: 9dp; letter-spacing: 1dp; }
@media (max-width: 1000dp) { .editor-screen { padding: 12dp; }.editor-grid,.editor-grid-three { display: block; }.editor-grid > .editor-card,.editor-grid-three > .editor-card,.editor-card-full { width: 100%; min-width: 0; }.editor-tabs { overflow-x: auto; }.editor-tabs button { padding: 0 10dp; }.entity-grid .editor-tile,.editor-tile { width: 47%; }.selection-attrs { flex-wrap: wrap; }.selection-attrs label { flex: 1 1 30%; } }
