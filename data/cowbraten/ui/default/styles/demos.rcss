body { background-color: transparent; }
.demos-screen { box-sizing: border-box; display: flex; width: 100%; height: 100%; padding: 0; align-items: center; justify-content: center; overflow: hidden; background-color: #0E101238; }
.demos-shell { display: flex; flex-direction: column; width: 100%; max-width: 100%; height: 100%; max-height: 100%; overflow: hidden; border-width: 0; border-radius: 0; }
.demos-header { box-sizing: border-box; display: flex; flex: none; height: 64dp; padding: 0 24dp; align-items: center; justify-content: space-between; border-bottom-width: 1dp; border-bottom-color: var(--color-border); }
.demos-lockup { display: flex; align-items: center; gap: 16dp; }.demos-mark { box-sizing: border-box; width: 40dp; height: 40dp; background-color: var(--color-secondary); color: var(--color-background); font-size: 24dp; line-height: 40dp; text-align: center; }.demos-product { display: block; font-size: 17dp; line-height: 20dp; letter-spacing: 2dp; text-transform: uppercase; }.demos-title { display: block; color: var(--color-primary); font-size: 11dp; line-height: 16dp; letter-spacing: 2dp; text-transform: uppercase; }
.demos-tabs { display: flex; flex: none; height: 48dp; padding: 0 24dp; align-items: stretch; background-color: var(--color-background); border-bottom-width: 1dp; border-bottom-color: var(--color-border); }.demo-tab { box-sizing: border-box; width: 144dp; height: 48dp; background: transparent; border-width: 0 0 2dp 0; border-color: transparent; color: var(--color-text-muted); font-family: Lato; font-size: 11dp; line-height: 46dp; letter-spacing: 1dp; text-align: center; text-transform: uppercase; }.demo-tab:hover { color: var(--color-text); background-color: var(--color-surface-2); }.demo-tab.is-selected { color: var(--color-primary); border-bottom-color: var(--color-primary); }.demos-tabs-spacer { flex: 1; }.demos-count { line-height: 48dp; color: var(--color-text-muted); font-size: 11dp; letter-spacing: 1dp; text-transform: uppercase; }
.demo-tab .cb-ico { margin-right: 8dp; image-color: var(--color-text-muted); }.demo-tab:hover .cb-ico { image-color: var(--color-text); }.demo-tab.is-selected .cb-ico { image-color: var(--color-primary); }
.demos-page { display: flex; flex: 1; min-height: 0; flex-direction: column; }.demo-toolbar { box-sizing: border-box; display: flex; flex: none; height: 56dp; padding: 8dp 24dp; gap: 8dp; align-items: center; border-bottom-width: 1dp; border-bottom-color: var(--color-border); }.demo-global-search { flex: 1; }.demo-toolbar .button { height: 40dp; }
.demo-filters { box-sizing: border-box; display: flex; flex: none; max-height: 176dp; padding: 10dp 24dp; flex-wrap: wrap; gap: 8dp; overflow-y: auto; background-color: var(--color-surface-2); border-bottom-width: 1dp; border-bottom-color: var(--color-border); }.demo-filter { display: block; width: 184dp; }.demo-filter span { display: block; margin-bottom: 3dp; color: var(--color-disabled); font-size: 9dp; letter-spacing: 1dp; text-transform: uppercase; }.demo-filter .text-input { height: 32dp; line-height: 30dp; font-size: 12dp; }.demo-filter select { box-sizing: border-box; width: 100%; height: 32dp; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-text); font-family: Lato; font-size: 11dp; }.demo-filter-checks { display: flex; width: 240dp; padding-top: 14dp; flex-direction: column; }.demo-filter-checks .checkbox-row { height: 28dp; font-size: 11dp; }.demo-duration-custom { width: 224dp; }.demo-duration-custom div { display: flex; gap: 4dp; }.demo-duration-custom .text-input { width: 102dp; }
.demo-table { display: flex; flex: 1; min-height: 180dp; flex-direction: column; }.demo-grid { box-sizing: border-box; display: flex; width: 100%; align-items: center; }.demo-columns { flex: none; height: 34dp; padding: 0 12dp 0 15dp; background-color: var(--color-background); border-bottom-width: 1dp; border-bottom-color: var(--color-border); }.demo-heading,.demo-heading-label { box-sizing: border-box; display: block; height: 33dp; padding: 0 6dp; background: transparent; border-width: 0; color: var(--color-text-muted); font-family: Lato; font-size: 9dp; line-height: 33dp; letter-spacing: 1dp; text-align: left; text-transform: uppercase; }.demo-heading:hover { color: var(--color-primary); }.demo-rows { display: block; flex: 1; min-height: 0; overflow-y: auto; }.demo-row-repeat { display: block; width: 100%; }.demo-row { height: 48dp; padding: 4dp 12dp; border-width: 0 0 1dp 3dp; border-color: var(--color-border) var(--color-border) var(--color-border) transparent; color: var(--color-text-muted); font-size: 11dp; }.demo-row:hover { background-color: var(--color-surface-2); border-left-color: var(--color-primary-pressed); color: var(--color-text); }.demo-row:active { background-color: var(--color-primary-pressed); }.demo-row.is-selected { background-color: #2F7CCB35; border-left-color: var(--color-primary); }.demo-cell-check { flex: 0 0 32dp; }.demo-check { box-sizing: border-box; flex: 0 0 20dp; width: 20dp; height: 20dp; margin-right: 12dp; padding: 0; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-background); font-family: Lato; font-size: 10dp; line-height: 18dp; text-align: center; }.demo-check:hover,.demo-check:focus-visible { border-color: var(--color-primary); }.demo-check.is-selected { background-color: var(--color-primary); color: var(--color-background); }.demo-row-select { box-sizing: border-box; display: flex; flex: 1; width: auto; min-width: 0; height: 40dp; padding: 0; align-items: center; background: transparent; border-width: 0; color: var(--color-text-muted); font-family: Lato; font-size: 11dp; line-height: 16dp; text-align: left; }.demo-row:hover .demo-row-select,.demo-row.is-selected .demo-row-select,.demo-row-select:focus-visible { color: var(--color-text); }.demo-cell-name,.demo-cell-mode,.demo-cell-map,.demo-cell-duration,.demo-cell-date,.demo-cell-size,.demo-cell-class { box-sizing: border-box; display: block; min-width: 0; overflow: hidden; }.demo-cell-name { flex: 2.2; min-width: 220dp; padding: 0 6dp; }.demo-cell-mode { flex: 1; min-width: 100dp; padding: 0 6dp; }.demo-cell-map { flex: 1; min-width: 100dp; padding: 0 6dp; }.demo-cell-duration { flex: 0 0 76dp; padding: 0 6dp; }.demo-cell-date { flex: 0 0 136dp; padding: 0 6dp; }.demo-cell-size { flex: 0 0 80dp; padding: 0 6dp; }.demo-cell-class { flex: 0 0 104dp; padding: 0 6dp; }.demo-name { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--color-text); font-size: 12dp; }.demo-subline { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--color-disabled); font-size: 9dp; }.demo-empty { box-sizing: border-box; display: flex; height: 100%; min-height: 120dp; align-items: center; justify-content: center; flex-direction: column; color: var(--color-text-muted); font-size: 15dp; }.demo-empty span { margin-top: 8dp; color: var(--color-disabled); font-size: 11dp; }
.demo-selection { box-sizing: border-box; display: flex; flex: none; min-height: 104dp; padding: 10dp 16dp; gap: 10dp; flex-wrap: wrap; background-color: var(--color-surface-2); border-top-width: 1dp; border-top-color: var(--color-border); }.demo-selection-info { flex: 1; min-width: 400dp; }.demo-selection-label { display: block; color: var(--color-disabled); font-size: 9dp; line-height: 13dp; letter-spacing: 1dp; text-transform: uppercase; }.demo-selection-name { display: block; color: var(--color-text); font-size: 14dp; line-height: 18dp; }.demo-selection-details,.demo-selection-people { display: block; color: var(--color-text-muted); font-size: 10dp; line-height: 16dp; }.demo-actions { display: flex; align-items: flex-start; gap: 6dp; }.demo-actions .button { height: 34dp; line-height: 32dp; font-size: 10dp; }.demo-edit-row { display: flex; flex: 1 1 100%; gap: 6dp; }.demo-edit-row .text-input { flex: 1; height: 32dp; line-height: 30dp; }.demo-edit-row .button { height: 32dp; line-height: 30dp; font-size: 10dp; }.demo-classify { display: flex; flex: 1 1 100%; align-items: center; gap: 5dp; color: var(--color-disabled); font-size: 9dp; text-transform: uppercase; }.demo-classify button { box-sizing: border-box; height: 24dp; padding: 0 10dp; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-text-muted); font-family: Lato; font-size: 9dp; line-height: 22dp; text-align: center; }.demo-classify button:hover { border-color: var(--color-primary); color: var(--color-text); }
.demo-favorite-icon { margin-right: 6dp; image-color: var(--color-warning); }.demo-record-status .cb-ico { margin-right: 8dp; image-color: var(--color-error); }
.demo-settings-page { padding: 32dp; overflow-y: auto; }.demo-page-heading { flex: none; padding-bottom: 24dp; border-bottom-width: 1dp; border-bottom-color: var(--color-border); }.demo-page-heading .body-copy { margin-top: 12dp; }.demo-settings-grid { display: flex; flex: none; margin-top: 24dp; gap: 16dp; flex-wrap: wrap; }.demo-setting-card { box-sizing: border-box; display: flex; width: 31%; min-width: 300dp; min-height: 112dp; padding: 20dp; gap: 16dp; align-items: flex-start; background-color: var(--color-surface-2); border-width: 1dp; border-color: var(--color-border); }.demo-setting-card:hover { border-color: var(--color-primary); }.demo-setting-card .checkbox { flex: none; margin-top: 2dp; }.demo-setting-card strong,.demo-setting-card small { display: block; }.demo-setting-card strong { color: var(--color-text); font-size: 14dp; }.demo-setting-card small { margin-top: 8dp; color: var(--color-text-muted); font-size: 11dp; line-height: 17dp; }.demo-record-status { margin-top: 24dp; padding: 16dp; background-color: var(--color-background); border-left-width: 3dp; border-left-color: var(--color-border); color: var(--color-text-muted); }.demo-record-status .is-recording { color: var(--color-error); }.demo-note { box-sizing: border-box; display: flex; margin-top: 20dp; padding: 16dp; gap: 16dp; background-color: #E3B34118; border-width: 1dp; border-color: var(--color-warning); }.demo-note strong { flex: 0 0 190dp; color: var(--color-warning); font-size: 11dp; text-transform: uppercase; }.demo-note span { color: var(--color-text-muted); font-size: 11dp; line-height: 17dp; }
.trash-title { display: block; flex: 1; }.trash-title strong,.trash-title span { display: block; }.trash-title strong { font-size: 14dp; }.trash-title span { color: var(--color-text-muted); font-size: 10dp; }.trash-table { min-height: 0; }.trash-actions { box-sizing: border-box; display: flex; flex: none; min-height: 72dp; padding: 12dp 16dp; align-items: center; gap: 8dp; background-color: var(--color-surface-2); border-top-width: 1dp; border-top-color: var(--color-border); }.trash-actions div { flex: 1; }.trash-actions strong,.trash-actions span { display: block; }.trash-actions span { color: var(--color-text-muted); font-size: 10dp; }
.trash-retention { display: flex; align-items: center; gap: 8dp; color: var(--color-text-muted); font-size: 10dp; text-transform: uppercase; }.trash-retention select { width: 104dp; height: 36dp; background-color: var(--color-background); border-width: 1dp; border-color: var(--color-border); color: var(--color-text); }
.demos-footer { box-sizing: border-box; display: flex; flex: none; height: 36dp; padding: 0 20dp; align-items: center; justify-content: space-between; background-color: var(--color-background); border-top-width: 1dp; border-top-color: var(--color-border); color: var(--color-text-muted); font-size: 9dp; letter-spacing: 1dp; text-transform: uppercase; }.demos-footer .is-error { color: var(--color-error); }
.demo-modal-layer { position: absolute; display: flex; width: 100%; height: 100%; left: 0; top: 0; align-items: center; justify-content: center; background-color: #000000AA; }.demo-modal { box-sizing: border-box; width: 520dp; max-width: 90%; padding: 24dp; }.demo-modal-text { color: var(--color-text); font-size: 16dp; line-height: 24dp; }.demo-modal-actions { display: flex; margin-top: 24dp; justify-content: flex-end; gap: 8dp; }
.button.is-disabled { background-color: var(--color-surface-2); border-color: var(--color-disabled); color: var(--color-disabled); opacity: 0.62; pointer-events: none; }
@media (max-width: 1100dp) { .demos-screen { padding: 0; }.demo-filters { max-height: 160dp; overflow-y: auto; }.demo-cell-date { display: none; }.demo-cell-size { display: none; }.demo-setting-card { width: 100%; }.demo-selection { max-height: 180dp; overflow-y: auto; } }

/* Keep repeated rows in a definite layout inside RmlUi scroll containers. */
.demo-row
{
    display: flex;
    width: 1678dp;
    min-width: 1678dp;
    max-width: 1678dp;
    background-color: var(--color-surface);
    font-family: Lato;
    line-height: 16dp;
    text-align: left;
}

@media (max-width: 1728dp)
{
    .demo-row { width: 96.75vw; min-width: 96.75vw; max-width: 96.75vw; }
}

@media (max-width: 1300dp)
{
    .demo-row { width: 96vw; min-width: 96vw; max-width: 96vw; }
}

@media (max-width: 1100dp)
{
    .demo-row { width: 98vw; min-width: 98vw; max-width: 98vw; }
}

/* Use definite column bases; flex-grow collapses inside an overflowing RmlUi button. */
.demo-cell-check
{
    box-sizing: border-box;
    display: block;
    flex: 0 0 3%;
    min-width: 0;
    padding-left: 0;
}

.demo-cell-name { flex: 0 0 37%; min-width: 0; }
.demo-cell-mode { flex: 0 0 17%; min-width: 0; }
.demo-cell-map { flex: 0 0 17%; min-width: 0; }
.demo-cell-duration { flex: 0 0 5%; min-width: 0; }
.demo-cell-date { flex: 0 0 9%; min-width: 0; }
.demo-cell-size { flex: 0 0 5%; min-width: 0; }
.demo-cell-class { flex: 0 0 7%; min-width: 0; }

.demo-check
{
    display: block;
    margin-right: 0;
}

.demo-row-select
{
    flex: 0 0 97%;
    width: 97%;
    min-width: 0;
    max-width: 97%;
}

.demo-row-select .demo-cell-name { flex-basis: 38.144%; }
.demo-row-select .demo-cell-mode { flex-basis: 17.526%; }
.demo-row-select .demo-cell-map { flex-basis: 17.526%; }
.demo-row-select .demo-cell-duration { flex-basis: 5.155%; }
.demo-row-select .demo-cell-date { flex-basis: 9.278%; }
.demo-row-select .demo-cell-size { flex-basis: 5.155%; }
.demo-row-select .demo-cell-class { flex-basis: 7.216%; }

.demo-rows scrollbarvertical,
.demo-filters scrollbarvertical,
.demo-selection scrollbarvertical
{
    width: 12dp;
    background-color: var(--color-background);
    border-left-width: 1dp;
    border-left-color: var(--color-border);
}

.demo-rows scrollbarvertical slidertrack,
.demo-filters scrollbarvertical slidertrack,
.demo-selection scrollbarvertical slidertrack
{
    width: 11dp;
    background-color: var(--color-background);
}

.demo-rows scrollbarvertical sliderbar,
.demo-filters scrollbarvertical sliderbar,
.demo-selection scrollbarvertical sliderbar
{
    width: 7dp;
    min-height: 40dp;
    margin-left: 2dp;
    background-color: var(--color-disabled);
    border-radius: var(--radius-control);
}

.demo-rows scrollbarvertical sliderbar:hover,
.demo-filters scrollbarvertical sliderbar:hover,
.demo-selection scrollbarvertical sliderbar:hover
{
    background-color: var(--color-primary-pressed);
}

.demo-rows scrollbarvertical sliderbar:active,
.demo-filters scrollbarvertical sliderbar:active,
.demo-selection scrollbarvertical sliderbar:active
{
    background-color: var(--color-primary);
}

.demo-rows scrollbarvertical sliderarrowdec,
.demo-rows scrollbarvertical sliderarrowinc,
.demo-filters scrollbarvertical sliderarrowdec,
.demo-filters scrollbarvertical sliderarrowinc,
.demo-selection scrollbarvertical sliderarrowdec,
.demo-selection scrollbarvertical sliderarrowinc
{
    width: 0;
    height: 0;
}

/* RmlUi selects render their visible value and options as internal elements. */
.demo-filter select selectvalue
{
    box-sizing: border-box;
    width: auto;
    height: 30dp;
    margin-right: 24dp;
    padding: 0 8dp;
    line-height: 30dp;
    text-align: center;
}

.demo-filter select selectarrow
{
    width: 24dp;
    height: 30dp;
}

.demo-filter select selectbox,
.trash-retention select selectbox
{
    box-sizing: border-box;
    margin-top: 2dp;
    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
}

.demo-filter select selectbox option
{
    box-sizing: border-box;
    height: 30dp;
    padding: 0 8dp;
    line-height: 30dp;
    text-align: center;
    background-color: var(--color-surface);
    border-width: 0 0 1dp 3dp;
    border-color: var(--color-border) var(--color-border) var(--color-border) transparent;
    color: var(--color-text-muted);
}

.demo-filter select selectbox option:hover,
.trash-retention select selectbox option:hover
{
    background-color: var(--color-primary-pressed);
    border-left-color: var(--color-primary-hover);
    color: var(--color-text);
}

.demo-filter select selectbox option:checked,
.trash-retention select selectbox option:checked
{
    background-color: #2F7CCB35;
    border-left-color: var(--color-primary);
    color: var(--color-primary);
}

.demo-filter select selectbox option:active,
.trash-retention select selectbox option:active
{
    background-color: var(--color-primary);
    border-left-color: var(--color-text);
    color: var(--color-background);
}

.trash-retention select selectvalue
{
    box-sizing: border-box;
    width: auto;
    height: 34dp;
    margin-right: 24dp;
    padding: 0 8dp;
    line-height: 34dp;
    text-align: center;
}

.trash-retention select selectarrow
{
    width: 24dp;
    height: 34dp;
}

.trash-retention select selectbox option
{
    box-sizing: border-box;
    height: 34dp;
    padding: 0 8dp;
    line-height: 34dp;
    text-align: center;
    background-color: var(--color-surface);
    border-width: 0 0 1dp 3dp;
    border-color: var(--color-border) var(--color-border) var(--color-border) transparent;
    color: var(--color-text-muted);
}

@media (max-width: 1100dp)
{
    .demo-cell-check { flex-basis: 4%; }
    .demo-cell-name { flex-basis: 40%; }
    .demo-cell-mode { flex-basis: 20%; }
    .demo-cell-map { flex-basis: 20%; }
    .demo-cell-duration { flex-basis: 8%; }
    .demo-cell-class { flex-basis: 8%; }
    .demo-row-select { flex-basis: 96%; width: 96%; max-width: 96%; }
    .demo-row-select .demo-cell-name { flex-basis: 41.667%; }
    .demo-row-select .demo-cell-mode { flex-basis: 20.833%; }
    .demo-row-select .demo-cell-map { flex-basis: 20.833%; }
    .demo-row-select .demo-cell-duration { flex-basis: 8.333%; }
    .demo-row-select .demo-cell-class { flex-basis: 8.333%; }
}

/* Keyboard navigation is part of the native menu contract. */
.demo-tab, .demo-row-select, .demo-check, .demo-heading,
.demo-classify button { tab-index: auto; }
.demo-tab:focus-visible, .demo-row-select:focus-visible,
.demo-heading:focus-visible { border-color: var(--color-primary); color: var(--color-text); }
