body
{
    background-color: transparent;
}

.servers-screen
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #0E101238;
}

.servers-shell
{
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    overflow: hidden;
    border-width: 0;
    border-radius: 0;
}

.servers-header
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 72dp;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.servers-lockup
{
    display: flex;
    flex: none;
    min-width: 0;
    align-items: center;
    gap: var(--space-2);
}

.servers-mark
{
    box-sizing: border-box;
    width: 40dp;
    height: 40dp;
    background-color: var(--color-secondary);
    border-width: 1dp;
    border-color: var(--color-secondary-hover);
    border-radius: var(--radius-control);
    color: var(--color-background);
    font-size: 24dp;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
    flex: none;
}

.servers-heading
{
    display: block;
}

.servers-product
{
    display: block;
    color: var(--color-text);
    font-size: 18dp;
    line-height: 20dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.servers-title
{
    display: block;
    color: var(--color-primary);
    font-size: 11dp;
    line-height: 16dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.servers-back
{
    min-width: 184dp;
}

.servers-toolbar
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 72dp;
    padding: var(--space-2) var(--space-3);
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-background);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.servers-source
{
    display: block;
    flex: none;
    width: 208dp;
}

.servers-source-kicker,
.servers-search-label,
.servers-selection-label
{
    display: block;
    color: var(--color-disabled);
    font-size: 10dp;
    line-height: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.servers-source-name
{
    display: block;
    color: var(--color-primary);
    font-size: 13dp;
    line-height: 20dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.servers-search
{
    display: block;
    flex: 1;
    min-width: 240dp;
}

.servers-search-input
{
    height: 36dp;
    line-height: 34dp;
}

.servers-refresh
{
    flex: none;
    width: 152dp;
}

.servers-filter-options
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 48dp;
    padding: var(--space-1) var(--space-3);
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.servers-filter-kicker
{
    flex: none;
    width: 56dp;
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.servers-filter-toggle
{
    flex: none;
    height: 32dp;
    color: var(--color-text-muted);
    font-size: 11dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.servers-filter-toggle:hover
{
    color: var(--color-text);
}

.servers-table
{
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    background-color: var(--color-surface);
}

.server-grid
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    flex-direction: row;
    align-items: center;
}

.servers-columns
{
    flex: none;
    height: 40dp;
    padding: 0 20dp 0 11dp;
    background-color: var(--color-surface-2);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.server-heading-button,
.server-heading-label
{
    box-sizing: border-box;
    display: block;
    height: 39dp;
    padding: 0 var(--space-1);
    background-color: transparent;
    border-width: 0 0 2dp 0;
    border-color: transparent;
    color: var(--color-text-muted);
    font-family: Lato;
    font-size: 10dp;
    line-height: 37dp;
    letter-spacing: 1dp;
    text-align: left;
    text-transform: uppercase;
}

.server-heading-button
{
    width: 100%;
}

.server-heading-button:hover,
.server-heading-button:focus-visible
{
    background-color: var(--color-background);
    color: var(--color-text);
}

.server-heading-button.is-selected
{
    border-bottom-color: var(--color-primary);
    color: var(--color-primary);
}

.server-rows
{
    display: block;
    flex: 1;
    min-height: 0;
    overflow-y: scroll;
}

.server-rows scrollbarvertical
{
    width: 12dp;
    background-color: var(--color-background);
    border-left-width: 1dp;
    border-left-color: var(--color-border);
}

.server-rows scrollbarvertical slidertrack
{
    width: 11dp;
    background-color: var(--color-background);
}

.server-rows scrollbarvertical sliderbar
{
    width: 7dp;
    min-height: 40dp;
    margin-left: 2dp;
    background-color: var(--color-disabled);
    border-radius: var(--radius-control);
}

.server-rows scrollbarvertical sliderbar:hover
{
    background-color: var(--color-primary-pressed);
}

.server-rows scrollbarvertical sliderbar:active
{
    background-color: var(--color-primary);
}

.server-rows scrollbarvertical sliderarrowdec,
.server-rows scrollbarvertical sliderarrowinc
{
    width: 0;
    height: 0;
}

.server-row-repeat
{
    display: block;
    width: 100%;
}

.server-row
{
    display: flex;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 48dp;
    padding: 0 var(--space-2);
    align-items: center;
    background-color: var(--color-surface);
    border-width: 0 0 1dp 3dp;
    border-color: var(--color-border) var(--color-border) var(--color-border) transparent;
    color: var(--color-text-muted);
    font-family: Lato;
    font-size: 12dp;
    line-height: 16dp;
    text-align: left;
    tab-index: auto;
}

.server-row:hover,
.server-row:focus-visible
{
    background-color: var(--color-surface-2);
    border-left-color: var(--color-primary-pressed);
    color: var(--color-text);
}

.server-row:active
{
    background-color: var(--color-primary-pressed);
}

.server-row.is-selected
{
    background-color: #1B2A38;
    border-left-color: var(--color-primary);
    color: var(--color-text);
}

.server-row.is-unavailable
{
    color: var(--color-disabled);
}

.server-cell-name
{
    box-sizing: border-box;
    flex: 0 0 38%;
    min-width: 0;
    padding: 0 var(--space-1);
    overflow: hidden;
}

.server-cell-favorite
{
    box-sizing: border-box;
    display: flex;
    flex: 0 0 4%;
    min-width: 40dp;
    align-items: center;
    justify-content: center;
}

.servers-columns .server-cell-favorite .cb-ico
{
    image-color: var(--color-disabled);
}

.server-favorite
{
    box-sizing: border-box;
    display: flex;
    width: 32dp;
    height: 32dp;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 1dp;
    border-color: transparent;
}

.server-favorite .cb-ico
{
    image-color: var(--color-disabled);
}

.server-favorite:hover,
.server-favorite:focus-visible
{
    background-color: var(--color-background);
    border-color: var(--color-warning);
}

.server-favorite:hover .cb-ico,
.server-favorite:focus-visible .cb-ico,
.server-favorite.is-favorite .cb-ico
{
    image-color: var(--color-warning);
}

.server-cell-mode
{
    box-sizing: border-box;
    flex: 0 0 14%;
    min-width: 0;
    padding: 0 var(--space-1);
    overflow: hidden;
}

.server-cell-map
{
    box-sizing: border-box;
    flex: 0 0 16%;
    min-width: 0;
    padding: 0 var(--space-1);
    overflow: hidden;
}

.server-cell-players
{
    box-sizing: border-box;
    flex: 0 0 10%;
    min-width: 0;
    padding: 0 var(--space-1);
    overflow: hidden;
}

.server-cell-ping
{
    box-sizing: border-box;
    flex: 0 0 8%;
    min-width: 0;
    padding: 0 var(--space-1);
    overflow: hidden;
}

.server-cell-status
{
    box-sizing: border-box;
    flex: 0 0 10%;
    min-width: 0;
    padding: 0 var(--space-1);
    overflow: hidden;
}

.servers-columns .server-heading-cell
{
    padding: 0;
}

.server-name
{
    display: block;
    overflow: hidden;
    color: var(--color-text);
    font-size: 13dp;
    line-height: 17dp;
    white-space: nowrap;
}

.server-row.is-selected .server-name
{
    color: var(--color-primary);
}

.server-host
{
    display: block;
    overflow: hidden;
    color: var(--color-disabled);
    font-size: 10dp;
    line-height: 13dp;
    letter-spacing: 1dp;
    white-space: nowrap;
}

.server-ping.ping-good
{
    color: var(--color-success);
}

.server-ping.ping-medium
{
    color: var(--color-warning);
}

.server-ping.ping-slow,
.server-row.is-incompatible .server-status
{
    color: var(--color-error);
}

.server-row.is-full .server-status
{
    color: var(--color-warning);
}

.server-row.is-waiting .server-status
{
    color: var(--color-disabled);
}

.servers-empty
{
    box-sizing: border-box;
    display: block;
    margin: var(--space-5) auto 0 auto;
    padding: var(--space-3);
    width: 440dp;
    max-width: 90%;
    background-color: var(--color-background);
    border-left-width: 3dp;
    border-left-color: var(--color-primary);
}

.servers-empty-icon
{
    display: block;
    margin-bottom: var(--space-2);
    image-color: var(--color-primary);
}

.servers-empty-title
{
    color: var(--color-text);
    font-size: 16dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.servers-empty-copy
{
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 12dp;
}

.servers-selection
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    min-height: 88dp;
    padding: var(--space-2) var(--space-3);
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-background);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.servers-selection-copy
{
    display: block;
    flex: 1;
    min-width: 0;
}

.servers-selection-name
{
    display: block;
    overflow: hidden;
    color: var(--color-text);
    font-size: 15dp;
    line-height: 22dp;
    white-space: nowrap;
}

.servers-selection-details
{
    display: block;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 10dp;
    line-height: 16dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    white-space: nowrap;
}

.servers-connect
{
    flex: none;
    width: 168dp;
}

.servers-connect.is-disabled
{
    background-color: var(--color-surface-2);
    border-color: var(--color-disabled);
    color: var(--color-disabled);
    opacity: 0.78;
}

.servers-footer
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 40dp;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface-2);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
    color: var(--color-text-muted);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.servers-footer-help
{
    color: var(--color-disabled);
}

@media (max-width: 900dp)
{
    .servers-screen
    {
        padding: 0;
    }

    .servers-header
    {
        padding: 0 var(--space-2);
    }

    .servers-source
    {
        width: 184dp;
    }

    .servers-toolbar
    {
        padding-left: var(--space-2);
        padding-right: var(--space-2);
        gap: var(--space-1);
    }

    .servers-search
    {
        min-width: 0;
    }

    .servers-refresh
    {
        width: 136dp;
    }

    .servers-filter-options
    {
        padding-left: var(--space-2);
        padding-right: var(--space-2);
        gap: var(--space-2);
    }
}

@media (max-height: 700dp)
{
    .servers-screen
    {
        padding: 0;
    }

    .servers-header
    {
        height: 64dp;
    }

    .servers-toolbar
    {
        height: 64dp;
    }

    .servers-selection
    {
        min-height: 72dp;
    }

    .servers-footer
    {
        height: 36dp;
    }
}
