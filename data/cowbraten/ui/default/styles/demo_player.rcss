body
{
    background-color: transparent;
}

.demo-player
{
    position: absolute;
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    padding: 28dp 36dp 32dp;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
}

.demo-player-controls
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    max-width: 1180dp;
    margin: 0 auto;
    padding: 14dp 18dp 16dp;
    flex-direction: column;
    background-color: #101419;
    border-width: 1dp;
    border-color: #E7EBF02C;
    pointer-events: none;
}

.demo-player.is-interactive .demo-player-controls
{
    background-color: #101419;
    border-color: #2F7CCBAA;
    pointer-events: auto;
}

.demo-player-status-row
{
    display: flex;
    height: 24dp;
    align-items: center;
}

.demo-player-status
{
    display: flex;
    width: 104dp;
    align-items: center;
    gap: 7dp;
    color: var(--color-text);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.demo-player-status-dot
{
    width: 7dp;
    height: 7dp;
    background-color: var(--color-success);
    border-radius: 4dp;
}

.demo-player-status.is-paused .demo-player-status-dot
{
    background-color: var(--color-warning);
}

.demo-player-clock
{
    color: var(--color-text);
    font-size: 11dp;
    letter-spacing: 1dp;
}

.demo-player-metadata
{
    flex: 1;
    margin-left: 20dp;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 9dp;
    letter-spacing: 1dp;
    text-align: left;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.demo-player-hint
{
    flex: none;
    color: var(--color-text-muted);
    font-size: 9dp;
    letter-spacing: 1dp;
    text-align: right;
    text-transform: uppercase;
}

.demo-player-cursor
{
    position: absolute;
    display: block;
    pointer-events: none;
}

.demo-player-timeline
{
    position: relative;
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 24dp;
    margin: 5dp 0 12dp;
    padding: 0;
    background: transparent;
    border-width: 0;
    tab-index: auto;
}

.demo-player-track
{
    position: absolute;
    display: block;
    width: 100%;
    height: 6dp;
    left: 0;
    top: 0;
    margin-top: 9dp;
    background-color: #E7EBF03A;
}

.demo-player-progress
{
    display: block;
    width: 0;
    height: 6dp;
    background-color: var(--color-primary);
}

.demo-player-marker
{
    position: absolute;
    display: block;
    width: 16dp;
    height: 16dp;
    left: 0;
    top: -5dp;
    margin-left: -8dp;
    background-color: var(--color-primary);
    border-width: 2dp;
    border-color: var(--color-text);
    border-radius: 8dp;
}

.demo-player-timeline:hover .demo-player-marker,
.demo-player-timeline:focus-visible .demo-player-marker
{
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary);
}

.demo-player-button-row
{
    display: flex;
    align-items: center;
    gap: 7dp;
}

.demo-player-button
{
    box-sizing: border-box;
    height: 38dp;
    padding: 0 14dp;
    background-color: #20262DEB;
    border-width: 1dp;
    border-color: #E7EBF03A;
    color: var(--color-text-muted);
    font-family: Lato;
    font-size: 10dp;
    line-height: 36dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
}

.demo-player-button:hover,
.demo-player-button:focus-visible
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary-hover);
    color: var(--color-text);
}

.demo-player-button:active
{
    background-color: var(--color-primary);
    color: var(--color-background);
}

.demo-player-button .cb-ico
{
    margin-right: 7dp;
    image-color: var(--color-text-muted);
}

.demo-player-button:hover .cb-ico,
.demo-player-button:focus-visible .cb-ico
{
    image-color: var(--color-text);
}

.demo-player-primary
{
    min-width: 92dp;
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-background);
}

.demo-player-primary .cb-ico
{
    image-color: var(--color-background);
}

.demo-player-speed
{
    min-width: 122dp;
}

.demo-player-analysis
{
    min-width: 98dp;
}

.demo-player-analysis.is-active
{
    background-color: #163C62;
    border-color: var(--color-primary);
    color: var(--color-text);
}

.demo-player-analysis.is-active .cb-ico
{
    image-color: var(--color-primary-hover);
}

.demo-player-spacer
{
    flex: 1;
}

.demo-player-stop
{
    border-color: #F06464AA;
    color: var(--color-error);
}

.demo-player-stop .cb-ico
{
    image-color: var(--color-error);
}

@media (max-width: 900dp)
{
    .demo-player { padding: 18dp; }
    .demo-player-controls { padding: 11dp 12dp 13dp; }
    .demo-player-step { display: none; }
    .demo-player-button { padding: 0 9dp; font-size: 9dp; }
    .demo-player-metadata { display: none; }
}

@media (max-height: 600dp)
{
    .demo-player { padding-top: 18dp; padding-bottom: 18dp; }
    .demo-player-controls { padding-top: 9dp; padding-bottom: 10dp; }
}
