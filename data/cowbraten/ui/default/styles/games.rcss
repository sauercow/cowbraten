.games-screen
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 22dp 26dp 18dp 26dp;
    flex-direction: column;
    gap: 14dp;
    overflow: hidden;
}

.games-header
{
    display: flex;
    flex: none;
    align-items: flex-end;
    justify-content: space-between;
}

.games-header > div, .games-title, .games-copy,
.games-current small, .games-current strong
{
    display: block;
}

.games-title, .campaign-title
{
    color: var(--color-text);
    font-size: 1.5625rem;
    line-height: 31dp;
    letter-spacing: 1dp;
}

.games-copy
{
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    line-height: 17dp;
}

.games-current
{
    display: block;
    min-width: 220dp;
    text-align: right;
}

.games-current small, .games-current strong
{
    display: block;
}

.games-current small, .campaign-series
{
    color: var(--color-primary);
    font-size: 0.5625rem;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.games-current strong
{
    color: var(--color-text);
    font-size: 0.75rem;
}

.games-tabs
{
    display: flex;
    flex: none;
    height: 42dp;
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.games-tab
{
    box-sizing: border-box;
    height: 42dp;
    padding: 0 22dp;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.games-tab:hover, .games-tab:focus-visible
{
    color: var(--color-text);
}

.games-tab.is-selected
{
    border-bottom-color: var(--color-primary);
    color: var(--color-primary);
}

.games-workspace
{
    display: flex;
    flex: 1;
    min-height: 0;
    gap: 14dp;
}

.games-modes
{
    display: flex;
    width: 210dp;
    min-width: 210dp;
    flex-direction: column;
    overflow: hidden;
}

.games-maps
{
    display: flex;
    flex: 1;
    min-width: 320dp;
    flex-direction: column;
    overflow: hidden;
}

.games-summary
{
    box-sizing: border-box;
    display: flex;
    width: 280dp;
    min-width: 280dp;
    padding-bottom: 16dp;
    flex-direction: column;
    overflow: hidden;
}

.games-panel-heading
{
    box-sizing: border-box;
    display: flex;
    height: 50dp;
    padding: 0 14dp;
    flex: none;
    align-items: center;
    gap: 10dp;
    background-color: var(--color-surface-2);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
    color: var(--color-text);
    font-size: 0.6875rem;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.games-panel-heading > span
{
    color: var(--color-primary);
}

.map-filter
{
    width: 190dp;
    height: 31dp;
    margin-left: auto;
    font-size: 0.625rem;
}

.mode-list, .map-list, .campaign-list
{
    min-height: 0;
    overflow-y: auto;
}

.mode-list
{
    flex: 1;
    padding: 7dp;
}

.mode-row
{
    box-sizing: border-box;
    display: block;
    width: 100%;
    min-height: 31dp;
    padding: 7dp 10dp;
    background-color: transparent;
    border-width: 0;
    border-left-width: 2dp;
    border-left-color: transparent;
    color: var(--color-text-muted);
    font-size: 0.625rem;
    text-align: left;
    text-transform: uppercase;
}

.mode-row:hover, .mode-row:focus-visible
{
    background-color: var(--color-surface-2);
    color: var(--color-text);
}

.mode-row.is-selected
{
    background-color: var(--color-surface-2);
    border-left-color: var(--color-primary);
    color: var(--color-primary);
}

.map-list
{
    display: flex;
    flex: 1;
    padding: 10dp;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 9dp;
}

.map-card
{
    box-sizing: border-box;
    display: block;
    width: 132dp;
    min-width: 132dp;
    height: 108dp;
    flex: none;
    padding: 0;
    overflow: hidden;
    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-control);
    color: var(--color-text-muted);
}

.campaign-card
{
    flex: none;
}

.map-card:hover, .map-card:focus-visible
{
    border-color: var(--color-primary-hover);
    color: var(--color-text);
}

.map-card.is-selected
{
    border-color: var(--color-primary);
    color: var(--color-primary);
}

.map-preview
{
    position: relative;
    display: block;
    width: 130dp;
    height: 76dp;
    overflow: hidden;
    background-color: var(--color-background);
}

.map-preview img
{
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
}

.map-fallback
{
    display: block;
    color: var(--color-disabled);
    font-size: 0.8125rem;
    line-height: 76dp;
    letter-spacing: 3dp;
    text-align: center;
}

.map-card > strong
{
    display: block;
    padding: 8dp;
    overflow: hidden;
    font-size: 0.5625rem;
    letter-spacing: 1dp;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.summary-mode, .summary-map, .summary-description, .bot-options, .games-launch
{
    margin-left: 16dp;
    margin-right: 16dp;
}

.summary-mode
{
    margin-top: 18dp;
    color: var(--color-primary);
    font-size: 0.625rem;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.summary-map
{
    margin-top: 6dp;
    color: var(--color-text);
    font-size: 1.375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.summary-description
{
    margin-top: 12dp;
    flex: 1;
    color: var(--color-text-muted);
    font-size: 0.625rem;
    line-height: 15dp;
}

.bot-options
{
    display: block;
    margin-top: 8dp;
    padding-top: 10dp;
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.bot-options label
{
    display: flex;
    margin-top: 6dp;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: 0.5625rem;
    text-transform: uppercase;
}

.bot-options label strong
{
    color: var(--color-primary);
}

.bot-options input
{
    width: 100%;
}

.games-launch
{
    margin-top: 14dp;
    flex: none;
}

.games-status
{
    flex: none;
    min-height: 16dp;
    color: var(--color-text-muted);
    font-size: 0.5625rem;
    letter-spacing: 1dp;
}

.games-empty
{
    padding: 30dp;
    color: var(--color-text-muted);
}

.games-campaign
{
    display: flex;
    flex: 1;
    min-height: 0;
    gap: 14dp;
}

.campaign-intro
{
    box-sizing: border-box;
    width: 270dp;
    min-width: 270dp;
    padding: 22dp;
}

.campaign-list
{
    display: flex;
    flex: 1;
    padding-right: 4dp;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 10dp;
}

.campaign-card
{
    box-sizing: border-box;
    display: block;
    width: 240dp;
    min-height: 100dp;
    padding: 16dp;
    color: var(--color-text-muted);
    text-align: left;
}

.campaign-card:hover, .campaign-card:focus-visible
{
    border-color: var(--color-primary);
}

.campaign-card strong, .campaign-card small, .campaign-series
{
    display: block;
}

.campaign-card strong
{
    margin-top: 10dp;
    color: var(--color-text);
    font-size: 0.8125rem;
}

.campaign-card small
{
    margin-top: 5dp;
    font-size: 0.5625rem;
}

@media (max-width: 1100dp)
{
    .games-summary { width: 235dp; min-width: 235dp; }
    .games-modes { width: 175dp; min-width: 175dp; }
    .map-card { width: 116dp; }
    .map-preview { width: 114dp; }
}
