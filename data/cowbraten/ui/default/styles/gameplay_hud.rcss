/* Cowbraten status dock. Layout dimensions in em scale with viewport height.
   The FPS engine owns game state; this sheet only describes presentation. */
body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    font-family: Lato;
    pointer-events: none;
}
.cow-demo-recording {
    position: absolute;
    display: none;
    right: 2%;
    top: 2.1%;
    color: #FF3F48;
    font-size: 1.45rem;
    font-weight: bold;
    letter-spacing: 0.08rem;
    pointer-events: none;
}
.cow-status-root {
    position: absolute;
    left: 0;
    top: 92.333%;
    width: 100%;
    display: none;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    pointer-events: none;
}
.cow-status-dock {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.cow-status-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 2.60em;
    width: 7.25em;
    margin-right: 0.20em;
    padding: 0 0.32em;
    border: 1px #56748C;
    border-radius: 0.43em;
    background-color: #0B1725E9;
    color: #F6FAFF;
    pointer-events: none;
}
.cow-status-health {
    border-color: #FF506A;
    background-color: #2C1724E9;
}
.cow-status-armour {
    border-color: #318DE9;
    background-color: #10283BE9;
}
.cow-status-ammo {
    border-color: #FFB72E;
    background-color: #302512E9;
}
.cow-status-ammo-wrap {
    position: relative;
    display: flex;
    flex-direction: row;
    overflow: visible;
}
.cow-status-secondary {
    position: absolute;
    display: none;
    gap: 0.08em;
    pointer-events: none;
}
.cow-status-secondary img {
    display: none;
    width: 0.82em;
    height: 0.52em;
}
.cow-status-secondary-up {
    left: 100%;
    top: 0.10em;
    flex-direction: column;
}
.cow-status-secondary-down {
    right: 100%;
    bottom: 0.10em;
    flex-direction: column-reverse;
}
.cow-status-secondary-cycle {
    left: 0;
    bottom: 100%;
    width: 7.25em;
    align-items: center;
    justify-content: center;
    flex-direction: row;
}
.cow-status-icon {
    display: inline-block;
    width: 2.35em;
    height: 1.47em;
    flex-shrink: 0;
    margin-right: 0.22em;
}
.cow-status-metrics {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.cow-status-value {
    font-size: 1.38em;
    font-weight: bold;
    color: #FFFFFF;
    white-space: nowrap;
}
.cow-status-max {
    display: none;
    font-size: 0.55em;
    color: #B8E5FC;
}
.cow-status-label {
    font-size: 0.52em;
    letter-spacing: 0.07em;
    color: #D0DCEB;
}
.cow-status-warning .cow-status-value { color: #FFC56A; }
.cow-status-critical .cow-status-value { color: #FF6678; }
.cow-status-boosted .cow-status-value { color: #78E7FF; }
.cow-status-empty { opacity: 1; }
.cow-status-empty .cow-status-value { color: #8C9AAA; }
.cow-armour-green { border-color: #5CCD85; }
.cow-armour-yellow { border-color: #F8CF63; }
.cow-armour-blue { border-color: #459BFF; }
.cow-status-quad {
    display: none;
    flex-direction: row;
    align-items: center;
    height: 2.60em;
    padding: 0 0.25em;
}
.cow-status-quad .cow-status-icon {
    margin-right: 0;
}
.cow-status-mode {
    position: relative;
    display: none;
    height: 2.60em;
    width: 4.45em;
    margin-left: 0.02em;
    padding: 0 0.30em;
    border: 1px #AAB4C0;
    border-radius: 0.43em;
    background-color: #1B2028E9;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-weight: bold;
    pointer-events: none;
}
.cow-status-mode .cow-status-icon {
    width: 3.45em;
    height: 2.16em;
    margin-right: 0;
}
.cow-status-mode #cow-status-mode-count {
    position: absolute;
    right: 0.18em;
    bottom: 0.10em;
    min-width: 0.72em;
    padding: 0.02em 0.10em;
    border-radius: 0.18em;
    background-color: #07101FCC;
    color: #FFFFFF;
    font-size: 0.72em;
    text-align: center;
}
.cow-mode-red {
    border-color: #FF506A;
    background-color: #2C1724E9;
}
.cow-mode-blue {
    border-color: #318DE9;
    background-color: #10283BE9;
}
.cow-mode-neutral, .cow-mode-token {
    border-color: #AAB4C0;
    background-color: #1B2028E9;
}
.cow-ammo-bar-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
}
.cow-ammo-bar-item {
    position: absolute;
    display: none;
    color: #FFFFFF;
    pointer-events: none;
}
.cow-ammo-bar-item img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
.cow-ammo-bar-item span {
    position: absolute;
    display: block;
    text-align: center;
    white-space: nowrap;
    font-weight: bold;
    color: #FFFFFF;
}
.cow-ammo-bar-warning span { color: #FFC56A; }
.cow-ammo-bar-critical span { color: #FF6678; }
.cow-ammo-bar-empty { opacity: 0.50; }


/* cow-status-compact-internal-v1 */
/* Square-cropped source keeps the armour shield's natural proportions. */
#cow-status-armour .cow-status-icon {
    width: 2.40em;
    height: 1.50em;
    margin-right: 0.22em;
}
