body
{
    background-color: transparent;
}

.settings-screen
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #0E101238;
}

.settings-shell
{
    display: flex;
    flex-direction: column;
    width: 1440dp;
    max-width: 100%;
    height: 800dp;
    max-height: 100%;
    overflow: hidden;
}

.settings-header
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 72dp;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.settings-lockup
{
    display: flex;
    align-items: center;
    gap: var(--space-2);
}

.settings-mark
{
    box-sizing: border-box;
    width: 40dp;
    height: 40dp;
    background-color: var(--color-secondary);
    border-width: 1dp;
    border-color: var(--color-secondary-hover);
    border-radius: var(--radius-control);
    color: var(--color-background);
    font-size: 24dp;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
}

.settings-heading
{
    display: block;
}

.settings-product
{
    display: block;
    color: var(--color-text);
    font-size: 18dp;
    line-height: 20dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.settings-title
{
    display: block;
    color: var(--color-primary);
    font-size: 11dp;
    line-height: 16dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.settings-back
{
    min-width: 184dp;
}

.settings-content
{
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: row;
}

.settings-navigation
{
    box-sizing: border-box;
    display: flex;
    flex: 0 0 312dp;
    min-width: 0;
    padding: var(--space-3);
    flex-direction: column;
    background-color: var(--color-background);
    border-right-width: 1dp;
    border-right-color: var(--color-border);
}

.settings-navigation-label
{
    flex: none;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-size: 12dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.settings-nav-list
{
    gap: var(--space-1);
}

.settings-nav-item
{
    display: flex;
    height: 44dp;
    align-items: center;
    line-height: 42dp;
}

.settings-nav-index
{
    display: block;
    flex: none;
    width: 32dp;
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
}

.settings-nav-item.is-selected .settings-nav-index
{
    color: var(--color-primary);
}

.settings-scope-note
{
    box-sizing: border-box;
    display: block;
    margin-top: auto;
    padding: var(--space-2);
    background-color: var(--color-surface);
    border-left-width: 3dp;
    border-left-color: var(--color-secondary);
}

.settings-scope-kicker
{
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-secondary);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-scope-copy
{
    display: block;
    color: var(--color-text-muted);
    font-size: 11dp;
    line-height: 16dp;
}

.settings-stage
{
    box-sizing: border-box;
    display: flex;
    flex: 1;
    min-width: 0;
    padding: var(--space-5);
    flex-direction: column;
    background-color: var(--color-surface);
}

.settings-page
{
    box-sizing: border-box;
    display: flex;
    flex: 1;
    min-height: 0;
    width: 100%;
    padding-right: var(--space-1);
    flex-direction: column;
    overflow-y: auto;
}

.settings-page scrollbarvertical
{
    width: 12dp;
    background-color: var(--color-surface);
}

.settings-page scrollbarvertical slidertrack
{
    width: 11dp;
    background-color: var(--color-surface);
}

.settings-page scrollbarvertical sliderbar
{
    width: 7dp;
    min-height: 40dp;
    margin-left: 2dp;
    background-color: var(--color-disabled);
    border-radius: var(--radius-control);
}

.settings-page scrollbarvertical sliderbar:hover
{
    background-color: var(--color-primary-pressed);
}

.settings-page scrollbarvertical sliderbar:active
{
    background-color: var(--color-primary);
}

.settings-page scrollbarvertical sliderarrowdec,
.settings-page scrollbarvertical sliderarrowinc
{
    width: 0;
    height: 0;
}

.settings-stage-header
{
    display: flex;
    flex: none;
    flex-direction: column;
    padding-bottom: var(--space-3);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.settings-eyebrow
{
    margin-bottom: var(--space-1);
}

.settings-stage-title
{
    color: var(--color-text);
    font-size: 40dp;
    line-height: 48dp;
    letter-spacing: 3dp;
    text-transform: uppercase;
}

.settings-stage-copy
{
    display: block;
    max-width: 720dp;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 13dp;
    line-height: 20dp;
}

.settings-subsection-header
{
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.settings-subsection-header .settings-eyebrow
{
    margin-bottom: 4dp;
}

.settings-subsection-header .settings-stage-title
{
    font-size: 24dp;
    line-height: 32dp;
    letter-spacing: 2dp;
}

.settings-subsection-header .settings-stage-copy
{
    margin-top: 4dp;
    font-size: 12dp;
    line-height: 18dp;
}

.settings-section
{
    display: block;
    flex: none;
    margin-top: var(--space-4);
    padding: var(--space-3);
    background-color: var(--color-background);
}

.settings-control-heading
{
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.settings-control-copy
{
    display: block;
    flex: 1;
    min-width: 0;
}

.settings-control-title
{
    display: block;
    color: var(--color-text);
    font-size: 18dp;
    line-height: 24dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-control-description
{
    display: block;
    max-width: 640dp;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 12dp;
    line-height: 18dp;
}

.settings-value
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    width: 144dp;
    height: 56dp;
    margin-left: var(--space-3);
    align-items: baseline;
    justify-content: center;
    background-color: var(--color-surface-2);
    border-left-width: 3dp;
    border-left-color: var(--color-primary);
}

.settings-value-number
{
    color: var(--color-primary);
    font-size: 24dp;
    line-height: 54dp;
}

.settings-value-unit
{
    margin-left: var(--space-1);
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-color-swatch
{
    box-sizing: border-box;
    flex: none;
    width: 56dp;
    height: 32dp;
    margin-left: var(--space-3);
    border-width: 1dp;
    border-color: var(--color-border);
}

.settings-range-row
{
    display: flex;
    margin-top: var(--space-4);
    align-items: center;
}

.settings-range-bound
{
    flex: none;
    width: 40dp;
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
}

.settings-range-maximum
{
    text-align: right;
}

.settings-range
{
    display: block;
    flex: 1;
    height: 32dp;
    tab-index: auto;
}

.settings-range slidertrack
{
    height: 4dp;
    margin-top: 14dp;
    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
}

.settings-range:focus-visible slidertrack
{
    border-color: var(--color-primary);
}

.settings-range sliderprogress
{
    height: 4dp;
    margin-top: 0;
    background-color: var(--color-primary-pressed);
}

.settings-range sliderbar
{
    width: 16dp;
    height: 16dp;
    margin-top: 8dp;
    margin-left: -8dp;
    margin-right: -8dp;
    background-color: var(--color-primary);
    border-width: 2dp;
    border-color: var(--color-background);
    border-radius: 8dp;
}

.settings-range sliderbar:hover,
.settings-range slidertrack:hover + sliderbar
{
    background-color: var(--color-primary-hover);
    border-color: var(--color-text);
}

.settings-range sliderbar:active,
.settings-range slidertrack:active + sliderbar
{
    background-color: var(--color-primary-pressed);
}

.settings-range sliderarrowdec,
.settings-range sliderarrowinc
{
    width: 0;
    height: 0;
}

.settings-control-footer
{
    display: flex;
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    align-items: center;
    gap: var(--space-1);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-live-indicator
{
    display: inline-block;
    width: 7dp;
    height: 7dp;
    background-color: var(--color-success);
    border-radius: 4dp;
}

.settings-info-row
{
    display: flex;
    flex: none;
    margin-top: var(--space-3);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.settings-info-block
{
    box-sizing: border-box;
    display: block;
    flex: 1;
    min-width: 0;
    padding: var(--space-2);
    border-right-width: 1dp;
    border-right-color: var(--color-border);
}

.settings-info-block:last-child
{
    border-right-width: 0;
}

.settings-info-label
{
    display: block;
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-info-value
{
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 11dp;
    line-height: 16dp;
}

.settings-stage-spacer
{
    flex: 1;
}

.settings-display-section
{
    padding-bottom: var(--space-2);
}

.settings-mode-current
{
    min-width: 216dp;
}

.settings-mode-selector
{
    display: flex;
    margin-top: var(--space-3);
    gap: var(--space-1);
}

.settings-mode-button
{
    flex: 1;
    height: 40dp;
    line-height: 38dp;
}

.settings-mode-button.is-selected
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary);
    color: var(--color-text);
}

.settings-display-row
{
    display: flex;
    min-height: 56dp;
    align-items: center;
    justify-content: space-between;
}

.settings-display-toggle
{
    box-sizing: border-box;
    flex: none;
    min-width: 160dp;
    height: 40dp;
    margin-left: var(--space-3);
    padding: 0 var(--space-2);
    justify-content: center;
    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-control);
    color: var(--color-text);
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-performance-section
{
    margin-top: var(--space-3);
}

.settings-control-footer-compact
{
    margin-top: var(--space-2);
    padding-top: var(--space-1);
}

.settings-fps-heading
{
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.settings-fps-value
{
    width: 168dp;
}

.settings-fps-value-label
{
    color: var(--color-primary);
    font-size: 16dp;
    line-height: 54dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-fps-range-row
{
    margin-top: var(--space-2);
}

.settings-antialiasing-section
{
    margin-top: var(--space-3);
}

.settings-antialiasing-current
{
    min-width: 168dp;
}

.settings-antialiasing-selector
{
    display: flex;
    margin-top: var(--space-3);
    gap: var(--space-1);
}

.settings-antialiasing-button
{
    flex: 1;
    height: 36dp;
    line-height: 34dp;
}

.settings-antialiasing-button.is-selected
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary);
    color: var(--color-text);
}

.settings-resolution-section
{
    margin-top: var(--space-3);
}

.settings-resolution-current
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    min-width: 184dp;
    height: 56dp;
    margin-left: var(--space-3);
    padding: 0 var(--space-2);
    flex-direction: column;
    justify-content: center;
    background-color: var(--color-surface-2);
    border-left-width: 3dp;
    border-left-color: var(--color-primary);
}

.settings-resolution-current-value
{
    display: block;
    margin-top: 4dp;
    color: var(--color-primary);
    font-size: 15dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-resolution-render
{
    display: block;
    margin-top: 2dp;
    color: var(--color-text-muted);
    font-size: 10dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
}

.settings-resolution-grid
{
    display: flex;
    margin-top: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-1);
}

.settings-resolution-repeat
{
    display: block;
    flex: 1 0 144dp;
}

.settings-resolution-button
{
    width: 100%;
    height: 36dp;
    line-height: 34dp;
    font-size: 11dp;
}

.settings-resolution-button.is-selected:disabled
{
    border-color: var(--color-primary);
    color: var(--color-primary);
}

.settings-resolution-note
{
    display: block;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background-color: #E3B34118;
    border-left-width: 3dp;
    border-left-color: var(--color-warning);
    color: var(--color-text-muted);
    font-size: 11dp;
    line-height: 18dp;
}

.settings-audio-section
{
    margin-top: var(--space-3);
}

.settings-audio-value
{
    width: 136dp;
}

.settings-audio-range-row
{
    margin-top: var(--space-3);
}

.settings-audio-info-row
{
    margin-top: var(--space-3);
}

.settings-soundpack-current
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    width: 176dp;
    min-width: 0;
    height: 54dp;
    margin-left: var(--space-3);
    padding: 0 var(--space-2);
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-2);
    border-left-width: 3dp;
    border-left-color: var(--color-primary);
}

.settings-soundpack-current-label
{
    display: block;
    width: 100%;
    overflow: hidden;
    color: var(--color-primary);
    font-size: 12dp;
    letter-spacing: 1dp;
    text-align: center;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.settings-soundpack-grid
{
    display: flex;
    margin-top: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-1);
}

.settings-soundpack-repeat
{
    display: block;
    flex: 1 0 184dp;
}

.settings-soundpack-choice
{
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 40dp;
    padding: 0 var(--space-2);
    align-items: center;
    justify-content: space-between;
    line-height: 38dp;
}

.settings-soundpack-choice.is-selected
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary);
    color: var(--color-text);
}

.settings-soundpack-choice-label
{
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.settings-soundpack-choice-state
{
    display: block;
    margin-left: var(--space-2);
    color: var(--color-primary);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-input-section
{
    margin-top: var(--space-3);
}

.settings-compact-section
{
    margin-top: var(--space-3);
}

.settings-subsection-panel
{
    margin-top: var(--space-2);
}

.settings-subsection-panel .settings-display-row
{
    min-height: 44dp;
}

.settings-subsection-panel .settings-control-title
{
    font-size: 15dp;
    line-height: 20dp;
}

.settings-subsection-panel .settings-control-description
{
    max-width: 760dp;
    margin-top: 3dp;
    font-size: 11dp;
    line-height: 16dp;
}

.settings-subsection-panel .settings-display-toggle
{
    min-width: 144dp;
    height: 36dp;
    font-size: 12dp;
}

.settings-subsection-panel .settings-control-divider
{
    margin-top: var(--space-1);
    padding-top: var(--space-1);
}

.settings-subsection-panel .settings-value
{
    width: 112dp;
    height: 44dp;
    margin-left: var(--space-2);
}

.settings-subsection-panel .settings-value-number
{
    font-size: 18dp;
    line-height: 42dp;
}

.settings-subsection-panel .settings-value-unit
{
    font-size: 10dp;
}

.settings-subsection-panel .settings-range-row
{
    margin-top: var(--space-1);
}

.settings-subsection-panel .settings-range
{
    height: 24dp;
}

.settings-subsection-panel .settings-range slidertrack
{
    margin-top: 10dp;
}

.settings-subsection-panel .settings-range sliderbar
{
    width: 14dp;
    height: 14dp;
    margin-top: 5dp;
    margin-left: -7dp;
    margin-right: -7dp;
    border-radius: 7dp;
}

.settings-subsection-panel .settings-range-bound
{
    width: 32dp;
    font-size: 10dp;
}

.settings-subsection-panel .settings-color-swatch
{
    width: 48dp;
    height: 28dp;
    margin-left: var(--space-2);
}

.settings-trail-colors .settings-color-weapon
{
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top-width: 2dp;
    border-top-color: var(--color-primary-pressed);
}

.settings-trail-colors .settings-color-weapon-first
{
    margin-top: 0;
    padding-top: 0;
    border-top-width: 0;
}

.settings-trail-colors .settings-color-weapon .settings-control-title
{
    font-size: 17dp;
    letter-spacing: 1dp;
}

.settings-console-columns
{
    display: flex;
    margin-top: var(--space-3);
    gap: var(--space-3);
}

.settings-console-column
{
    display: block;
    flex: 1;
    min-width: 0;
    margin-top: 0;
}

.settings-control-divider
{
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.settings-crosshair-current
{
    width: 176dp;
    height: 64dp;
    align-items: center;
    justify-content: flex-start;
}

.settings-crosshair-current-image
{
    display: block;
    flex: none;
    width: 40dp;
    height: 40dp;
    margin-left: var(--space-2);
}

.settings-crosshair-current-label
{
    display: block;
    flex: 1;
    min-width: 0;
    margin: 0 var(--space-2);
    overflow: hidden;
    color: var(--color-primary);
    font-size: 12dp;
    line-height: 16dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
}

.settings-crosshair-grid
{
    display: flex;
    margin-top: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-1);
}

.settings-crosshair-repeat
{
    display: block;
    flex: 0 0 168dp;
}

.settings-crosshair-choice
{
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 64dp;
    padding: 5dp var(--space-1);
    line-height: 14dp;
}

.settings-crosshair-choice-image
{
    display: block;
    width: 32dp;
    height: 32dp;
    margin: 0 auto;
}

.settings-crosshair-choice-label
{
    display: block;
    margin-top: 3dp;
    overflow: hidden;
    font-size: 10dp;
    letter-spacing: 1dp;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.settings-crosshair-choice.is-selected
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary);
    color: var(--color-text);
}

.settings-stepper
{
    display: flex;
    flex: none;
    width: 232dp;
    height: 40dp;
    margin-left: var(--space-3);
    gap: var(--space-1);
}

.settings-stepper-button
{
    width: 48dp;
    min-width: 48dp;
    height: 40dp;
    padding: 0;
    color: var(--color-primary);
    font-size: 20dp;
    line-height: 38dp;
}

.settings-stepper-value
{
    box-sizing: border-box;
    flex: 1;
    width: auto;
    height: 40dp;
    padding: 0;
    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
    color: var(--color-primary);
    font-size: 17dp;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-align: center;
}

.settings-stepper-value.is-invalid
{
    border-color: var(--color-error);
    color: var(--color-error);
}

.settings-unavailable-note
{
    display: block;
    margin-top: var(--space-3);
    padding: var(--space-2);
    background-color: var(--color-surface-2);
    border-left-width: 3dp;
    border-left-color: var(--color-disabled);
}

.settings-keybindings-panel
{
    margin-top: var(--space-3);
}

.settings-keybinding-group
{
    display: block;
    margin-top: var(--space-3);
}

.settings-keybinding-group-title
{
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-primary);
    font-size: 10dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.settings-keybinding-list
{
    display: block;
    border-top-width: 1dp;
    border-top-color: var(--color-border);
}

.settings-keybinding-row
{
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    min-height: 36dp;
    padding: var(--space-1) 0;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.settings-keybinding-label
{
    display: block;
    min-width: 0;
    color: var(--color-text);
    font-size: 12dp;
}

.settings-keybinding-values
{
    display: flex;
    flex: none;
    min-width: 180dp;
    margin-left: auto;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-1);
}

.button.settings-key-rebind
{
    height: 24dp;
    margin-left: var(--space-3);
    padding: 0 var(--space-2);
    line-height: 23dp;
    border-width: 1dp;
    border-color: var(--color-border);
}

.button.settings-key-rebind:hover,
.button.settings-key-rebind:focus-visible
{
   border-color: var(--color-primary);
}

.settings-key-capture
{
    width: 100%;
    margin-top: var(--space-1);
    color: var(--color-primary);
    font-size: 12dp;
}

.settings-key-conflict
{
    width: 100%;
    margin-top: 2dp;
    color: var(--color-warning);
    font-size: 11dp;
}

.settings-key-decisions
{
    display: flex;
    width: 100%;
    gap: var(--space-1);
    margin-top: var(--space-1);
}

.settings-key-decisions .button
{
    height: 24dp;
    padding: 1dp var(--space-2) 0;
    line-height: 23dp;
    border-width: 1dp;
    border-color: var(--color-border);
}

.settings-key-rebind:hover,
.settings-key-rebind:focus-visible,
.settings-key-decisions .button:hover,
.settings-key-decisions .button:focus-visible
{
    border-color: var(--color-primary);
}

.settings-key-result
{
    margin-top: var(--space-2);
    color: var(--color-text);
    font-size: 12dp;
}

.settings-key-conflict.is-available
{
    color: var(--color-success);
}

.settings-key-conflict.is-same-action
{
    color: var(--color-warning);
}

.settings-key-conflict.is-conflict
{
    color: var(--color-error);
}

.settings-key-chip
{
    display: flex;
    align-items: center;
    min-width: 32dp;
    padding: 0 var(--space-1);
    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
    color: var(--color-primary);
    font-size: 10dp;
    line-height: 24dp;
    letter-spacing: 1dp;
    text-align: center;
}

.settings-key-remove
{
    margin-left: var(--space-1);
    width: 24dp;
    height: 24dp;
    padding: 0;
    line-height: 20dp;
    font-size: 14dp;
    letter-spacing: 0;
    color: var(--color-disabled);
}

.settings-key-remove:hover,
.settings-key-remove:focus-visible
{
    color: var(--color-text);
}

.settings-key-removal
{
    width: 100%;
    margin-top: var(--space-2);
    color: var(--color-warning);
    font-size: 12dp;
}

.settings-key-unbound
{
    display: block;
    color: var(--color-disabled);
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-footer
{
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 40dp;
    padding: 0 var(--space-3);
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-surface-2);
    border-top-width: 1dp;
    border-top-color: var(--color-border);
    color: var(--color-disabled);
    font-size: 10dp;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.settings-footer-help
{
    color: var(--color-text-muted);
}

.settings-footer-status
{
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-success);
}

@media (max-width: 1400dp)
{
    .settings-navigation
    {
        flex-basis: 264dp;
        padding: var(--space-2);
    }

    .settings-stage
    {
        padding: var(--space-3);
    }
}

@media (max-height: 900dp)
{
    .settings-scope-note
    {
        display: none;
    }
}

@media (max-width: 900dp)
{
    .settings-screen
    {
        padding: var(--space-2);
    }

    .settings-header
    {
        height: 64dp;
        padding: 0 var(--space-2);
    }

    .settings-navigation
    {
        flex-basis: 232dp;
        padding: var(--space-2);
    }

    .settings-stage
    {
        padding: var(--space-2);
    }

    .settings-nav-item
    {
        font-size: 12dp;
        white-space: nowrap;
    }
}

@media (max-height: 760dp)
{
    .settings-screen
    {
        padding: var(--space-2);
    }

    .settings-stage
    {
        padding: var(--space-3);
    }

    .settings-header
    {
        height: 64dp;
    }

    .settings-navigation-label
    {
        margin-bottom: var(--space-1);
    }

    .settings-nav-list
    {
        gap: 2dp;
    }

    .settings-nav-item
    {
        height: 36dp;
        line-height: 34dp;
    }

    .settings-stage-header
    {
        padding-bottom: var(--space-2);
    }

    .settings-stage-title
    {
        font-size: 32dp;
        line-height: 40dp;
    }

    .settings-stage-copy
    {
        margin-top: 0;
        line-height: 18dp;
    }

    .settings-section
    {
        margin-top: var(--space-2);
        padding: var(--space-2);
    }

    .settings-display-row
    {
        min-height: 48dp;
    }

    .settings-display-section .settings-control-footer
    {
        margin-top: var(--space-1);
        padding-top: var(--space-1);
    }

    .settings-mode-selector
    {
        margin-top: var(--space-2);
    }

    .settings-performance-section
    {
        margin-top: var(--space-2);
    }

    .settings-antialiasing-section
    {
        margin-top: var(--space-2);
    }

    .settings-antialiasing-selector
    {
        margin-top: var(--space-2);
    }

    .settings-resolution-section
    {
        margin-top: var(--space-2);
    }

    .settings-audio-section
    {
        margin-top: var(--space-2);
    }

    .settings-soundpack-grid
    {
        margin-top: var(--space-2);
    }

    .settings-input-section
    {
        margin-top: var(--space-2);
    }

    .settings-resolution-grid
    {
        margin-top: var(--space-2);
        gap: 4dp;
    }

    .settings-resolution-button
    {
        height: 32dp;
        line-height: 30dp;
    }

    .settings-footer
    {
        height: 36dp;
        line-height: 34dp;
    }
}
