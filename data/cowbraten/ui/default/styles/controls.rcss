.button
{
    box-sizing: border-box;
    display: inline-block;
    height: 40dp;
    padding: 0 var(--space-2);

    background-color: var(--color-surface-2);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-control);

    color: var(--color-text);
    font-family: var(--font-interface);
    font-size: 0.8125rem;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
    tab-index: auto;
}

.button:hover,
.button:focus-visible
{
    border-width: 2dp;
    border-color: var(--color-primary);
}

.button:active
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary-hover);
}

.button-primary
{
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-background);
}

.button-primary:hover,
.button-primary:focus-visible
{
    background-color: var(--color-primary-hover);
    border-color: var(--color-text);
}

.button-secondary
{
    border-color: var(--color-secondary);
    color: var(--color-secondary);
}

.button-secondary:hover,
.button-secondary:focus-visible
{
    background-color: var(--color-secondary);
    border-color: var(--color-secondary-hover);
    color: var(--color-background);
}

.button-secondary:active
{
    background-color: var(--color-secondary-pressed);
}

.button-destructive
{
    border-color: var(--color-error);
    color: var(--color-error);
}

.button-destructive:hover,
.button-destructive:focus-visible
{
    background-color: var(--color-error);
    border-color: var(--color-error-hover);
    color: var(--color-text);
}

.button-destructive:active
{
    background-color: var(--color-error-pressed);
}

.button:disabled
{
    background-color: var(--color-surface-2);
    border-color: var(--color-disabled);
    color: var(--color-disabled);
    opacity: 0.78;
    cursor: unavailable;
}

.button.is-selected
{
    background-color: var(--color-primary-pressed);
    border-color: var(--color-primary-hover);
    color: var(--color-text);
}

.button .cb-ico
{
    margin-right: 7dp;
    image-color: var(--color-text);
}

.button:hover .cb-ico,
.button:focus-visible .cb-ico
{
    image-color: var(--color-primary-hover);
}

.button-primary .cb-ico,
.button-primary:hover .cb-ico,
.button-primary:focus-visible .cb-ico
{
    image-color: var(--color-background);
}

.button-secondary .cb-ico
{
    image-color: var(--color-secondary);
}

.button-destructive .cb-ico
{
    image-color: var(--color-error);
}

.button-destructive:hover .cb-ico,
.button-destructive:focus-visible .cb-ico
{
    image-color: var(--color-text);
}

.button:disabled .cb-ico,
.button.is-disabled .cb-ico
{
    image-color: var(--color-disabled);
}

.text-input
{
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 40dp;
    padding: 0 var(--space-2);

    background-color: var(--color-background);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-control);
    caret-color: var(--color-primary);

    color: var(--color-text);
    font-family: var(--font-interface);
    font-size: 0.875rem;
    line-height: 38dp;
    tab-index: auto;
}

.text-input:hover
{
    border-color: var(--color-disabled);
}

.text-input:focus,
.text-input:focus-visible
{
    border-width: 2dp;
    border-color: var(--color-primary);
}

.text-input:placeholder-shown
{
    color: var(--color-disabled);
}

.checkbox-row
{
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-1);
    height: 32dp;
    color: var(--color-text-muted);
    font-size: 0.875rem;
}

input.checkbox
{
    box-sizing: border-box;
    width: 18dp;
    height: 18dp;
    margin: 0;
    background-color: var(--color-background);
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-control);
    tab-index: auto;
}

input.checkbox:hover,
input.checkbox:focus-visible
{
    border-width: 2dp;
    border-color: var(--color-primary);
}

input.checkbox:active
{
    background-color: var(--color-primary-pressed);
}

input.checkbox:checked
{
    background-color: var(--color-primary);
    border-color: var(--color-primary-hover);
}

input.checkbox:disabled
{
    background-color: var(--color-surface-2);
    border-color: var(--color-disabled);
    opacity: 0.78;
}

.tab-bar
{
    display: flex;
    flex-direction: row;
    padding: 0 var(--space-3);
    background-color: var(--color-background);
    border-bottom-width: 1dp;
    border-bottom-color: var(--color-border);
}

.tab
{
    box-sizing: border-box;
    height: 40dp;
    padding: 0 var(--space-2);
    background-color: transparent;
    border-width: 0 0 2dp 0;
    border-color: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-interface);
    font-size: 0.75rem;
    line-height: 38dp;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
    tab-index: auto;
}

.tab:hover,
.tab:focus-visible
{
    background-color: var(--color-surface-2);
    color: var(--color-text);
}

.tab:active
{
    background-color: var(--color-primary-pressed);
}

.tab.is-selected
{
    border-bottom-color: var(--color-primary);
    color: var(--color-primary);
}

.tab:disabled
{
    color: var(--color-disabled);
    opacity: 0.78;
}

.nav-list
{
    display: flex;
    flex-direction: column;
    gap: 0;
}

.nav-item
{
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 40dp;
    padding: 0 var(--space-2);
    background-color: transparent;
    border-width: 0 0 0 3dp;
    border-color: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-interface);
    font-size: 0.8125rem;
    line-height: 40dp;
    letter-spacing: 1dp;
    text-align: left;
    text-transform: uppercase;
    tab-index: auto;
}

.nav-item:hover,
.nav-item:focus-visible
{
    background-color: var(--color-surface-2);
    color: var(--color-text);
}

.nav-item:active
{
    background-color: var(--color-primary-pressed);
}

.nav-item.is-selected
{
    background-color: var(--color-surface-2);
    border-left-color: var(--color-primary);
    color: var(--color-primary);
}

.nav-item:disabled
{
    background-color: transparent;
    color: var(--color-disabled);
    opacity: 0.78;
}
