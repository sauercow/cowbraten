/* Presentation of P1x's existing fragmessage queue. Position, size,
   stack direction and fade are controlled from the original HUD settings. */
body {
    font-family: Lato;
    font-size: 18px;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    pointer-events: none;
}
.cow-frag-root {
    position: absolute;
    left: 0;
    top: 25%;
    width: 100%;
    height: 0;
    font-size: 18px;
    pointer-events: none;
}
/* Each visible row spans the root and centers its own compact card.
   No translate(-50%) dependency; the C++ bridge anchors the root center
   to the configured hudfragmessagex value. */
.cow-frag-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0;
    display: none;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    pointer-events: none;
}
.cow-frag-line, .cow-frag-milestone {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 2.35em;
    margin-top: -1.175em;
    min-width: 12.8em;
    max-width: 40em;
    padding: 0 0.55em;
    background-color: #101A28E8;
    color: #E9F3FF;
    border: 1px #2779A6;
    border-radius: 0.44em;
    white-space: nowrap;
    pointer-events: none;
}
.cow-frag-source, .cow-frag-target, .cow-frag-combo {
    padding: 0 0.65em;
    font-size: 1.08em;
    font-weight: bold;
    white-space: nowrap;
}
.cow-frag-source {
    color: #86DAFF;
    border-left: 0.15em #17B7F8;
}
.cow-frag-target {
    color: #FFFFFF;
    border-right: 0.15em #309CE4;
}
.cow-frag-source.cow-tone-enemy, .cow-frag-target.cow-tone-enemy {
    color: #FF626F;
    border-color: #E9384F;
}
.cow-frag-source.cow-tone-self, .cow-frag-target.cow-tone-self {
    color: #8CE2FF;
    border-color: #2CC4FF;
}
.cow-frag-source.cow-tone-ally, .cow-frag-target.cow-tone-ally {
    color: #B8F9A1;
    border-color: #65C761;
}
.cow-frag-source.cow-tone-neutral, .cow-frag-target.cow-tone-neutral {
    color: #F3F7FF;
    border-color: #69798A;
}
.cow-frag-combo {
    color: #FFCC62;
    background-color: transparent;
    border: 0;
    padding: 0 0.55em 0 0.2em;
    margin: 0;
    font-size: 1.08em;
}
.cow-frag-weapon {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 0.65em;
    height: 100%;
    border-left: 1px #45637E;
    border-right: 1px #45637E;
    color: #CDDFEF;
    font-size: 0.9em;
    white-space: nowrap;
}
/* The icon atlas assets are 128x80 (1.6:1); never force them square. */
.cow-frag-weapon-icon {
    display: inline-block;
    width: 3.0em;
    height: 1.875em;
    flex-shrink: 0;
}
.cow-frag-milestone {
    min-width: 14.7em;
    border-color: #F5A623;
    background-color: #302414EF;
    color: #FFD16B;
    font-size: 1em;
    letter-spacing: 0.045em;
}
/* Achievement replaces the frag weapon icon on milestone notifications. */
.cow-frag-streak-icon {
    display: inline-block;
    width: 2.65em;
    height: 1.65625em;
    margin-right: 0.30em;
    flex-shrink: 0;
}
