<template name="app-shell" content="app-content">
<head>
    <link type="text/rcss" href="../icons/icons.rcss" />
    <link type="text/rcss" href="../styles/app_shell.rcss" />
</head>
<body>
    <div class="app-shell">
        <div class="app-header">
            <div class="app-lockup">
                <div class="app-mark">C</div>
                <div class="app-lockup-copy">
                    <div class="app-product">Cowbraten</div>
                    <div class="app-product-subtitle">Native Cube 2 client</div>
                </div>
            </div>
            <button class="button app-return" onclick="navigation.back">
                <span class="cb-ico cb-ico-arrow-left cb-ico--sm"></span>Esc&nbsp;&nbsp;/&nbsp;&nbsp;Back
            </button>
        </div>

        <div class="app-frame">
            <div class="app-sidebar">
                <div class="app-navigation-label">Navigation</div>
                <div class="nav-list app-navigation">
                    <button class="nav-item app-nav-item app-nav-games" onclick="navigation.games">
                        <span class="cb-ico cb-ico-gamepad cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Play</span>
                    </button>
                    <button class="nav-item app-nav-item app-nav-profile" onclick="navigation.profile">
                        <span class="cb-ico cb-ico-user cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Profile / Identity</span>
                    </button>
                    <button class="nav-item app-nav-item app-nav-servers" onclick="navigation.servers">
                        <span class="cb-ico cb-ico-server cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Servers</span>
                    </button>
                    <button class="nav-item app-nav-item app-nav-demos" onclick="navigation.demos">
                        <span class="cb-ico cb-ico-film cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Demos</span>
                    </button>
                    <button class="nav-item app-nav-item app-nav-settings" onclick="navigation.settings">
                        <span class="cb-ico cb-ico-settings cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Settings</span>
                    </button>
                </div>

                <div class="app-sidebar-spacer"></div>

                <div class="app-navigation app-navigation-utility">
                    <button class="nav-item app-nav-item" onclick="navigation.close">
                        <span class="cb-ico cb-ico-play cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Return to Game</span>
                    </button>
                    <button class="nav-item app-nav-item app-nav-exit" onclick="navigation.exit">
                        <span class="cb-ico cb-ico-power cb-ico--md app-nav-icon"></span>
                        <span class="app-nav-label">Exit</span>
                    </button>
                </div>
            </div>

            <div id="app-content" class="app-content"></div>
        </div>

        <div class="app-footer">
            <div>Cowbraten</div>
            <div>Escape returns to the previous menu</div>
            <div class="app-footer-status"><span></span> Interface active</div>
        </div>
    </div>
</body>
</template>
