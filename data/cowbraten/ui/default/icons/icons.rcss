/* Cowbraten Icons v1 - RmlUi RCSS */
/* Include this RCSS in the same document that uses the icons. */
/* Reference sprites by the names cb-play, cb-eye, etc. */

@spritesheet cowbraten-icons-1x {
  src: atlas/cowbraten-icons-24.png;
  resolution: 1x;
  cb-play: 0px 0px 24px 24px;
