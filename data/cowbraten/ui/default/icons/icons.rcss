/* Base: span/icon element with transparent canvas */
.cb-ico { display: inline-block; width: 24dp; height: 24dp; vertical-align: middle; image-color: #F5F6F8; }
.cb-ico--sm { width: 16dp; height: 16dp; }
.cb-ico--md { width: 20dp; height: 20dp; }
.cb-ico--lg { width: 32dp; height: 32dp; }
.cb-ico--xl { width: 48dp; height: 48dp; }
.cb-ico--white { image-color: #F5F6F8; }
.cb-ico--muted { image-color: #A2A9B4; }
.cb-ico--blue { image-color: #54ABFF; }
.cb-ico--orange { image-color: #FF8A34; }
.cb-ico--green { image-color: #3FCB79; }
.cb-ico--red { image-color: #ED5555; }
.cb-ico--disabled { image-color: #59616D; opacity: 0.65; }

/* Per-icon sprite decorators */
.cb-ico-play { decorator: image(cb-play contain); }
.cb-ico-pause { decorator: image(cb-pause contain); }
.cb-ico-stop { decorator: image(cb-stop contain); }
.cb-ico-play-circle { decorator: image(cb-play-circle contain); }
.cb-ico-pause-circle { decorator: image(cb-pause-circle contain); }
.cb-ico-skip-forward { decorator: image(cb-skip-forward contain); }
.cb-ico-skip-back { decorator: image(cb-skip-back contain); }
.cb-ico-fast-forward { decorator: image(cb-fast-forward contain); }
.cb-ico-rewind { decorator: image(cb-rewind contain); }
.cb-ico-record { decorator: image(cb-record contain); }
.cb-ico-repeat { decorator: image(cb-repeat contain); }
.cb-ico-repeat-one { decorator: image(cb-repeat-one contain); }
.cb-ico-shuffle { decorator: image(cb-shuffle contain); }
