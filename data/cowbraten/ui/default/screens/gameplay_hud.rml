<rml>
<head>
  <title>Gameplay status HUD</title>
  <link type="text/rcss" href="../styles/gameplay_hud.rcss" />
</head>
<body>
  <div id="cow-status-root" class="cow-status-root">
    <div class="cow-status-dock">
      <div id="cow-status-health" class="cow-status-card cow-status-health">
        <img class="cow-status-icon" src="../images/hud/v1/health.png" />
        <div class="cow-status-metrics">
          <span id="cow-status-health-value" class="cow-status-value">100</span>
          <span id="cow-status-health-max" class="cow-status-max"></span>
          <span class="cow-status-label">HEALTH</span>
        </div>
      </div>
      <div id="cow-status-armour" class="cow-status-card cow-status-armour">
        <img class="cow-status-icon" src="../images/hud/v1/armor_compact.png" />
        <div class="cow-status-metrics">
          <span id="cow-status-armour-value" class="cow-status-value">0</span>
          <span class="cow-status-label">ARMOR</span>
        </div>
      </div>
      <div class="cow-status-ammo-wrap">
        <div id="cow-status-secondary-cycle" class="cow-status-secondary cow-status-secondary-cycle">
          <img id="cow-status-cycle-0" /><img id="cow-status-cycle-1" />
          <img id="cow-status-cycle-2" /><img id="cow-status-cycle-3" />
          <img id="cow-status-cycle-4" /><img id="cow-status-cycle-5" />
        </div>
        <div id="cow-status-secondary-down" class="cow-status-secondary cow-status-secondary-down">
          <img id="cow-status-down-0" /><img id="cow-status-down-1" />
          <img id="cow-status-down-2" />
        </div>
        <div id="cow-status-ammo" class="cow-status-card cow-status-ammo">
          <img id="cow-status-gun-0" class="cow-status-icon" src="../images/hud/v1/fist.png" />
          <img id="cow-status-gun-1" class="cow-status-icon" src="../images/hud/v1/shotgun.png" />
          <img id="cow-status-gun-2" class="cow-status-icon" src="../images/hud/v1/chaingun.png" />
          <img id="cow-status-gun-3" class="cow-status-icon" src="../images/hud/v1/rocket_launcher.png" />
          <img id="cow-status-gun-4" class="cow-status-icon" src="../images/hud/v1/rifle.png" />
          <img id="cow-status-gun-5" class="cow-status-icon" src="../images/hud/v1/grenade_launcher.png" />
          <img id="cow-status-gun-6" class="cow-status-icon" src="../images/hud/v1/pistol.png" />
          <img id="cow-status-gun-7" class="cow-status-icon" src="../images/hud/v1/unknown.png" />
          <div class="cow-status-metrics">
            <span id="cow-status-ammo-value" class="cow-status-value">0</span>
            <span class="cow-status-label">AMMO</span>
          </div>
        </div>
        <div id="cow-status-secondary-up" class="cow-status-secondary cow-status-secondary-up">
          <img id="cow-status-up-0" /><img id="cow-status-up-1" />
          <img id="cow-status-up-2" />
        </div>
      </div>
      <div id="cow-status-quad" class="cow-status-quad">
        <img class="cow-status-icon" src="../images/hud/v1/quad.png" />
      </div>
    </div>
  </div>
  <div id="cow-ammo-bar-root" class="cow-ammo-bar-root">
    <div id="cow-ammo-bar-item-0" class="cow-ammo-bar-item"><img src="../images/hud/v1/shotgun.png" /><span id="cow-ammo-bar-count-0">0</span></div>
    <div id="cow-ammo-bar-item-1" class="cow-ammo-bar-item"><img src="../images/hud/v1/chaingun.png" /><span id="cow-ammo-bar-count-1">0</span></div>
    <div id="cow-ammo-bar-item-2" class="cow-ammo-bar-item"><img src="../images/hud/v1/rocket_launcher.png" /><span id="cow-ammo-bar-count-2">0</span></div>
    <div id="cow-ammo-bar-item-3" class="cow-ammo-bar-item"><img src="../images/hud/v1/rifle.png" /><span id="cow-ammo-bar-count-3">0</span></div>
    <div id="cow-ammo-bar-item-4" class="cow-ammo-bar-item"><img src="../images/hud/v1/grenade_launcher.png" /><span id="cow-ammo-bar-count-4">0</span></div>
    <div id="cow-ammo-bar-item-5" class="cow-ammo-bar-item"><img src="../images/hud/v1/pistol.png" /><span id="cow-ammo-bar-count-5">0</span></div>
  </div>
  <div id="cow-demo-recording" class="cow-demo-recording">REC</div>
</body>
</rml>
