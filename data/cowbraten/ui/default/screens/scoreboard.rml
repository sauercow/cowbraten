<rml>
<head>
    <title>Scoreboard</title>
    <link type="text/rcss" href="../styles/base.rcss" />
    <link type="text/rcss" href="../icons/icons.rcss" />
    <link type="text/rcss" href="../styles/scoreboard.rcss" />
</head>
<body data-model="live_scoreboard">
    <div class="scoreboard-overlay">
        <div class="scoreboard-panel">
            <div class="scoreboard-header">
                <div class="scoreboard-identity">
                    <div class="scoreboard-kicker">Match&nbsp;&nbsp;/&nbsp;&nbsp;Scoreboard</div>
                    <div class="scoreboard-server">{{ server_name }}</div>
                    <div class="scoreboard-match">{{ match_line }}</div>
                </div>
                <div class="scoreboard-time">
                    <span class="cb-ico cb-ico-clock cb-ico--blue"></span>
                    <strong>{{ time_text }}</strong>
                </div>
                <div class="scoreboard-header-rule"><span></span></div>
            </div>

            <div id="scoreboard-scroll" class="scoreboard-scroll">
                <div class="scoreboard-columns scoreboard-row" data-if="!team_mode">
                    <span class="score-name score-column-name"><i class="cb-ico cb-ico-user cb-ico--md"></i><strong>Player</strong></span>
                    <span class="score-stat score-column" data-if="show_flags"><i class="cb-ico cb-ico-flag cb-ico--sm"></i><b>Flags</b></span>
                    <span class="score-stat score-column score-frags" data-if="show_frags"><i class="cb-ico cb-ico-crosshair cb-ico--sm"></i><b>Frags</b></span>
                    <span class="score-stat score-column score-deaths" data-if="show_deaths"><i class="cb-ico cb-ico-skull cb-ico--sm"></i><b>Deaths</b></span>
                    <span class="score-stat score-column" data-if="show_suicides"><i class="cb-ico cb-ico-ghost cb-ico--sm"></i><b>Suis</b></span>
                    <span class="score-stat score-column" data-if="show_kpd"><i class="cb-ico cb-ico-activity cb-ico--sm"></i><b>KPD</b></span>
                    <span class="score-stat score-column" data-if="show_accuracy"><i class="cb-ico cb-ico-target cb-ico--sm"></i><b>Acc</b></span>
                    <span class="score-stat score-column" data-if="show_damage"><i class="cb-ico cb-ico-zap cb-ico--sm"></i><b>Dmg</b></span>
                    <span class="score-stat score-column" data-if="show_damage_received"><i class="cb-ico cb-ico-shield cb-ico--sm"></i><b>DR</b></span>
                    <span class="score-stat score-column" data-if="show_ping"><i class="cb-ico cb-ico-signal cb-ico--sm"></i><b>Ping</b></span>
                    <span class="score-stat score-column" data-if="show_pj"><i class="cb-ico cb-ico-activity cb-ico--sm"></i><b>PJ</b></span>
                    <span class="score-stat score-column score-cn" data-if="show_client_num"><i class="cb-ico cb-ico-network cb-ico--sm"></i><b>CN</b></span>
                </div>
                <div class="scoreboard-repeat" data-for="player : rows">
                    <div class="scoreboard-group" data-if="player.group_first"
                        data-class-is-good-team="player.good_team"
                        data-class-is-evil-team="player.evil_team">{{ player.group_title }}</div>
                    <div class="scoreboard-row scoreboard-player"
                        data-class-is-local="player.local"
                        data-class-is-spectator="player.spectator"
                        data-class-is-dead="player.dead"
                        data-class-is-good-team="player.good_team"
                        data-class-is-evil-team="player.evil_team">
                        <span class="score-name">
                            <i class="score-player-icon cb-ico cb-ico-user-round cb-ico--lg"></i>
                            <i class="score-local-dot" data-if="player.local"></i>
                            <strong>{{ player.name }}</strong>
                            <small data-if="player.role != ''">{{ player.role }}</small>
                        </span>
                        <span class="score-stat" data-if="show_flags">{{ player.flags }}</span>
                        <span class="score-stat score-frags" data-if="show_frags">{{ player.frags }}</span>
                        <span class="score-stat score-deaths" data-if="show_deaths">{{ player.deaths }}</span>
                        <span class="score-stat" data-if="show_suicides">{{ player.suicides }}</span>
                        <span class="score-stat" data-if="show_kpd">{{ player.kpd }}</span>
                        <span class="score-stat" data-if="show_accuracy">{{ player.accuracy }}</span>
                        <span class="score-stat" data-if="show_damage">{{ player.damage }}</span>
                        <span class="score-stat" data-if="show_damage_received">{{ player.damage_received }}</span>
                        <span class="score-stat" data-if="show_ping">{{ player.ping }}</span>
                        <span class="score-stat" data-if="show_pj">{{ player.pj }}</span>
                        <span class="score-stat score-cn" data-if="show_client_num">{{ player.client_num }}</span>
                    </div>
                </div>

                <div class="scoreboard-teams" data-if="team_mode">
                    <div class="scoreboard-team scoreboard-team-own">
                        <div class="scoreboard-group is-own-team">{{ left_team_title }}</div>
                        <div class="scoreboard-columns scoreboard-row">
                            <span class="score-name score-column-name"><i class="cb-ico cb-ico-user cb-ico--md"></i><strong>Player</strong></span>
                            <span class="score-stat score-column" data-if="show_flags"><i class="cb-ico cb-ico-flag cb-ico--sm"></i><b>Flags</b></span>
                            <span class="score-stat score-column score-frags" data-if="show_frags"><i class="cb-ico cb-ico-crosshair cb-ico--sm"></i><b>Frags</b></span>
                            <span class="score-stat score-column score-deaths" data-if="show_deaths"><i class="cb-ico cb-ico-skull cb-ico--sm"></i><b>Deaths</b></span>
                            <span class="score-stat score-column" data-if="show_suicides"><i class="cb-ico cb-ico-ghost cb-ico--sm"></i><b>Suis</b></span>
                            <span class="score-stat score-column" data-if="show_kpd"><i class="cb-ico cb-ico-activity cb-ico--sm"></i><b>KPD</b></span>
                            <span class="score-stat score-column" data-if="show_accuracy"><i class="cb-ico cb-ico-target cb-ico--sm"></i><b>Acc</b></span>
                            <span class="score-stat score-column" data-if="show_damage"><i class="cb-ico cb-ico-zap cb-ico--sm"></i><b>Dmg</b></span>
                            <span class="score-stat score-column" data-if="show_damage_received"><i class="cb-ico cb-ico-shield cb-ico--sm"></i><b>DR</b></span>
                            <span class="score-stat score-column" data-if="show_ping"><i class="cb-ico cb-ico-signal cb-ico--sm"></i><b>Ping</b></span>
                            <span class="score-stat score-column" data-if="show_pj"><i class="cb-ico cb-ico-activity cb-ico--sm"></i><b>PJ</b></span>
                            <span class="score-stat score-column score-cn" data-if="show_client_num"><i class="cb-ico cb-ico-network cb-ico--sm"></i><b>CN</b></span>
                        </div>
                        <div class="scoreboard-repeat" data-for="player : left_team_rows">
                            <div class="scoreboard-row scoreboard-player is-own-team"
                                data-class-is-local="player.local" data-class-is-dead="player.dead">
                                <span class="score-name"><i class="score-player-icon cb-ico cb-ico-user-round cb-ico--lg"></i><i class="score-local-dot" data-if="player.local"></i><strong>{{ player.name }}</strong><small data-if="player.role != ''">{{ player.role }}</small></span>
                                <span class="score-stat" data-if="show_flags">{{ player.flags }}</span>
                                <span class="score-stat score-frags" data-if="show_frags">{{ player.frags }}</span>
                                <span class="score-stat score-deaths" data-if="show_deaths">{{ player.deaths }}</span>
                                <span class="score-stat" data-if="show_suicides">{{ player.suicides }}</span>
                                <span class="score-stat" data-if="show_kpd">{{ player.kpd }}</span>
                                <span class="score-stat" data-if="show_accuracy">{{ player.accuracy }}</span>
                                <span class="score-stat" data-if="show_damage">{{ player.damage }}</span>
                                <span class="score-stat" data-if="show_damage_received">{{ player.damage_received }}</span>
                                <span class="score-stat" data-if="show_ping">{{ player.ping }}</span>
                                <span class="score-stat" data-if="show_pj">{{ player.pj }}</span>
                                <span class="score-stat score-cn" data-if="show_client_num">{{ player.client_num }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="scoreboard-team scoreboard-team-opponent">
                        <div class="scoreboard-group is-opponent-team">{{ right_team_title }}</div>
                        <div class="scoreboard-columns scoreboard-row">
                            <span class="score-name score-column-name"><i class="cb-ico cb-ico-user cb-ico--md"></i><strong>Player</strong></span>
                            <span class="score-stat score-column" data-if="show_flags"><i class="cb-ico cb-ico-flag cb-ico--sm"></i><b>Flags</b></span>
                            <span class="score-stat score-column score-frags" data-if="show_frags"><i class="cb-ico cb-ico-crosshair cb-ico--sm"></i><b>Frags</b></span>
                            <span class="score-stat score-column score-deaths" data-if="show_deaths"><i class="cb-ico cb-ico-skull cb-ico--sm"></i><b>Deaths</b></span>
                            <span class="score-stat score-column" data-if="show_suicides"><i class="cb-ico cb-ico-ghost cb-ico--sm"></i><b>Suis</b></span>
                            <span class="score-stat score-column" data-if="show_kpd"><i class="cb-ico cb-ico-activity cb-ico--sm"></i><b>KPD</b></span>
                            <span class="score-stat score-column" data-if="show_accuracy"><i class="cb-ico cb-ico-target cb-ico--sm"></i><b>Acc</b></span>
                            <span class="score-stat score-column" data-if="show_damage"><i class="cb-ico cb-ico-zap cb-ico--sm"></i><b>Dmg</b></span>
                            <span class="score-stat score-column" data-if="show_damage_received"><i class="cb-ico cb-ico-shield cb-ico--sm"></i><b>DR</b></span>
                            <span class="score-stat score-column" data-if="show_ping"><i class="cb-ico cb-ico-signal cb-ico--sm"></i><b>Ping</b></span>
                            <span class="score-stat score-column" data-if="show_pj"><i class="cb-ico cb-ico-activity cb-ico--sm"></i><b>PJ</b></span>
                            <span class="score-stat score-column score-cn" data-if="show_client_num"><i class="cb-ico cb-ico-network cb-ico--sm"></i><b>CN</b></span>
                        </div>
                        <div class="scoreboard-repeat" data-for="player : right_team_rows">
                            <div class="scoreboard-row scoreboard-player is-opponent-team"
                                data-class-is-local="player.local" data-class-is-dead="player.dead">
                                <span class="score-name"><i class="score-player-icon cb-ico cb-ico-user-round cb-ico--lg"></i><i class="score-local-dot" data-if="player.local"></i><strong>{{ player.name }}</strong><small data-if="player.role != ''">{{ player.role }}</small></span>
                                <span class="score-stat" data-if="show_flags">{{ player.flags }}</span>
                                <span class="score-stat score-frags" data-if="show_frags">{{ player.frags }}</span>
                                <span class="score-stat score-deaths" data-if="show_deaths">{{ player.deaths }}</span>
                                <span class="score-stat" data-if="show_suicides">{{ player.suicides }}</span>
                                <span class="score-stat" data-if="show_kpd">{{ player.kpd }}</span>
                                <span class="score-stat" data-if="show_accuracy">{{ player.accuracy }}</span>
                                <span class="score-stat" data-if="show_damage">{{ player.damage }}</span>
                                <span class="score-stat" data-if="show_damage_received">{{ player.damage_received }}</span>
                                <span class="score-stat" data-if="show_ping">{{ player.ping }}</span>
                                <span class="score-stat" data-if="show_pj">{{ player.pj }}</span>
                                <span class="score-stat score-cn" data-if="show_client_num">{{ player.client_num }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="scoreboard-spectators" data-if="has_spectators">
                    <div class="scoreboard-group">Spectators</div>
                    <div class="scoreboard-spectator-grid">
                        <div class="scoreboard-spectator" data-for="player : spectator_rows">
                            <i class="score-player-icon cb-ico cb-ico-user-round cb-ico--md"></i>
                            <strong>{{ player.name }}</strong>
                            <small>{{ player.client_num }}</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="scoreboard-footer">
                <span class="scoreboard-footer-hints">
                    <span class="scoreboard-footer-hint"><b>TAB</b><strong>Hold scoreboard key</strong></span>
                    <span class="scoreboard-footer-hint"><b>WHEEL</b><strong>Scroll players</strong></span>
                </span>
                <span class="scoreboard-footer-hint"><i class="cb-ico cb-ico-arrow-left cb-ico--md"></i><strong>Release to return</strong></span>
            </div>
        </div>
    </div>
</body>
</rml>
