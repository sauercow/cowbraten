<rml>
<head>
    <title>Frag feedback</title>
    <link type="text/rcss" href="../styles/frag_feedback.rcss" />
</head>
<body>
    <div id="cow-frag-root" class="cow-frag-root">
        <div id="cow-frag-row-0" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-0" class="cow-frag-source"></span>
                <span id="cow-frag-combo-0" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <i class="cb-ico cb-ico-crosshair cb-ico--md"></i>
                    <span id="cow-frag-weapon-0" class="cow-frag-weapon-text"></span>
                </span>
                <span id="cow-frag-target-0" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-1" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-1" class="cow-frag-source"></span>
                <span id="cow-frag-combo-1" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <i class="cb-ico cb-ico-crosshair cb-ico--md"></i>
                    <span id="cow-frag-weapon-1" class="cow-frag-weapon-text"></span>
                </span>
                <span id="cow-frag-target-1" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-2" class="cow-frag-anchor">
            <div class="cow-frag-line">
