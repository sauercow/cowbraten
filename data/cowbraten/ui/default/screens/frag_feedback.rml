                <span id="cow-frag-source-4" class="cow-frag-source"></span>
                <span id="cow-frag-combo-4" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <i class="cb-ico cb-ico-crosshair cb-ico--md"></i>
                    <span id="cow-frag-weapon-4" class="cow-frag-weapon-text"></span>
                </span>
                <span id="cow-frag-target-4" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-5" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-5" class="cow-frag-source"></span>
                <span id="cow-frag-combo-5" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <i class="cb-ico cb-ico-crosshair cb-ico--md"></i>
                    <span id="cow-frag-weapon-5" class="cow-frag-weapon-text"></span>
                </span>
                <span id="cow-frag-target-5" class="cow-frag-target"></span>
