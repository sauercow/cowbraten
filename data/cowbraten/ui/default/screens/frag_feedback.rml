                </span>
                <span id="cow-frag-target-6" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-7" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-7" class="cow-frag-source"></span>
                <span id="cow-frag-combo-7" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <img id="cow-frag-weapon-icon-7" class="cow-frag-weapon-icon"
