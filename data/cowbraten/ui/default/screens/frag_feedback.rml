                <span class="cow-frag-weapon">
                    <img id="cow-frag-weapon-icon-2" class="cow-frag-weapon-icon"
                         src="../images/hud/v1/unknown.png" />
                </span>
                <span id="cow-frag-target-2" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-3" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-3" class="cow-frag-source"></span>
                <span id="cow-frag-combo-3" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <img id="cow-frag-weapon-icon-3" class="cow-frag-weapon-icon"
                         src="../images/hud/v1/unknown.png" />
                </span>
                <span id="cow-frag-target-3" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-4" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-4" class="cow-frag-source"></span>
