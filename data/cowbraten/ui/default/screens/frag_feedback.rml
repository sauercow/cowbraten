                <span id="cow-frag-source-8" class="cow-frag-source"></span>
                <span id="cow-frag-combo-8" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <i class="cb-ico cb-ico-crosshair cb-ico--md"></i>
                    <span id="cow-frag-weapon-8" class="cow-frag-weapon-text"></span>
                </span>
                <span id="cow-frag-target-8" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-row-9" class="cow-frag-anchor">
            <div class="cow-frag-line">
                <span id="cow-frag-source-9" class="cow-frag-source"></span>
                <span id="cow-frag-combo-9" class="cow-frag-combo"></span>
                <span class="cow-frag-weapon">
                    <i class="cb-ico cb-ico-crosshair cb-ico--md"></i>
                    <span id="cow-frag-weapon-9" class="cow-frag-weapon-text"></span>
                </span>
                <span id="cow-frag-target-9" class="cow-frag-target"></span>
            </div>
        </div>
        <div id="cow-frag-milestone" class="cow-frag-anchor">
            <div class="cow-frag-milestone">
                <span class="cow-frag-laurel">&#9733;</span>
                <strong id="cow-frag-milestone-text"></strong>
                <span class="cow-frag-laurel">&#9733;</span>
            </div>
        </div>
    </div>
</body>
</rml>
