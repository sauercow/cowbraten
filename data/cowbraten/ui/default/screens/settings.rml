                                        data-class-is-selected="frag_message_stack_auto"
                                        data-event-click="select_frag_message_stack_dir(0)">Auto</button>
                                    <button class="button settings-antialiasing-button"
                                        data-class-is-selected="frag_message_stack_down"
                                        data-event-click="select_frag_message_stack_dir(1)">Down</button>
                                </div>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Streak Milestone Scale</div>
                                    <div class="settings-control-description">
                                        Additional size multiplier for Cowbraten's 5, 10, 15, 20, and 25 kill milestone messages.
                                    </div>
                                </div>
                                <div class="settings-stepper">
                                    <button class="button settings-stepper-button"
                                        onclick="settings.hud.streak-scale.decrease">-</button>
                                    <input class="text-input settings-stepper-value"
                                        type="text" maxlength="8"
                                        data-value="streak_milestone_scale_input"
                                        data-class-is-invalid="streak_milestone_scale_invalid"
                                        onfocus="settings.hud.streak-scale.focus"
                                        onblur="settings.hud.streak-scale.blur"
                                        onkeyup="settings.hud.streak-scale.commit" />
                                    <button class="button settings-stepper-button"
                                        onclick="settings.hud.streak-scale.increase">+</button>
                                </div>
                            </div>
                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>Range&nbsp;&nbsp;{{ streak_milestone_scale_minimum }} - {{ streak_milestone_scale_maximum }}&nbsp;&nbsp;//&nbsp;&nbsp;{{ hud_status }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="settings-page" data-if="category_graphics">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">System / Display</div>
                            <div class="settings-stage-title">Graphics</div>
                            <div class="settings-stage-copy">
                                Adjust display, performance and visual quality settings.
                            </div>
                        </div>

                        <div id="settings-display-presets"
                            class="settings-section settings-compact-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Autoexec Display Presets</div>
                                    <div class="settings-control-description">
                                        Presets declared as <code>ss_*</code> aliases remain engine-owned and can be launched here without exposing script evaluation to RML.
                                    </div>
                                </div>
                            </div>
                            <div class="settings-mode-selector">
                                <button class="button settings-mode-button settings-display-preset-button"
                                    data-for="preset : display_presets"
                                    data-event-click="run_display_preset(preset.id)">{{ preset.label }}</button>
                            </div>
                            <div class="settings-control-description"
                                data-if="display_presets.size == 0">
                                No <code>ss_*</code> display aliases are loaded.
                            </div>
                            <div class="settings-control-footer"
                                data-if="display_preset_status != ''">
                                <span class="settings-live-indicator"></span>
                                <span>{{ display_preset_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-display-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Presentation Mode</div>
                                    <div class="settings-control-description">
                                        Choose a resizable window, exclusive display mode, or borderless desktop fullscreen.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-mode-current">
                                    <span class="settings-info-label">Actual mode</span>
                                    <span class="settings-resolution-current-value">{{ presentation_label }}</span>
                                </div>
                            </div>

                            <div class="settings-mode-selector">
                                <button class="button settings-mode-button"
                                    data-class-is-selected="presentation_windowed"
                                    onclick="settings.presentation.windowed">
                                    Windowed
                                </button>
                                <button class="button settings-mode-button"
                                    data-class-is-selected="presentation_exclusive"
                                    onclick="settings.presentation.exclusive">
                                    Exclusive
                                </button>
                                <button class="button settings-mode-button"
                                    data-class-is-selected="presentation_desktop"
                                    onclick="settings.presentation.desktop">
                                    Desktop / Borderless
                                </button>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ video_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-performance-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Vertical Synchronization</div>
                                    <div class="settings-control-description">
                                        Synchronize frame presentation with the display. The active result is shown after the change.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox"
                                        type="checkbox"
                                        data-attrif-checked="vsync"
                                        onclick="settings.vsync" />
                                    <span data-if="vsync_adaptive">Adaptive</span>
                                    <span data-if="vsync &amp;&amp; !vsync_adaptive">Enabled</span>
                                    <span data-if="!vsync">Disabled</span>
                                </label>
                            </div>

                            <div class="settings-control-footer settings-control-footer-compact">
                                <span class="settings-live-indicator"></span>
                                <span>{{ vsync_status }}</span>
                            </div>

                            <div class="settings-control-heading settings-fps-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Frame Rate Limit</div>
                                    <div class="settings-control-description">
                                        Cap rendered frames without reducing Cowbraten's input or network processing frequency. Zero is unlimited.
                                    </div>
                                </div>
                                <div class="settings-value settings-fps-value">
                                    <span class="settings-fps-value-label">{{ fps_limit_label }}</span>
                                </div>
                            </div>

                            <div class="settings-range-row settings-fps-range-row">
                                <span class="settings-range-bound">0</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="1000"
                                    step="1"
                                    data-attr-min="fps_limit_minimum"
                                    data-attr-max="fps_limit_maximum"
                                    data-attr-value="fps_limit"
                                    onchange="settings.fps-limit" />
                                <span class="settings-range-bound settings-range-maximum">1000</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Gamma</div>
                                    <div class="settings-control-description">
                                        Adjust display brightness. 100 is the default; the active value is shown after the change.
                                    </div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ gamma_label }}</span>
                                </div>
                            </div>

                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ gamma_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="30"
                                    max="300"
                                    step="1"
                                    data-attr-min="gamma_minimum"
                                    data-attr-max="gamma_maximum"
                                    data-attr-value="gamma"
                                    onchange="settings.gamma" />
                                <span class="settings-range-bound settings-range-maximum">{{ gamma_maximum }}</span>
                            </div>

                            <div class="settings-control-footer settings-control-footer-compact">
                                <span class="settings-live-indicator"></span>
                                <span>{{ gamma_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Multisample Anti-Aliasing (MSAA)</div>
                                    <div class="settings-control-description">
                                        Smooth scene edges. Changing this option restarts the graphics renderer.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Active value</span>
                                    <span class="settings-resolution-current-value">{{ antialiasing_label }}</span>
                                </div>
                            </div>

                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="antialiasing_off"
                                    data-event-click="select_antialiasing(0)">Off</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="antialiasing_2x"
                                    data-event-click="select_antialiasing(2)">2x</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="antialiasing_4x"
                                    data-event-click="select_antialiasing(4)">4x</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="antialiasing_8x"
                                    data-event-click="select_antialiasing(8)">8x</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="antialiasing_16x"
                                    data-event-click="select_antialiasing(16)">16x</button>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ antialiasing_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Depth Buffer</div>
                                    <div class="settings-control-description">
                                        Set depth precision. Default uses 24 bits. Changing this option restarts the graphics renderer.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Active value</span>
                                    <span class="settings-resolution-current-value">{{ depth_buffer_label }}</span>
                                </div>
                            </div>

                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="depth_buffer_default"
                                    data-event-click="select_depth_buffer(0)">Default</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="depth_buffer_16"
                                    data-event-click="select_depth_buffer(16)">16-bit</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="depth_buffer_24"
                                    data-event-click="select_depth_buffer(24)">24-bit</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="depth_buffer_32"
                                    data-event-click="select_depth_buffer(32)">32-bit</button>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ depth_buffer_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Shadow Maps</div>
                                    <div class="settings-control-description">
                                        Render detailed dynamic model shadows at a higher GPU cost.
                                    </div>
                                    <div class="settings-control-description"
                                        data-if="shadow_state_available &amp;&amp; !shadow_maps_available">
                                        Unavailable with the current renderer.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="shadow_maps"
                                        data-attrif-disabled="!shadow_state_available || (!shadow_maps_available &amp;&amp; !shadow_maps)"
                                        data-event-change="select_shadow_maps(ev.checked)" />
                                    <span data-if="shadow_maps">On</span>
                                    <span data-if="!shadow_maps">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Shadow Map Quality</div>
                                    <div class="settings-control-description">
                                        Controls shadow detail and edge smoothing.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ shadow_quality_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="shadow_quality_selected == 0"
                                    data-attrif-disabled="!shadow_quality_available"
                                    data-event-click="select_shadow_quality(0)">Medium</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="shadow_quality_selected == 1"
                                    data-attrif-disabled="!shadow_quality_available"
                                    data-event-click="select_shadow_quality(1)">High</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="(shadow_state_available &amp;&amp; !shadow_maps &amp;&amp; shadow_quality_available) || shadow_quality_status != ''">
                                <span data-if="shadow_state_available &amp;&amp; !shadow_maps &amp;&amp; shadow_quality_available">
                                    Shadow maps are off; this quality will apply when enabled.
                                </span>
                                <span data-if="shadow_quality_status != ''">{{ shadow_quality_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blob Shadows</div>
                                    <div class="settings-control-description">
                                        Use a basic, lower-cost shadow beneath eligible models.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="blob_shadows"
                                        data-attrif-disabled="!shadow_state_available"
                                        data-event-change="select_blob_shadows(ev.checked)" />
                                    <span data-if="blob_shadows">On</span>
                                    <span data-if="!blob_shadows">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="(shadow_maps &amp;&amp; blob_shadows) || shadow_status != ''">
                                <span data-if="shadow_maps &amp;&amp; blob_shadows">
                                    Shadow maps take precedence; blob shadows remain configured as fallback.
                                </span>
                                <span data-if="shadow_status != ''">{{ shadow_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Water Refraction</div>
                                    <div class="settings-control-description">
                                        Distort the scene beneath water using an additional render pass.
                                    </div>
                                    <div class="settings-control-description"
                                        data-if="water_surface_state_available &amp;&amp; !water_refraction_available">
                                        Unavailable with the current renderer.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="water_refraction"
                                        data-attrif-disabled="!water_surface_state_available || (!water_refraction_available &amp;&amp; !water_refraction)"
                                        data-event-change="select_water_refraction(ev.checked)" />
                                    <span data-if="water_refraction">On</span>
                                    <span data-if="!water_refraction">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Dynamic Water Reflections</div>
                                    <div class="settings-control-description">
                                        Render live scene reflections on water using an additional render pass.
                                    </div>
                                    <div class="settings-control-description"
                                        data-if="water_surface_state_available &amp;&amp; !water_reflections_available">
                                        Unavailable with the current renderer.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="water_reflections"
                                        data-attrif-disabled="!water_surface_state_available || (!water_reflections_available &amp;&amp; !water_reflections)"
                                        data-event-change="select_water_reflections(ev.checked)" />
                                    <span data-if="water_reflections">On</span>
                                    <span data-if="!water_reflections">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Water Environment Reflections</div>
                                    <div class="settings-control-description">
                                        Use a cubemap for lower-cost water reflections when Dynamic Water Reflections are off. Appearance depends on the map's water material and sky.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="water_environment_reflections"
                                        data-attrif-disabled="!water_environment_reflections_available"
                                        data-event-change="select_water_environment_reflections(ev.checked)" />
                                    <span data-if="water_environment_reflections">On</span>
                                    <span data-if="!water_environment_reflections">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="water_environment_reflections_status != ''">
                                <span>{{ water_environment_reflections_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Water Reflection/Refraction Resolution</div>
                                    <div class="settings-control-description">
                                        Sets the requested resolution of live water reflections, water refraction, and waterfall refraction. Higher resolutions look sharper but use more graphics memory and rendering time. The renderer may reduce the requested resolution to fit hardware limits.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ water_render_resolution_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="water_render_resolution_selected == 0"
                                    data-attrif-disabled="!water_render_resolution_available"
                                    data-event-click="select_water_render_resolution(0)">Minimum</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="water_render_resolution_selected == 1"
                                    data-attrif-disabled="!water_render_resolution_available"
                                    data-event-click="select_water_render_resolution(1)">Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="water_render_resolution_selected == 2"
                                    data-attrif-disabled="!water_render_resolution_available"
                                    data-event-click="select_water_render_resolution(2)">Medium</button>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="water_render_resolution_selected == 3"
                                    data-attrif-disabled="!water_render_resolution_available"
                                    data-event-click="select_water_render_resolution(3)">High</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="water_render_resolution_selected == 4"
                                    data-attrif-disabled="!water_render_resolution_available"
                                    data-event-click="select_water_render_resolution(4)">Very High</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="water_render_resolution_selected == 5"
                                    data-attrif-disabled="!water_render_resolution_available"
                                    data-event-click="select_water_render_resolution(5)">Ultra</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="water_render_resolution_available || water_render_resolution_status != ''">
                                <span data-if="water_render_resolution_available">
                                    Requested target: {{ water_render_resolution_dimension }}
                                </span>
                                <span data-if="water_render_resolution_status != ''">{{ water_render_resolution_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Water Caustics</div>
                                    <div class="settings-control-description">
                                        Add animated light patterns beneath water with an extra geometry pass.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="water_caustics"
                                        data-attrif-disabled="!water_surface_state_available"
                                        data-event-change="select_water_caustics(ev.checked)" />
                                    <span data-if="water_caustics">On</span>
                                    <span data-if="!water_caustics">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Liquid Surface Animation</div>
                                    <div class="settings-control-description">
                                        Animate water and lava surfaces, including waterfall edges, with vertex waves.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="liquid_surface_animation"
                                        data-attrif-disabled="!water_surface_state_available"
                                        data-event-change="select_liquid_animation(ev.checked)" />
                                    <span data-if="liquid_surface_animation">On</span>
                                    <span data-if="!liquid_surface_animation">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="water_surface_status != ''">
                                <span>{{ water_surface_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Waterfall Refraction</div>
                                    <div class="settings-control-description">
                                        Distort the scene behind eligible waterfalls using an additional render pass.
                                    </div>
                                    <div class="settings-control-description"
                                        data-if="waterfall_state_available &amp;&amp; !waterfall_refraction_available">
                                        Unavailable with the current renderer.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="waterfall_refraction"
                                        data-attrif-disabled="!waterfall_state_available || (!waterfall_refraction_available &amp;&amp; !waterfall_refraction)"
                                        data-event-change="select_waterfall_refraction(ev.checked)" />
                                    <span data-if="waterfall_refraction">On</span>
                                    <span data-if="!waterfall_refraction">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Waterfall Reflections</div>
                                    <div class="settings-control-description">
                                        Add environment-map reflections to waterfall surfaces.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="waterfall_reflections"
                                        data-attrif-disabled="!waterfall_state_available"
                                        data-event-change="select_waterfall_reflections(ev.checked)" />
                                    <span data-if="waterfall_reflections">On</span>
                                    <span data-if="!waterfall_reflections">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="waterfall_status != ''">
                                <span>{{ waterfall_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Glass Reflections</div>
                                    <div class="settings-control-description">
                                        Add reflections of the surrounding environment to glass surfaces when the map provides suitable reflection data.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="glass_reflections"
                                        data-attrif-disabled="!glass_reflections_available"
                                        data-event-change="select_glass_reflections(ev.checked)" />
                                    <span data-if="glass_reflections">On</span>
                                    <span data-if="!glass_reflections">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="glass_reflections_status != ''">
                                <span>{{ glass_reflections_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Model Reflections</div>
                                    <div class="settings-control-description">
                                        Add reflections of the surrounding environment to model materials designed to use them.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="model_reflections"
                                        data-attrif-disabled="!model_reflections_available"
                                        data-event-change="select_model_reflections(ev.checked)" />
                                    <span data-if="model_reflections">On</span>
                                    <span data-if="!model_reflections">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="model_reflections_status != ''">
                                <span>{{ model_reflections_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Model Bump Maps</div>
                                    <div class="settings-control-description">
                                        Use normal maps on models that provide them. Changing this rebuilds model shaders and may hitch briefly.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="bump_models"
                                        data-attrif-disabled="!bump_models_available"
                                        data-event-change="select_bump_models(ev.checked)" />
                                    <span data-if="bump_models">On</span>
                                    <span data-if="!bump_models">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="bump_models_status != ''">
                                <span>{{ bump_models_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Environment Reflection Resolution</div>
                                    <div class="settings-control-description">
                                        Sets the requested face resolution for environment-map reflections used by compatible world materials, glass, models, waterfalls, and water fallback. Higher resolutions can look sharper but increase generation time and graphics memory use. Source, window, hardware, and other texture limits may reduce the effective size.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ environment_map_resolution_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 0"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(0)">Minimum</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 1"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(1)">Very Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 2"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(2)">Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 3"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(3)">Medium</button>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 4"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(4)">High</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 5"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(5)">Very High</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="environment_map_resolution_selected == 6"
                                    data-attrif-disabled="!environment_map_resolution_available"
                                    data-event-click="select_environment_map_resolution(6)">Ultra</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="environment_map_resolution_available || environment_map_resolution_status != ''">
                                <span data-if="environment_map_resolution_available">
                                    Requested face: {{ environment_map_resolution_dimension }}
                                </span>
                                <span data-if="environment_map_resolution_status != ''">{{ environment_map_resolution_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Dynamic Lights</div>
                                    <div class="settings-control-description">
                                        Controls how many nearby dynamic lights can illuminate world surfaces in each map area. Higher levels add GPU lighting work.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ dynamic_lights_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="dynamic_lights_selected == 0"
                                    data-attrif-disabled="!dynamic_lights_available"
                                    data-event-click="select_dynamic_lights(0)">Off</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="dynamic_lights_selected == 1"
                                    data-attrif-disabled="!dynamic_lights_available"
                                    data-event-click="select_dynamic_lights(1)">Medium</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="dynamic_lights_selected == 2"
                                    data-attrif-disabled="!dynamic_lights_available"
                                    data-event-click="select_dynamic_lights(2)">High</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="dynamic_lights_status != ''">
                                <span>{{ dynamic_lights_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Soft Particles</div>
                                    <div class="settings-control-description">
                                        Smooth the edges where explosion particles intersect world geometry using an off-screen depth pass.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="soft_particles"
                                        data-attrif-disabled="!soft_particles_available"
                                        data-event-change="select_soft_particles(ev.checked)" />
                                    <span data-if="soft_particles">On</span>
                                    <span data-if="!soft_particles">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="soft_particles_status != ''">
                                <span>{{ soft_particles_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Soft Particle Quality</div>
                                    <div class="settings-control-description">
                                        Adjust off-screen depth resolution and smoothing for Soft Particles. Higher quality uses more GPU resources.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ soft_particle_quality_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="soft_particle_quality_selected == 0"
                                    data-attrif-disabled="!soft_particle_quality_available"
                                    data-event-click="select_soft_particle_quality(0)">Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="soft_particle_quality_selected == 1"
                                    data-attrif-disabled="!soft_particle_quality_available"
                                    data-event-click="select_soft_particle_quality(1)">Medium</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="soft_particle_quality_selected == 2"
                                    data-attrif-disabled="!soft_particle_quality_available"
                                    data-event-click="select_soft_particle_quality(2)">High</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="soft_particle_quality_status != ''">
                                <span>{{ soft_particle_quality_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Decals</div>
                                    <div class="settings-control-description">
                                        Create and draw bullet holes, scorch marks, and blood on eligible world surfaces. Turning this off hides existing marks while they expire.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="decals"
                                        data-attrif-disabled="!decals_available"
                                        data-event-change="select_decals(ev.checked)" />
                                    <span data-if="decals">On</span>
                                    <span data-if="!decals">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="decals_status != ''">
                                <span>{{ decals_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Decal Persistence</div>
                                    <div class="settings-control-description">
                                        Controls how long marks remain and how much decal geometry can be stored. Longer persistence can use more CPU and GPU memory. Changing presets may clear existing marks.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ decal_persistence_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="decal_persistence_selected == 0"
                                    data-attrif-disabled="!decal_persistence_available"
                                    data-event-click="select_decal_persistence(0)">Short</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="decal_persistence_selected == 1"
                                    data-attrif-disabled="!decal_persistence_available"
                                    data-event-click="select_decal_persistence(1)">Long</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="decal_persistence_status != ''">
                                <span>{{ decal_persistence_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Fix T-Joints</div>
                                    <div class="settings-control-description">
                                        Fill T-junctions in world geometry so adjacent cubes meet cleanly. This reduces sparkles and seams. Changing it rebuilds the map's vertex arrays and may hitch.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="fix_t_joints"
                                        data-attrif-disabled="!fix_t_joints_available"
                                        data-event-change="select_fix_t_joints(ev.checked)" />
                                    <span data-if="fix_t_joints">On</span>
                                    <span data-if="!fix_t_joints">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="fix_t_joints_status != ''">
                                <span>{{ fix_t_joints_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Grass</div>
                                    <div class="settings-control-description">
                                        Draw grass on map surfaces that support it. Changes take effect immediately.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="grass"
                                        onclick="settings.grass" />
                                    <span data-if="grass">Enabled</span>
                                    <span data-if="!grass">Disabled</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Grass Distance</div>
                                    <div class="settings-control-description">
                                        Controls how far grass remains visible before fading out.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ grass_distance_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="grass_distance_selected == 0"
                                    data-attrif-disabled="!grass_distance_available"
                                    data-event-click="select_grass_distance(0)">Quick</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="grass_distance_selected == 1"
                                    data-attrif-disabled="!grass_distance_available"
                                    data-event-click="select_grass_distance(1)">Moderate</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="grass_distance_selected == 2"
                                    data-attrif-disabled="!grass_distance_available"
                                    data-event-click="select_grass_distance(2)">Slow</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="(!grass &amp;&amp; grass_distance_available) || grass_distance_status != ''">
                                <span data-if="!grass &amp;&amp; grass_distance_available">
                                    Grass is off; this distance will apply when enabled.
                                </span>
                                <span data-if="grass_distance_status != ''">{{ grass_distance_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Motion Blur</div>
                                    <div class="settings-control-description">
                                        Blend successive frames during gameplay. Changes take effect immediately.
                                    </div>
                                    <div class="settings-control-description" data-if="!motion_blur_available">
                                        Unavailable at this resolution with the current texture-size limit.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="motion_blur"
                                        data-attrif-disabled="!motion_blur_available"
                                        onclick="settings.motion-blur" />
                                    <span data-if="motion_blur">Enabled</span>
                                    <span data-if="!motion_blur &amp;&amp; motion_blur_available">Disabled</span>
                                    <span data-if="!motion_blur_available">Unavailable</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Motion Blur Intensity</div>
                                    <div class="settings-control-description">
                                        Choose the stored strength used when Motion Blur is active.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ motion_blur_intensity_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="motion_blur_intensity_selected == 0"
                                    data-attrif-disabled="!motion_blur_intensity_available"
                                    data-event-click="select_motion_blur_intensity(0)">Subtle</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="motion_blur_intensity_selected == 1"
                                    data-attrif-disabled="!motion_blur_intensity_available"
                                    data-event-click="select_motion_blur_intensity(1)">Moderate</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="motion_blur_intensity_selected == 2"
                                    data-attrif-disabled="!motion_blur_intensity_available"
                                    data-event-click="select_motion_blur_intensity(2)">Intense</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="(!motion_blur_available &amp;&amp; motion_blur_intensity_available) || (motion_blur_available &amp;&amp; !motion_blur &amp;&amp; motion_blur_intensity_available) || motion_blur_intensity_status != ''">
                                <span data-if="!motion_blur_available &amp;&amp; motion_blur_intensity_available">
                                    Motion blur is unavailable; this intensity remains configured.
                                </span>
                                <span data-if="motion_blur_available &amp;&amp; !motion_blur &amp;&amp; motion_blur_intensity_available">
                                    Motion blur is off; this intensity will apply when enabled.
                                </span>
                                <span data-if="motion_blur_intensity_status != ''">{{ motion_blur_intensity_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Glare</div>
                                    <div class="settings-control-description">
                                        Add a glow around bright surfaces and effects.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="glare"
                                        data-event-change="select_glare(ev.checked)" />
                                    <span data-if="glare">On</span>
                                    <span data-if="!glare">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Glare Preset</div>
                                    <div class="settings-control-description">
                                        Choose the stored glare intensity and blur profile.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ glare_preset_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_preset_selected == 0"
                                    data-attrif-disabled="!glare_preset_available"
                                    data-event-click="select_glare_preset(0)">Subtle</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_preset_selected == 1"
                                    data-attrif-disabled="!glare_preset_available"
                                    data-event-click="select_glare_preset(1)">Glowy</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_preset_selected == 2"
                                    data-attrif-disabled="!glare_preset_available"
                                    data-event-click="select_glare_preset(2)">Soft</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_preset_selected == 3"
                                    data-attrif-disabled="!glare_preset_available"
                                    data-event-click="select_glare_preset(3)">Intense</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="(!glare &amp;&amp; glare_preset_available) || glare_preset_status != ''">
                                <span data-if="!glare &amp;&amp; glare_preset_available">
                                    Glare is off; this preset will apply when enabled.
                                </span>
                                <span data-if="glare_preset_status != ''">{{ glare_preset_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Glare Intensity</div>
                                    <div class="settings-control-description">
                                        Adjusts how strongly Glare is blended into the final image. Lower values reduce its visible strength but do not reduce rendering work.
                                    </div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ glare_intensity_label }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">0x</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="8"
                                    step="0.1"
                                    data-attr-value="glare_intensity_slider"
                                    data-attrif-disabled="!glare_intensity_available"
                                    onchange="settings.glare-intensity" />
                                <span class="settings-range-bound settings-range-maximum">8x</span>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="glare_intensity_status != ''">
                                <span>{{ glare_intensity_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Glare Render Resolution</div>
                                    <div class="settings-control-description">
                                        Controls the off-screen target used to render Glare. Higher levels can preserve finer effect detail, but increase GPU pixel work and graphics memory use.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ glare_resolution_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_resolution_selected == 0"
                                    data-attrif-disabled="!glare_resolution_available"
                                    data-event-click="select_glare_resolution(0)">Minimum</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_resolution_selected == 1"
                                    data-attrif-disabled="!glare_resolution_available"
                                    data-event-click="select_glare_resolution(1)">Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_resolution_selected == 2"
                                    data-attrif-disabled="!glare_resolution_available"
                                    data-event-click="select_glare_resolution(2)">Medium</button>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_resolution_selected == 3"
                                    data-attrif-disabled="!glare_resolution_available"
                                    data-event-click="select_glare_resolution(3)">High</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="glare_resolution_selected == 4"
                                    data-attrif-disabled="!glare_resolution_available"
                                    data-event-click="select_glare_resolution(4)">Ultra</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="glare_resolution_available || glare_resolution_status != ''">
                                <span data-if="glare_resolution_available">
                                    Requested target width: {{ glare_resolution_requested_width }} px
                                </span>
                                <span data-if="!glare &amp;&amp; glare_resolution_available">
                                    Glare is off; this resolution will apply when enabled.
                                </span>
                                <span data-if="glare_resolution_status != ''">{{ glare_resolution_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Texture Quality</div>
                                    <div class="settings-control-description">
                                        Lower limits reduce detail in world, model, effect, and sky textures; higher limits can use more graphics memory. Applying changes may briefly pause.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ texture_quality_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_quality_selected == 0"
                                    data-attrif-disabled="!texture_quality_available"
                                    data-event-click="select_texture_quality(0)">Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_quality_selected == 1"
                                    data-attrif-disabled="!texture_quality_available"
                                    data-event-click="select_texture_quality(1)">Medium</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_quality_selected == 2"
                                    data-attrif-disabled="!texture_quality_available"
                                    data-event-click="select_texture_quality(2)">Full</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="texture_quality_status != ''">
                                <span>{{ texture_quality_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Texture Reduction</div>
                                    <div class="settings-control-description">
                                        Reduces the width and height of eligible world and material textures before upload. Each step halves both dimensions, lowering texture memory use at the cost of detail. Existing textures update when graphics changes are applied.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ texture_reduction_label }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">Off</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="12"
                                    step="1"
                                    data-attr-min="texture_reduction_minimum"
                                    data-attr-max="texture_reduction_maximum"
                                    data-attr-value="texture_reduction"
                                    data-attrif-disabled="!texture_reduction_available"
                                    onchange="settings.texture-reduction" />
                                <span class="settings-range-bound settings-range-maximum">1/4096</span>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="texture_reduction_status != ''">
                                <span>{{ texture_reduction_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Automatic Texture Compression</div>
                                    <div class="settings-control-description">
                                        Compresses eligible decoded textures when either final dimension reaches the selected threshold. Lower thresholds affect more textures and can reduce graphics-memory use with possible quality loss. Texture sizing happens first; precompressed DDS textures are independent. Existing textures update when graphics changes are applied.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Configured</span>
                                    <span class="settings-resolution-current-value">{{ texture_compression_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 0"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(0)">Off</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 1"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(1)">All eligible textures</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 2"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(2)">256 px and larger</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 3"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(3)">512 px and larger</button>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 4"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(4)">1024 px and larger</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 5"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(5)">Above 1024 px</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 6"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(6)">2048 px and larger</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="texture_compression_selected == 7"
                                    data-attrif-disabled="!texture_compression_available || !texture_compression_supported"
                                    data-event-click="select_texture_compression(7)">4096 px and larger</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="texture_compression_status != ''">
                                <span>{{ texture_compression_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Bilinear Filtering</div>
                                    <div class="settings-control-description">
                                        Smooth texture sampling within each mip level and when textures are magnified. Existing textures update after graphics changes are applied.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="bilinear_filtering"
                                        data-attrif-disabled="!bilinear_filtering_available"
                                        data-event-change="select_bilinear_filtering(ev.checked)" />
                                    <span data-if="bilinear_filtering">On</span>
                                    <span data-if="!bilinear_filtering">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="bilinear_filtering_status != ''">
                                <span>{{ bilinear_filtering_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Mipmap Blending</div>
                                    <div class="settings-control-description">Smooth transitions between texture mip levels.</div>
                                    <div class="settings-control-description">{{ mipmap_blending_status }}</div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="mipmap_blending"
                                        data-attrif-disabled="!mipmap_blending_available"
                                        data-event-change="select_mipmap_blending(ev.checked)" />
                                    <span data-if="mipmap_blending">On</span>
                                    <span data-if="!mipmap_blending">Off</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Shader Detail</div>
                                    <div class="settings-control-description">
                                        Adjust material and effect shader detail. Changes may briefly pause rendering.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Current</span>
                                    <span class="settings-resolution-current-value">{{ shader_detail_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="shader_detail_selected == 0"
                                    data-attrif-disabled="!shader_detail_available"
                                    data-event-click="select_shader_detail(0)">Performance</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="shader_detail_selected == 1"
                                    data-attrif-disabled="!shader_detail_available"
                                    data-event-click="select_shader_detail(1)">Low</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="shader_detail_selected == 2"
                                    data-attrif-disabled="!shader_detail_available"
                                    data-event-click="select_shader_detail(2)">Medium</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="shader_detail_selected == 3"
                                    data-attrif-disabled="!shader_detail_available"
                                    data-event-click="select_shader_detail(3)">Full</button>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="shader_detail_status != ''">
                                <span>{{ shader_detail_status }}</span>
                            </div>
                        </div>

                        <div class="settings-control-footer settings-control-footer-compact"
                            data-if="graphics_quality_status != ''">
                            <span>{{ graphics_quality_status }}</span>
                        </div>

                        <div class="settings-section settings-antialiasing-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Anisotropic Filtering</div>
                                    <div class="settings-control-description">
                                        Sharpen textures viewed at an angle. Applies immediately without reloading textures.
                                    </div>
                                </div>
                                <div class="settings-resolution-current settings-antialiasing-current">
                                    <span class="settings-info-label">Current</span>
                                    <span class="settings-resolution-current-value">{{ anisotropy_label }}</span>
                                </div>
                            </div>
                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="anisotropy_selected == 0"
                                    data-attrif-disabled="!anisotropy_enabled"
                                    data-event-click="select_anisotropy(0)">Off</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="anisotropy_selected == 2"
                                    data-if="anisotropy_maximum >= 2"
                                    data-attrif-disabled="!anisotropy_enabled || anisotropy_maximum &lt; 2"
                                    data-event-click="select_anisotropy(2)">2x</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="anisotropy_selected == 4"
                                    data-if="anisotropy_maximum >= 4"
                                    data-attrif-disabled="!anisotropy_enabled || anisotropy_maximum &lt; 4"
                                    data-event-click="select_anisotropy(4)">4x</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="anisotropy_selected == 8"
                                    data-if="anisotropy_maximum >= 8"
                                    data-attrif-disabled="!anisotropy_enabled || anisotropy_maximum &lt; 8"
                                    data-event-click="select_anisotropy(8)">8x</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="anisotropy_selected == 16"
                                    data-if="anisotropy_maximum >= 16"
                                    data-attrif-disabled="!anisotropy_enabled || anisotropy_maximum &lt; 16"
                                    data-event-click="select_anisotropy(16)">16x</button>
                            </div>
                            <div class="settings-control-footer">
                                <span>{{ anisotropy_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-resolution-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Resolution</div>
                                    <div class="settings-control-description">
                                        Window/display resolution. HiDPI rendering may use a higher physical resolution.
                                    </div>
                                </div>
                                <div class="settings-resolution-current">
                                    <span class="settings-info-label">Current</span>
                                    <span class="settings-resolution-current-value">{{ resolution_label }}</span>
                                    <span class="settings-resolution-render"
                                        data-if="render_resolution_visible">Render {{ render_resolution_label }}</span>
                                </div>
                            </div>

                            <div class="settings-resolution-grid">
                                <div class="settings-resolution-repeat"
                                    data-for="resolution : resolutions">
                                    <button class="button settings-resolution-button"
                                        data-class-is-selected="resolution.selected"
                                        data-attrif-disabled="!resolution_enabled || !resolution.supported"
                                        data-event-click="select_resolution(resolution.width, resolution.height)">
                                        {{ resolution.label }}
                                    </button>
                                </div>
                            </div>

                            <div class="settings-resolution-note" data-if="presentation_desktop">
                                Desktop fullscreen uses the display's native size. Resolution selection is unavailable in this mode.
                            </div>
                        </div>
                    </div>

                    <div class="settings-page" data-if="category_audio">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Audio / Mix</div>
                            <div class="settings-stage-title">Audio</div>
                            <div class="settings-stage-copy">
                                Balance gameplay sounds and music, then configure output quality and device behavior.
                            </div>
                        </div>

                        <div class="settings-section settings-audio-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Sound Volume</div>
                                    <div class="settings-control-description">
                                        Control gameplay sound effects. Setting this to zero also mutes music.
                                    </div>
                                </div>
                                <div class="settings-value settings-audio-value">
                                    <span class="settings-fps-value-label">{{ sound_volume_label }}</span>
                                </div>
                            </div>

                            <div class="settings-range-row settings-audio-range-row">
                                <span class="settings-range-bound">{{ sound_volume_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="sound_volume_minimum"
                                    data-attr-max="sound_volume_maximum"
                                    data-attr-value="sound_volume"
                                    onchange="settings.audio.sound-volume" />
                                <span class="settings-range-bound settings-range-maximum">{{ sound_volume_maximum }}</span>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>Current level&nbsp;&nbsp;{{ sound_volume }} / {{ sound_volume_maximum }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-audio-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Music Volume</div>
                                    <div class="settings-control-description">
                                        Controls streamed music independently while Sound Volume remains above zero.
                                    </div>
                                </div>
                                <div class="settings-value settings-audio-value">
                                    <span class="settings-fps-value-label">{{ music_volume_label }}</span>
                                </div>
                            </div>

                            <div class="settings-range-row settings-audio-range-row">
                                <span class="settings-range-bound">{{ music_volume_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="music_volume_minimum"
                                    data-attr-max="music_volume_maximum"
                                    data-attr-value="music_volume"
                                    onchange="settings.audio.music-volume" />
                                <span class="settings-range-bound settings-range-maximum">{{ music_volume_maximum }}</span>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>Current level&nbsp;&nbsp;{{ music_volume }} / {{ music_volume_maximum }}</span>
                            </div>
                        </div>

                        <div id="settings-soundpacks" class="settings-section settings-audio-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Sound Pack</div>
                                    <div class="settings-control-description">
                                        Select an installed gameplay sound pack.
                                    </div>
                                </div>
                                <div class="settings-value settings-soundpack-current">
                                    <span class="settings-soundpack-current-label">{{ active_soundpack_label }}</span>
                                </div>
                            </div>

                            <div class="settings-soundpack-grid">
                                <div class="settings-soundpack-repeat"
                                    data-for="pack : soundpack_choices">
                                    <button class="button settings-soundpack-choice"
                                        data-class-is-selected="pack.selected"
                                        data-event-click="select_soundpack(pack.id)">
                                        <span class="settings-soundpack-choice-label">{{ pack.label }}</span>
                                        <span class="settings-soundpack-choice-state"
                                            data-if="pack.selected">Active</span>
                                    </button>
                                </div>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ soundpack_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-audio-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Sound Channels</div>
                                    <div class="settings-control-description">
                                        Set how many sounds can play at once. The audio system restarts when the change is applied.
                                    </div>
                                </div>
                                <div class="settings-value settings-audio-value">
                                    <span class="settings-fps-value-label">{{ sound_channels }}</span>
                                </div>
                            </div>

                            <div class="settings-range-row settings-audio-range-row">
                                <span class="settings-range-bound">{{ sound_channels_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="1"
                                    max="128"
                                    step="1"
                                    data-attr-min="sound_channels_minimum"
                                    data-attr-max="sound_channels_maximum"
                                    data-attr-value="sound_channels"
                                    onchange="settings.audio.sound-channels" />
                                <span class="settings-range-bound settings-range-maximum">{{ sound_channels_maximum }}</span>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ sound_channels_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-audio-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Sound Frequency</div>
                                    <div class="settings-control-description">
                                        Choose the output sample rate. Custom stored values remain unchanged until a listed rate is selected.
                                    </div>
                                </div>
                                <div class="settings-value settings-audio-value">
                                    <span class="settings-fps-value-label">{{ sound_frequency_label }}</span>
                                </div>
                            </div>

                            <div class="settings-antialiasing-selector">
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="sound_frequency == 11025"
                                    data-event-click="select_sound_frequency(11025)">11025 Hz</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="sound_frequency == 22050"
                                    data-event-click="select_sound_frequency(22050)">22050 Hz</button>
                                <button class="button settings-antialiasing-button"
                                    data-class-is-selected="sound_frequency == 44100"
                                    data-event-click="select_sound_frequency(44100)">44100 Hz</button>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ sound_frequency_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-audio-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Sound Buffer Length</div>
                                    <div class="settings-control-description">
                                        Set the audio buffer size. Larger buffers can improve stability but add latency.
                                    </div>
                                </div>
                                <div class="settings-value settings-audio-value">
                                    <span class="settings-fps-value-label">{{ sound_buffer_length }}</span>
                                </div>
                            </div>

                            <div class="settings-range-row settings-audio-range-row">
                                <span class="settings-range-bound">{{ sound_buffer_length_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="128"
                                    max="4096"
                                    step="1"
                                    data-attr-min="sound_buffer_length_minimum"
                                    data-attr-max="sound_buffer_length_maximum"
                                    data-attr-value="sound_buffer_length"
                                    onchange="settings.audio.sound-buffer-length" />
                                <span class="settings-range-bound settings-range-maximum">{{ sound_buffer_length_maximum }}</span>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ sound_buffer_length_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-audio-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Mumble Positional Audio</div>
                                    <div class="settings-control-description">
                                        Share positional information with Mumble when supported.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="mumble"
                                        data-event-change="select_mumble(ev.checked)" />
                                    <span data-if="mumble">On</span>
                                    <span data-if="!mumble">Off</span>
                                </label>
                            </div>
                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ mumble_status }}</span>
                            </div>
                        </div>

                        <div class="settings-info-row settings-audio-info-row">
                            <div class="settings-info-block">
                                <div class="settings-info-label">Runtime</div>
                                <div class="settings-info-value">{{ audio_status }}</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Application</div>
                                <div class="settings-info-value">Levels and Mumble apply immediately; device changes restart audio</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Persistence</div>
                                <div class="settings-info-value">Saved automatically</div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-page" data-if="category_mouse_keyboard">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Input / Gameplay</div>
                            <div class="settings-stage-title">Mouse &amp; Keyboard</div>
                            <div class="settings-stage-copy">
                                Adjust gameplay mouse response and manage typed key bindings with explicit conflict handling.
                            </div>
                        </div>

                        <div class="settings-section settings-input-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Mouse Sensitivity</div>
                                    <div class="settings-control-description">
                                        Changes the relative mouse scale used for camera movement. Buttons adjust by 0.01; type an exact value and press Enter.
                                    </div>
                                </div>
                                <div class="settings-stepper">
                                    <button class="button settings-stepper-button"
                                        onclick="settings.input.sensitivity.decrease">-</button>
                                    <input class="text-input settings-stepper-value"
                                        type="text"
                                        maxlength="16"
                                        data-value="mouse_sensitivity_input"
                                        data-class-is-invalid="mouse_sensitivity_invalid"
                                        onfocus="settings.input.sensitivity.focus"
                                        onblur="settings.input.sensitivity.blur"
                                        onkeyup="settings.input.sensitivity.commit" />
                                    <button class="button settings-stepper-button"
                                        onclick="settings.input.sensitivity.increase">+</button>
                                </div>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span data-if="mouse_sensitivity_status != ''">{{ mouse_sensitivity_status }}&nbsp;&nbsp;//&nbsp;&nbsp;</span>
                                <span>Engine range&nbsp;&nbsp;{{ mouse_sensitivity_minimum }} - {{ mouse_sensitivity_maximum }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-input-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Invert Vertical Look</div>
                                    <div class="settings-control-description">
                                        Reverses vertical camera movement while preserving horizontal look.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox"
                                        type="checkbox"
                                        data-attrif-checked="inverted_mouse"
                                        onclick="settings.input.inverted-mouse" />
                                    <span data-if="inverted_mouse">Inverted</span>
                                    <span data-if="!inverted_mouse">Standard</span>
                                </label>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>{{ mouse_input_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-keybindings-panel panel">
                            <div class="settings-control-title">Key Bindings</div>
                            <div class="settings-control-description">
                                Actions can have multiple bindings. Add Binding keeps existing keys; Replace moves only the selected key. × removes one exact binding.
                            </div>
                            <div class="settings-key-result" data-if="key_binding_status != ''">{{ key_binding_status }}</div>

                            <div class="settings-keybinding-group">
                                <div class="settings-keybinding-group-title">Movement</div>
                                <div class="settings-keybinding-list">
                                    <div class="settings-keybinding-row"
                                        data-for="binding : keybindings_movement">
                                        <span class="settings-keybinding-label">{{ binding.label }}</span>
                                        <div class="settings-keybinding-values">
                                            <span class="settings-key-chip"
                                                data-for="key : binding.keys">
                                                <span>{{ key }}</span>
                                                <button class="button settings-key-remove"
                                                    title="Remove binding"
                                                    data-event-click="request_key_removal(binding.action_id, key)">×</button>
                                            </span>
                                            <span class="settings-key-unbound"
                                                data-if="!binding.bound">Unbound</span>
                                        </div>
                                        <button class="button settings-key-rebind"
                                            data-event-click="capture_key(binding.action_id)">Add Binding</button>
                                        <div class="settings-key-removal"
                                            data-if="key_removal_active && key_removal_action_id == binding.action_id">
                                            <div>{{ key_removal_prompt }}</div>
                                            <div class="settings-key-decisions">
                                                <button class="button" data-event-click="decide_key_removal(1)">Remove</button>
                                                <button class="button" data-event-click="decide_key_removal(0)">Cancel</button>
                                            </div>
                                        </div>
                                        <span class="settings-key-capture"
                                            data-if="key_capture_id == binding.action_id">{{ key_capture_status }}</span>
                                        <span class="settings-key-conflict"
                                            data-if="key_capture_id == binding.action_id && key_conflict_status != ''"
                                            data-class-is-available="key_conflict_available"
                                            data-class-is-same-action="key_conflict_same_action"
                                            data-class-is-conflict="key_conflict_present">{{ key_conflict_status }}</span>
                                        <div class="settings-key-decisions"
                                            data-if="key_capture_id == binding.action_id && key_candidate_pending">
                                            <button class="button" data-if="key_conflict_available"
                                                data-event-click="decide_key(binding.action_id, 1)">Apply</button>
                                            <button class="button" data-if="key_conflict_present"
                                                data-event-click="decide_key(binding.action_id, 2)">Replace</button>
                                            <button class="button"
                                                data-event-click="decide_key(binding.action_id, 0)">{{ key_conflict_same_action ? 'Dismiss' : 'Cancel' }}</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-keybinding-group">
                                <div class="settings-keybinding-group-title">Combat</div>
                                <div class="settings-keybinding-list">
                                    <div class="settings-keybinding-row"
                                        data-for="binding : keybindings_combat">
                                        <span class="settings-keybinding-label">{{ binding.label }}</span>
                                        <div class="settings-keybinding-values">
                                            <span class="settings-key-chip"
                                                data-for="key : binding.keys">
                                                <span>{{ key }}</span>
                                                <button class="button settings-key-remove"
                                                    title="Remove binding"
                                                    data-event-click="request_key_removal(binding.action_id, key)">×</button>
                                            </span>
                                            <span class="settings-key-unbound"
                                                data-if="!binding.bound">Unbound</span>
                                        </div>
                                        <button class="button settings-key-rebind"
                                            data-event-click="capture_key(binding.action_id)">Add Binding</button>
                                        <div class="settings-key-removal"
                                            data-if="key_removal_active && key_removal_action_id == binding.action_id">
                                            <div>{{ key_removal_prompt }}</div>
                                            <div class="settings-key-decisions">
                                                <button class="button" data-event-click="decide_key_removal(1)">Remove</button>
                                                <button class="button" data-event-click="decide_key_removal(0)">Cancel</button>
                                            </div>
                                        </div>
                                        <span class="settings-key-capture"
                                            data-if="key_capture_id == binding.action_id">{{ key_capture_status }}</span>
                                        <span class="settings-key-conflict"
                                            data-if="key_capture_id == binding.action_id && key_conflict_status != ''"
                                            data-class-is-available="key_conflict_available"
                                            data-class-is-same-action="key_conflict_same_action"
                                            data-class-is-conflict="key_conflict_present">{{ key_conflict_status }}</span>
                                        <div class="settings-key-decisions"
                                            data-if="key_capture_id == binding.action_id && key_candidate_pending">
                                            <button class="button" data-if="key_conflict_available"
                                                data-event-click="decide_key(binding.action_id, 1)">Apply</button>
                                            <button class="button" data-if="key_conflict_present"
                                                data-event-click="decide_key(binding.action_id, 2)">Replace</button>
                                            <button class="button"
                                                data-event-click="decide_key(binding.action_id, 0)">{{ key_conflict_same_action ? 'Dismiss' : 'Cancel' }}</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-keybinding-group">
                                <div class="settings-keybinding-group-title">Interface</div>
                                <div class="settings-keybinding-list">
                                    <div class="settings-keybinding-row"
                                        data-for="binding : keybindings_interface">
                                        <span class="settings-keybinding-label">{{ binding.label }}</span>
                                        <div class="settings-keybinding-values">
                                            <span class="settings-key-chip"
                                                data-for="key : binding.keys">
                                                <span>{{ key }}</span>
                                                <button class="button settings-key-remove"
                                                    title="Remove binding"
                                                    data-event-click="request_key_removal(binding.action_id, key)">×</button>
                                            </span>
                                            <span class="settings-key-unbound"
                                                data-if="!binding.bound">Unbound</span>
                                        </div>
                                        <button class="button settings-key-rebind"
                                            data-event-click="capture_key(binding.action_id)">Add Binding</button>
                                        <div class="settings-key-removal"
                                            data-if="key_removal_active && key_removal_action_id == binding.action_id">
                                            <div>{{ key_removal_prompt }}</div>
                                            <div class="settings-key-decisions">
                                                <button class="button" data-event-click="decide_key_removal(1)">Remove</button>
                                                <button class="button" data-event-click="decide_key_removal(0)">Cancel</button>
                                            </div>
                                        </div>
                                        <span class="settings-key-capture"
                                            data-if="key_capture_id == binding.action_id">{{ key_capture_status }}</span>
                                        <span class="settings-key-conflict"
                                            data-if="key_capture_id == binding.action_id && key_conflict_status != ''"
                                            data-class-is-available="key_conflict_available"
                                            data-class-is-same-action="key_conflict_same_action"
                                            data-class-is-conflict="key_conflict_present">{{ key_conflict_status }}</span>
                                        <div class="settings-key-decisions"
                                            data-if="key_capture_id == binding.action_id && key_candidate_pending">
                                            <button class="button" data-if="key_conflict_available"
                                                data-event-click="decide_key(binding.action_id, 1)">Apply</button>
                                            <button class="button" data-if="key_conflict_present"
                                                data-event-click="decide_key(binding.action_id, 2)">Replace</button>
                                            <button class="button"
                                                data-event-click="decide_key(binding.action_id, 0)">{{ key_conflict_same_action ? 'Dismiss' : 'Cancel' }}</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="settings-crosshair" class="settings-page" data-if="category_crosshair">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">HUD / Reticle</div>
                            <div class="settings-stage-title">Crosshair</div>
                            <div class="settings-stage-copy">
                                Select a crosshair style and configure its dynamic gameplay effects.
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Crosshair Style</div>
                                    <div class="settings-control-description">
                                        Choose the normal and hit appearance used during gameplay.
                                    </div>
                                </div>
                                <div class="settings-value settings-crosshair-current">
                                    <img class="settings-crosshair-current-image"
                                        data-attr-src="crosshair_selection_resource" />
                                    <span class="settings-crosshair-current-label">{{ crosshair_selection_label }}</span>
                                </div>
                            </div>
                            <div class="settings-crosshair-grid">
                                <div class="settings-crosshair-repeat"
                                    data-for="choice : crosshair_choices">
                                    <button class="button settings-crosshair-choice"
                                        data-class-is-selected="choice.selected"
                                        data-event-click="select_crosshair(choice.id)">
                                        <img class="settings-crosshair-choice-image"
                                            data-attr-src="choice.resource" />
                                        <span class="settings-crosshair-choice-label">{{ choice.label }}</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Crosshair Size</div>
                                    <div class="settings-control-description">
                                        Buttons adjust by one. Type an exact value and press Enter, or click elsewhere to apply it.
                                    </div>
                                </div>
                                <div class="settings-stepper">
                                    <button class="button settings-stepper-button"
                                        onclick="settings.crosshair.size.decrease">-</button>
                                    <input class="text-input settings-stepper-value"
                                        type="text" maxlength="3"
                                        data-value="crosshair_size_input"
                                        data-class-is-invalid="crosshair_size_invalid"
                                        onfocus="settings.crosshair.size.focus"
                                        onblur="settings.crosshair.size.blur"
                                        onkeyup="settings.crosshair.size.commit" />
                                    <button class="button settings-stepper-button"
                                        onclick="settings.crosshair.size.increase">+</button>
                                </div>
                            </div>
                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>Range&nbsp;&nbsp;{{ crosshair_size_minimum }} - {{ crosshair_size_maximum }}&nbsp;&nbsp;//&nbsp;&nbsp;{{ crosshair_status }}</span>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Dynamic Effects</div>
                                    <div class="settings-control-description">
                                        Master switch for teammate, hit, and health-color crosshair states.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="crosshair_effects"
                                        onclick="settings.crosshair.effects" />
                                    <span data-if="crosshair_effects">Enabled</span>
                                    <span data-if="!crosshair_effects">Disabled</span>
                                </label>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Health Colors</div>
                                    <div class="settings-control-description">
                                        Uses inherited low-health crosshair colors outside instagib modes.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="crosshair_health_colors"
                                        data-attrif-disabled="!crosshair_effects"
                                        onclick="settings.crosshair.health-colors" />
                                    <span data-if="crosshair_health_colors">Enabled</span>
                                    <span data-if="!crosshair_health_colors">Disabled</span>
                                </label>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Teammate Crosshair</div>
                                    <div class="settings-control-description">
                                        Switches to the teammate state when aiming at an ally.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="team_crosshair"
                                        data-attrif-disabled="!crosshair_effects"
                                        onclick="settings.crosshair.teammates" />
                                    <span data-if="team_crosshair">Enabled</span>
                                    <span data-if="!team_crosshair">Disabled</span>
                                </label>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Hit Marker</div>
                                    <div class="settings-control-description">
                                        Briefly show the selected hit appearance after dealing damage.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="hit_crosshair"
                                        data-attrif-disabled="!crosshair_effects"
                                        onclick="settings.crosshair.hit-marker" />
                                    <span data-if="hit_crosshair">Enabled</span>
                                    <span data-if="!hit_crosshair">Disabled</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Reload Fade</div>
                                    <div class="settings-control-description">
                                        p1x rifle reload feedback fades from red to the ready color in instagib.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="crosshair_reload_fade"
                                        data-attrif-disabled="!crosshair_effects || !crosshair_health_colors"
                                        onclick="settings.crosshair.reload-fade" />
                                    <span data-if="crosshair_reload_fade">Enabled</span>
                                    <span data-if="!crosshair_reload_fade">Disabled</span>
                                </label>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Reload Rotation</div>
                                    <div class="settings-control-description">
                                        Cowbraten rotates the rifle crosshair from 45 degrees back to ready during reload.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="crosshair_reload_rotation"
                                        onclick="settings.crosshair.reload-rotation" />
                                    <span data-if="crosshair_reload_rotation">Enabled</span>
                                    <span data-if="!crosshair_reload_rotation">Disabled</span>
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="settings-page" data-if="category_chat">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Game / Communications</div>
                            <div class="settings-stage-title">Chat</div>
                            <div class="settings-stage-copy">
                                Control where public and team messages appear without changing message delivery, input, or the full console history.
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-control-title">Top-left Feed</div>
                            <div class="settings-control-description">
                                The normal in-game console feed. Hidden messages remain available in the full console.
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Public Messages</div>
                                    <div class="settings-control-description">
                                        Show normal player chat in the top-left feed.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="public_chat_in_top_feed"
                                        onclick="settings.chat.top.public" />
                                    <span data-if="public_chat_in_top_feed">Shown</span>
                                    <span data-if="!public_chat_in_top_feed">Hidden</span>
                                </label>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Team Messages</div>
                                    <div class="settings-control-description">
                                        Show team and spectator-team chat in the top-left feed.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="team_chat_in_top_feed"
                                        onclick="settings.chat.top.team" />
                                    <span data-if="team_chat_in_top_feed">Shown</span>
                                    <span data-if="!team_chat_in_top_feed">Hidden</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-control-title">Bottom-left Chat Box</div>
                            <div class="settings-control-description">
                                Sauer's compact lower message feed. Public and team message types can be routed independently.
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Public Messages</div>
                                    <div class="settings-control-description">
                                        Mirror normal player chat in the bottom-left box.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="public_chat_in_bottom_box"
                                        onclick="settings.chat.bottom.public" />
                                    <span data-if="public_chat_in_bottom_box">Shown</span>
                                    <span data-if="!public_chat_in_bottom_box">Hidden</span>
                                </label>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Team Messages</div>
                                    <div class="settings-control-description">
                                        Mirror team and spectator-team chat in the bottom-left box.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="team_chat_in_bottom_box"
                                        onclick="settings.chat.bottom.team" />
                                    <span data-if="team_chat_in_bottom_box">Shown</span>
                                    <span data-if="!team_chat_in_bottom_box">Hidden</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Team-colored Names</div>
                                    <div class="settings-control-description">
                                        Use each player's team color for their name in public and team chat.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="team_colored_chat_names"
                                        onclick="settings.chat.team-colors" />
                                    <span data-if="team_colored_chat_names">Enabled</span>
                                    <span data-if="!team_colored_chat_names">Disabled</span>
                                </label>
                            </div>
                        </div>

                        <div id="settings-autoignore"
                            class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Auto Ignore</div>
                                    <div class="settings-control-description">
                                        Ignore listed players as soon as they join or adopt a listed name. Matching is exact and case-sensitive; bots and your own client are excluded.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="auto_ignore_enabled"
                                        data-event-change="select_auto_ignore_enabled(ev.checked)" />
                                    <span data-if="auto_ignore_enabled">Enabled</span>
                                    <span data-if="!auto_ignore_enabled">Disabled</span>
                                </label>
                            </div>

                            <div class="settings-display-row settings-control-divider"
                                data-for="entry : auto_ignore_rows">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">{{ entry.label }}</div>
                                </div>
                                <input class="text-input settings-auto-ignore-name"
                                    type="text" maxlength="15" placeholder="Empty slot"
                                    data-value="entry.name"
                                    data-event-change="commit_auto_ignore_name(entry.slot, ev.value)" />
                            </div>
                            <div class="settings-auto-ignore-actions">
                                <button class="button settings-auto-ignore-button"
                                    data-if="auto_ignore_rows.size < 20"
                                    data-event-click="add_auto_ignore_row()">Add field</button>
                                <button class="button settings-auto-ignore-button"
                                    data-if="auto_ignore_rows.size > 1"
                                    data-event-click="remove_auto_ignore_row()">Remove last</button>
                                <span class="settings-control-description">Up to 20 players</span>
                            </div>
                            <div class="settings-control-description settings-auto-ignore-status"
                                data-if="auto_ignore_status != ''">{{ auto_ignore_status }}</div>
                        </div>

                        <div class="settings-info-row">
                            <div class="settings-info-block">
                                <div class="settings-info-label">Application</div>
                                <div class="settings-info-value">Immediate</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Full Console</div>
                                <div class="settings-info-value">Filter unchanged</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Persistence</div>
                                <div class="settings-info-value">Saved automatically</div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-page" data-if="category_console">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Game / Console</div>
                            <div class="settings-stage-title">Console</div>
                            <div class="settings-stage-copy">
                                Choose which message types appear in the top-left feed and the full-console history. Public and team chat for the live feeds stay on the Chat page.
                            </div>
                        </div>

                        <div class="settings-console-columns">
                            <div class="settings-section settings-compact-section panel settings-console-column">
                                <div class="settings-control-title">Top-left Filter</div>
                                <div class="settings-control-description">
                                    Remaining message types for the normal in-game console. Chat and team chat are configured on the Chat page.
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Important Information</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_important"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.important" />
                                        <span data-if="console_top_important">Shown</span>
                                        <span data-if="!console_top_important">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Warnings</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_warnings"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.warnings" />
                                        <span data-if="console_top_warnings">Shown</span>
                                        <span data-if="!console_top_warnings">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Errors</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_errors"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.errors" />
                                        <span data-if="console_top_errors">Shown</span>
                                        <span data-if="!console_top_errors">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Script Messages</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_script"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.script" />
                                        <span data-if="console_top_script">Shown</span>
                                        <span data-if="!console_top_script">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Game Events</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_game_events"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.game-events" />
                                        <span data-if="console_top_game_events">Shown</span>
                                        <span data-if="!console_top_game_events">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Self Frags</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_self_frags"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.self-frags" />
                                        <span data-if="console_top_self_frags">Shown</span>
                                        <span data-if="!console_top_self_frags">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Other Player Frags</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_other_frags"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.other-frags" />
                                        <span data-if="console_top_other_frags">Shown</span>
                                        <span data-if="!console_top_other_frags">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Team Kills</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_top_team_kills"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.top.team-kills" />
                                        <span data-if="console_top_team_kills">Shown</span>
                                        <span data-if="!console_top_team_kills">Hidden</span>
                                    </label>
                                </div>
                            </div>

                            <div class="settings-section settings-compact-section panel settings-console-column">
                                <div class="settings-control-title">Full Console Filter</div>
                                <div class="settings-control-description">
                                    Message types kept in the full-console history, including public and team chat.
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Important Information</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_important"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.important" />
                                        <span data-if="console_full_important">Shown</span>
                                        <span data-if="!console_full_important">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Warnings</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_warnings"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.warnings" />
                                        <span data-if="console_full_warnings">Shown</span>
                                        <span data-if="!console_full_warnings">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Errors</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_errors"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.errors" />
                                        <span data-if="console_full_errors">Shown</span>
                                        <span data-if="!console_full_errors">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Script Messages</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_script"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.script" />
                                        <span data-if="console_full_script">Shown</span>
                                        <span data-if="!console_full_script">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Chat</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_chat"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.chat" />
                                        <span data-if="console_full_chat">Shown</span>
                                        <span data-if="!console_full_chat">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Team Chat</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_team_chat"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.team-chat" />
                                        <span data-if="console_full_team_chat">Shown</span>
                                        <span data-if="!console_full_team_chat">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Game Events</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_game_events"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.game-events" />
                                        <span data-if="console_full_game_events">Shown</span>
                                        <span data-if="!console_full_game_events">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Self Frags</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_self_frags"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.self-frags" />
                                        <span data-if="console_full_self_frags">Shown</span>
                                        <span data-if="!console_full_self_frags">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Other Player Frags</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_other_frags"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.other-frags" />
                                        <span data-if="console_full_other_frags">Shown</span>
                                        <span data-if="!console_full_other_frags">Hidden</span>
                                    </label>
                                </div>
                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Team Kills</div>
                                    </div>
                                    <label class="checkbox-row settings-display-toggle">
                                        <input class="checkbox" type="checkbox"
                                            data-attrif-checked="console_full_team_kills"
                                            data-attrif-disabled="!console_available"
                                            onclick="settings.console.full.team-kills" />
                                        <span data-if="console_full_team_kills">Shown</span>
                                        <span data-if="!console_full_team_kills">Hidden</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Top-left Size</div>
                                    <div class="settings-control-description">
                                        Set the top-left console height in lines.
                                    </div>
                                </div>
                                <div class="settings-stepper">
                                    <button class="button settings-stepper-button"
                                        data-attrif-disabled="!console_available"
                                        onclick="settings.console.size.decrease">-</button>
                                    <input class="text-input settings-stepper-value"
                                        type="text" maxlength="3"
                                        data-value="console_size_input"
                                        data-class-is-invalid="console_size_invalid"
                                        data-attrif-disabled="!console_available"
                                        onfocus="settings.console.size.focus"
                                        onblur="settings.console.size.blur"
                                        onkeyup="settings.console.size.commit" />
                                    <button class="button settings-stepper-button"
                                        data-attrif-disabled="!console_available"
                                        onclick="settings.console.size.increase">+</button>
                                </div>
                            </div>
                            <div class="settings-control-footer settings-control-footer-compact">
                                <span>Range&nbsp;&nbsp;{{ console_size_minimum }} - {{ console_size_maximum }}</span>
                            </div>
                        </div>

                        <div class="settings-info-row">
                            <div class="settings-info-block">
                                <div class="settings-info-label">Application</div>
                                <div class="settings-info-value">Immediate</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Chat Routing</div>
                                <div class="settings-info-value">Owned by Chat</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Persistence</div>
                                <div class="settings-info-value">Saved automatically</div>
                            </div>
                        </div>
                        <div class="settings-control-footer settings-control-footer-compact"
                            data-if="console_status != ''">
                            <span>{{ console_status }}</span>
                        </div>
                    </div>

                    <div class="settings-page" data-if="category_interface">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Interface / Appearance</div>
                            <div class="settings-stage-title">Theme</div>
                            <div class="settings-stage-copy">
                                Choose the visual language used by Cowbraten menus. The selection applies immediately and is saved automatically.
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Menu Theme</div>
                                    <div class="settings-control-description">
                                        This changes interface colors, surfaces, borders, and component styling. Gameplay rendering is unaffected.
                                    </div>
                                </div>
                            </div>

                            <div class="settings-theme-grid" data-if="theme_available">
                                <button class="button settings-theme-choice"
                                    data-class-is-selected="theme_default"
                                    data-event-click="select_theme(0)">
                                    <span class="settings-theme-name">Default</span>
                                    <span class="settings-theme-description">Clean Cowbraten interface</span>
                                    <span class="settings-theme-state" data-if="theme_default">Active</span>
                                </button>
                                <button class="button settings-theme-choice"
                                    data-class-is-selected="theme_modern_metallic"
                                    data-event-click="select_theme(1)">
                                    <span class="settings-theme-name">Modern Metallic</span>
                                    <span class="settings-theme-description">Dark metal surfaces and vivid accents</span>
                                    <span class="settings-theme-state" data-if="theme_modern_metallic">Active</span>
                                </button>
                            </div>

                            <div class="settings-control-description" data-if="!theme_available">
                                Theme selection is unavailable in this build.
                            </div>
                        </div>

                        <div class="settings-section settings-subsection-panel panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Size and readability</div>
                                    <div class="settings-control-description">
                                        Scale the complete interface or increase only its typography. Both settings apply immediately to menus, overlays, chat, console, and scoreboard.
                                    </div>
                                </div>
                            </div>

                            <div data-if="interface_appearance_available">
                                <div class="settings-appearance-presets">
                                    <div class="settings-appearance-preset-row">
                                        <button class="button settings-appearance-preset"
                                            data-class-is-selected="interface_scale == 90 &amp;&amp; interface_text_scale == 90"
                                            data-event-click="select_interface_preset(0)">
                                            <span class="settings-appearance-preset-name">Compact</span>
                                            <span class="settings-appearance-preset-value">90 / 90</span>
                                        </button>
                                        <button class="button settings-appearance-preset"
                                            data-class-is-selected="interface_scale == 100 &amp;&amp; interface_text_scale == 100"
                                            data-event-click="select_interface_preset(1)">
                                            <span class="settings-appearance-preset-name">Default</span>
                                            <span class="settings-appearance-preset-value">100 / 100</span>
                                        </button>
                                    </div>
                                    <div class="settings-appearance-preset-row">
                                        <button class="button settings-appearance-preset"
                                            data-class-is-selected="interface_scale == 100 &amp;&amp; interface_text_scale == 115"
                                            data-event-click="select_interface_preset(2)">
                                            <span class="settings-appearance-preset-name">Readable</span>
                                            <span class="settings-appearance-preset-value">100 / 115</span>
                                        </button>
                                        <button class="button settings-appearance-preset"
                                            data-class-is-selected="interface_scale == 110 &amp;&amp; interface_text_scale == 125"
                                            data-event-click="select_interface_preset(3)">
                                            <span class="settings-appearance-preset-name">Large</span>
                                            <span class="settings-appearance-preset-value">110 / 125</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="settings-appearance-controls">
                                    <div class="settings-appearance-control">
                                        <div class="settings-display-row">
                                            <div class="settings-control-copy">
                                                <div class="settings-control-title">Interface scale</div>
                                                <div class="settings-control-description">Controls, spacing, icons, and text together.</div>
                                            </div>
                                            <div class="settings-value">
                                                <span class="settings-value-number">{{ interface_scale }}</span>
                                                <span class="settings-value-unit">%</span>
                                            </div>
                                        </div>
                                        <div class="settings-range-row">
                                            <span class="settings-range-bound">{{ interface_scale_minimum }}</span>
                                            <input class="settings-range"
                                                type="range" min="75" max="150" step="5"
                                                data-attr-min="interface_scale_minimum"
                                                data-attr-max="interface_scale_maximum"
                                                data-attr-value="interface_scale"
                                                data-event-change="select_interface_scale(ev.value)" />
                                            <span class="settings-range-bound settings-range-maximum">{{ interface_scale_maximum }}</span>
                                        </div>
                                    </div>

                                    <div class="settings-appearance-control">
                                        <div class="settings-display-row">
                                            <div class="settings-control-copy">
                                                <div class="settings-control-title">Text size</div>
                                                <div class="settings-control-description">Root rem size, independent from control dimensions.</div>
                                            </div>
                                            <div class="settings-value">
                                                <span class="settings-value-number">{{ interface_text_scale }}</span>
                                                <span class="settings-value-unit">%</span>
                                            </div>
                                        </div>
                                        <div class="settings-range-row">
                                            <span class="settings-range-bound">{{ interface_text_scale_minimum }}</span>
                                            <input class="settings-range"
                                                type="range" min="75" max="150" step="5"
                                                data-attr-min="interface_text_scale_minimum"
                                                data-attr-max="interface_text_scale_maximum"
                                                data-attr-value="interface_text_scale"
                                                data-event-change="select_interface_text_scale(ev.value)" />
                                            <span class="settings-range-bound settings-range-maximum">{{ interface_text_scale_maximum }}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="settings-font-choices">
                                    <div class="settings-control-title">Typeface</div>
                                    <div class="settings-control-description">Choose between the Cowbraten 1.0.1 console typeface and the modern interface typeface.</div>
                                    <div class="settings-font-choice-row">
                                        <button class="button settings-font-choice settings-font-choice-legacy"
                                            data-class-is-selected="interface_font_legacy"
                                            data-event-click="select_interface_font(0)">Legacy</button>
                                        <button class="button settings-font-choice settings-font-choice-lato"
                                            data-class-is-selected="interface_font_lato"
                                            data-event-click="select_interface_font(1)">Lato</button>
                                    </div>
                                </div>

                                <div class="settings-appearance-actions">
                                    <span class="settings-control-description">QHD uses a subtle automatic boost; stronger scaling is reserved for 4K. Manual values are applied on top.</span>
                                    <button class="button" data-event-click="reset_interface_appearance()">Restore defaults</button>
                                </div>
                            </div>

                            <div class="settings-control-description" data-if="!interface_appearance_available">
                                Interface sizing is unavailable in this build.
                            </div>
                        </div>

                        <div class="settings-control-footer settings-control-footer-compact"
                            data-if="theme_status != '' || interface_appearance_status != ''">
                            <span data-if="interface_appearance_status != ''">{{ interface_appearance_status }}</span>
                            <span data-if="interface_appearance_status == ''">{{ theme_status }}</span>
                        </div>
                    </div>

                    <div class="settings-page" data-if="category_autoexec">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Advanced / Startup</div>
                            <div class="settings-stage-title">Autoexec</div>
                            <div class="settings-stage-copy">
                                Select the script loaded on the next launch. Original keeps autoexec.cfg, Disabled skips startup execution, and named profiles come from the autoexecs folder.
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Startup Profile</div>
                                    <div class="settings-control-description">
                                        Selecting a profile saves it as the default. Load now layers it onto the current session and does not undo commands already executed.
                                    </div>
                                </div>
                                <button class="button settings-autoexec-refresh"
                                    data-event-click="refresh_autoexec_profiles()">Refresh list</button>
                            </div>

                            <div class="settings-autoexec-list">
                                <div class="settings-autoexec-row"
                                    data-for="profile : autoexec_choices"
                                    data-class-is-selected="profile.selected">
                                    <button class="settings-autoexec-select"
                                        data-event-click="select_autoexec_profile(profile.id)">
                                        <span class="settings-autoexec-name">{{ profile.label }}</span>
                                        <span class="settings-autoexec-path"
                                            data-if="profile.id == 'original'">autoexec.cfg</span>
                                        <span class="settings-autoexec-path"
                                            data-if="profile.id != 'original' &amp;&amp; profile.id != 'none'">autoexecs/{{ profile.id }}.cfg</span>
                                        <span class="settings-autoexec-path"
                                            data-if="profile.id == 'none'">No startup script</span>
                                    </button>
                                    <span class="settings-autoexec-active"
                                        data-if="profile.selected">Default</span>
                                    <button class="button settings-autoexec-load"
                                        data-if="profile.id != 'none'"
                                        data-event-click="run_autoexec_profile(profile.id)">Load now</button>
                                </div>
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section panel">
                            <div class="settings-control-title">Adding profiles</div>
                            <div class="settings-control-description">
                                Create files such as autoexecs/duels.cfg or autoexecs/recording.cfg in your Cowbraten home directory, then refresh this list. Profile names may use letters, numbers, underscores, and hyphens.
                            </div>
                        </div>

                        <div class="settings-control-footer settings-control-footer-compact"
                            data-if="autoexec_status != ''">
                            <span>{{ autoexec_status }}</span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="settings-footer">
                <div>
                    <span data-if="category_game">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Game</span>
                    <span data-if="category_hud">Settings&nbsp;&nbsp;//&nbsp;&nbsp;HUD</span>
                    <span data-if="category_graphics">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Graphics</span>
                    <span data-if="category_audio">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Audio</span>
                    <span data-if="category_mouse_keyboard">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Mouse / Keyboard</span>
                    <span data-if="category_crosshair">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Crosshair</span>
                    <span data-if="category_chat">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Chat</span>
                    <span data-if="category_console">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Console</span>
                    <span data-if="category_interface">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Interface</span>
                    <span data-if="category_autoexec">Settings&nbsp;&nbsp;//&nbsp;&nbsp;Autoexec</span>
                </div>
                <div class="settings-footer-help">Escape returns to gameplay</div>
                <div class="settings-footer-status">
                    <span class="settings-live-indicator"></span>
                    <span>Engine connected</span>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
