<rml>
<head>
    <title>Cowbraten Settings</title>
    <link type="text/template" href="../templates/app_shell.rml" />
    <link type="text/rcss" href="../styles/base.rcss" />
    <link type="text/rcss" href="../styles/controls.rcss" />
    <link type="text/rcss" href="../styles/settings.rcss" />
</head>

<body template="app-shell" class="app-page-settings" data-model="settings">
    <div class="settings-screen">
        <div class="settings-shell panel">
            <div class="settings-header">
                <div class="settings-lockup">
                    <div class="settings-mark">C</div>
                    <div class="settings-heading">
                        <div class="settings-product">Cowbraten</div>
                        <div class="settings-title">Settings</div>
                    </div>
                </div>

                <button class="button settings-back" onclick="navigation.main">
                    <span class="cb-ico cb-ico-arrow-left cb-ico--sm"></span>Back&nbsp;&nbsp;/&nbsp;&nbsp;Main Menu
                </button>
            </div>

            <div class="settings-content">
                <div class="settings-navigation">
                    <div class="settings-navigation-label">Categories</div>
                    <div class="nav-list settings-nav-list">
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_game"
                            onclick="settings.category.game">
                            <span class="cb-ico cb-ico-gamepad cb-ico--md settings-nav-icon"></span>
                            <span>Game</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_hud"
                            onclick="settings.category.hud">
                            <span class="cb-ico cb-ico-monitor-check cb-ico--md settings-nav-icon"></span>
                            <span>HUD</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_graphics"
                            onclick="settings.category.graphics">
                            <span class="cb-ico cb-ico-monitor cb-ico--md settings-nav-icon"></span>
                            <span>Graphics</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_audio"
                            onclick="settings.category.audio">
                            <span class="cb-ico cb-ico-volume-2 cb-ico--md settings-nav-icon"></span>
                            <span>Audio</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_mouse_keyboard"
                            onclick="settings.category.mouse-keyboard">
                            <span class="cb-ico cb-ico-mouse cb-ico--md settings-nav-icon"></span>
                            <span>Mouse / Keyboard</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_crosshair"
                            onclick="settings.category.crosshair">
                            <span class="cb-ico cb-ico-crosshair cb-ico--md settings-nav-icon"></span>
                            <span>Crosshair</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_chat"
                            onclick="settings.category.chat">
                            <span class="cb-ico cb-ico-users cb-ico--md settings-nav-icon"></span>
                            <span>Chat</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_console"
                            onclick="settings.category.console">
                            <span class="cb-ico cb-ico-terminal cb-ico--md settings-nav-icon"></span>
                            <span>Console</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_interface"
                            onclick="settings.category.interface">
                            <span class="cb-ico cb-ico-palette cb-ico--md settings-nav-icon"></span>
                            <span>Interface</span>
                        </button>
                        <button class="nav-item settings-nav-item"
                            data-class-is-selected="category_autoexec"
                            onclick="settings.category.autoexec">
                            <span class="cb-ico cb-ico-code cb-ico--md settings-nav-icon"></span>
                            <span>Autoexec</span>
                        </button>
                    </div>

                    <div class="settings-scope-note" data-if="category_game">
                        <div class="settings-scope-kicker">Live Setting</div>
                        <div class="settings-scope-copy">
                            Gameplay changes are saved automatically. Opening this page never rewrites custom values.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_graphics">
                        <div class="settings-scope-kicker">Display State</div>
                        <div class="settings-scope-copy">
                            Display options report the active result after each change. Frame limiting applies immediately.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_hud">
                        <div class="settings-scope-kicker">Combat Information</div>
                        <div class="settings-scope-copy">
                            HUD options update immediately and keep their current layout when Settings is reopened.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_audio">
                        <div class="settings-scope-kicker">Existing Sound Mix</div>
                        <div class="settings-scope-copy">
                            Sound and music have separate levels. Setting Sound Volume to zero also mutes music.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_mouse_keyboard">
                        <div class="settings-scope-kicker">Gameplay Mouse</div>
                        <div class="settings-scope-copy">
                            Mouse settings affect gameplay look. Menu pointer speed continues to follow the operating system.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_crosshair">
                        <div class="settings-scope-kicker">Gameplay Reticle</div>
                        <div class="settings-scope-copy">
                            Each style includes its normal and hit appearance. Dynamic effects apply during gameplay.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_chat">
                        <div class="settings-scope-kicker">Message Routing</div>
                        <div class="settings-scope-copy">
                            Choose where public and team messages appear without changing message delivery.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_console">
                        <div class="settings-scope-kicker">Console Feeds</div>
                        <div class="settings-scope-copy">
                            Remaining top-left message types, the full-console history filter, and top-left size. Chat message routing stays on the Chat page.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_autoexec">
                        <div class="settings-scope-kicker">Startup Script</div>
                        <div class="settings-scope-copy">
                            Choose one startup script. Alternative profiles are discovered from autoexecs/*.cfg.
                        </div>
                    </div>
                    <div class="settings-scope-note" data-if="category_interface">
                        <div class="settings-scope-kicker">Visual Theme</div>
                        <div class="settings-scope-copy">
                            Theme changes apply immediately to every Cowbraten menu and remain selected after restart.
                        </div>
                    </div>
                </div>

                <div class="settings-stage">
                    <div class="settings-page" data-if="category_game">
                        <div class="settings-stage-header">
                            <div class="eyebrow settings-eyebrow">Game / Camera</div>
                            <div class="settings-stage-title">View</div>
                            <div class="settings-stage-copy">
                                Tune the horizontal field of view. Changes apply immediately and use Cowbraten's existing persistent setting.
                            </div>
                        </div>

                        <div class="settings-section panel">
                            <div class="settings-control-heading">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Field of View</div>
                                    <div class="settings-control-description">
                                        A wider view exposes more of the scene while making distant targets appear smaller.
                                    </div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ fov }}</span>
                                    <span class="settings-value-unit">degrees</span>
                                </div>
                            </div>

                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ fov_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="10"
                                    max="150"
                                    step="1"
                                    data-attr-min="fov_minimum"
                                    data-attr-max="fov_maximum"
                                    data-attr-value="fov"
                                    onchange="settings.fov" />
                                <span class="settings-range-bound settings-range-maximum">{{ fov_maximum }}</span>
                            </div>

                            <div class="settings-control-footer">
                                <span class="settings-live-indicator"></span>
                                <span>Live value&nbsp;&nbsp;//&nbsp;&nbsp;Saved automatically</span>
                            </div>
                        </div>

                        <div class="settings-info-row">
                            <div class="settings-info-block">
                                <div class="settings-info-label">Input</div>
                                <div class="settings-info-value">Mouse, arrows, or keyboard</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Range</div>
                                <div class="settings-info-value">{{ fov_minimum }} - {{ fov_maximum }} degrees</div>
                            </div>
                            <div class="settings-info-block">
                                <div class="settings-info-label">Application</div>
                                <div class="settings-info-value">Immediate</div>
                            </div>
                        </div>

                        <div class="settings-stage-header settings-subsection-header">
                            <div class="eyebrow settings-eyebrow">Game / Combat Feedback</div>
                            <div class="settings-stage-title">Feedback</div>
                            <div class="settings-stage-copy">
                                Configure combat feedback. Changes apply immediately.
                            </div>
                        </div>

                        <div class="settings-section settings-compact-section settings-subsection-panel panel">
                            <div class="settings-display-row">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Hit Sound</div>
                                    <div class="settings-control-description">
                                        Play the existing hit confirmation sound when you damage another player. While spectating, it follows the player you are watching.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="hit_sound"
                                        data-attrif-disabled="!game_feedback_available"
                                        data-event-change="select_hit_sound(ev.checked)" />
                                    <span data-if="hit_sound">On</span>
                                    <span data-if="!hit_sound">Off</span>
                                </label>
                            </div>

                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blood</div>
                                    <div class="settings-control-description">
                                        Spawn blood splash particles and gibs when players take damage. World blood decals remain a separate Graphics setting.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="blood"
                                        data-attrif-disabled="!game_feedback_available"
                                        data-event-change="select_blood(ev.checked)" />
                                    <span data-if="blood">On</span>
                                    <span data-if="!blood">Off</span>
                                </label>
                            </div>

                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Outline Capture Meters</div>
                                    <div class="settings-control-description">
                                        Draw a green outline around in-world meter particles, including capture-progress meters and player status bars.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="outline_capture_meters"
                                        data-attrif-disabled="!game_feedback_available"
                                        data-event-change="select_outline_capture_meters(ev.checked)" />
                                    <span data-if="outline_capture_meters">On</span>
                                    <span data-if="!outline_capture_meters">Off</span>
                                </label>
                            </div>

                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Show Scoreboard at Death</div>
                                    <div class="settings-control-description">
                                        Open the scoreboard when you die or are force-killed. Turning this off does not close a scoreboard that is already open.
                                    </div>
                                </div>
                                <label class="checkbox-row settings-display-toggle">
                                    <input class="checkbox" type="checkbox"
                                        data-attrif-checked="show_scoreboard_at_death"
                                        data-attrif-disabled="!game_feedback_available"
                                        data-event-change="select_show_scoreboard_at_death(ev.checked)" />
                                    <span data-if="show_scoreboard_at_death">On</span>
                                    <span data-if="!show_scoreboard_at_death">Off</span>
                                </label>
                            </div>

                            <div class="settings-control-footer settings-control-footer-compact"
                                data-if="game_feedback_status != ''">
                                <span>{{ game_feedback_status }}</span>
                            </div>
                        </div>

                        <div class="settings-stage-header settings-subsection-header">
                            <div class="eyebrow settings-eyebrow">Game / Trail Colors</div>
                            <div class="settings-stage-title">Trail Colors</div>
                            <div class="settings-stage-copy">
                                Set the RGB trail color for each weapon. Changes appear on the next projectile or particle trail.
                            </div>
                        </div>

                        <div id="settings-trailcolors" class="settings-section settings-compact-section settings-subsection-panel settings-trail-colors panel">
                            <div class="settings-display-row settings-color-weapon settings-color-weapon-first">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Shotgun</div>
                                    <div class="settings-control-description">
                                        Streak color for shotgun pellets.
                                    </div>
                                </div>
                                <div class="settings-color-swatch"
                                    data-style-background-color="'rgb(' + trail_color_shotgun_red + ',' + trail_color_shotgun_green + ',' + trail_color_shotgun_blue + ')'"></div>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Red</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_shotgun_red }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_shotgun_red"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(0, 0, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Green</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_shotgun_green }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_shotgun_green"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(0, 1, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blue</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_shotgun_blue }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_shotgun_blue"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(0, 2, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>

                            <div class="settings-display-row settings-control-divider settings-color-weapon">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Chaingun</div>
                                    <div class="settings-control-description">
                                        Streak color for chaingun rounds.
                                    </div>
                                </div>
                                <div class="settings-color-swatch"
                                    data-style-background-color="'rgb(' + trail_color_chaingun_red + ',' + trail_color_chaingun_green + ',' + trail_color_chaingun_blue + ')'"></div>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Red</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_chaingun_red }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_chaingun_red"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(1, 0, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Green</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_chaingun_green }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_chaingun_green"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(1, 1, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blue</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_chaingun_blue }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_chaingun_blue"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(1, 2, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>

                            <div class="settings-display-row settings-control-divider settings-color-weapon">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Rocket Launcher</div>
                                    <div class="settings-control-description">
                                        Smoke trail color for rockets.
                                    </div>
                                </div>
                                <div class="settings-color-swatch"
                                    data-style-background-color="'rgb(' + trail_color_rocket_launcher_red + ',' + trail_color_rocket_launcher_green + ',' + trail_color_rocket_launcher_blue + ')'"></div>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Red</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_rocket_launcher_red }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_rocket_launcher_red"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(2, 0, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Green</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_rocket_launcher_green }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_rocket_launcher_green"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(2, 1, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blue</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_rocket_launcher_blue }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_rocket_launcher_blue"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(2, 2, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>

                            <div class="settings-display-row settings-control-divider settings-color-weapon">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Rifle</div>
                                    <div class="settings-control-description">
                                        Smoke trail color for rifle shots.
                                    </div>
                                </div>
                                <div class="settings-color-swatch"
                                    data-style-background-color="'rgb(' + trail_color_rifle_red + ',' + trail_color_rifle_green + ',' + trail_color_rifle_blue + ')'"></div>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Red</div>
                                </div>
                                <div class="settings-value">
