                                            onblur="settings.hud.frag-messages.duration.blur"
                                            onkeyup="settings.hud.frag-messages.duration.commit" />
                                        <button class="button settings-stepper-button"
                                            onclick="settings.hud.frag-messages.duration.increase">+</button>
                                    </div>
                                </div>
                                <div class="settings-control-footer settings-control-footer-compact">
                                    <span>Range&nbsp;&nbsp;{{ frag_message_duration_minimum }} - {{ frag_message_duration_maximum }} seconds</span>
                                </div>

