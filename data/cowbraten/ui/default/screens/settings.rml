                                        data-class-is-selected="ammobar_align_last"
                                        data-attrif-disabled="!ammobar_available"
                                        data-event-click="select_ammobar_align(1)">Last icon</button>
                                </div>

                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">X</div>
