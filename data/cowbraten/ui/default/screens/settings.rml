                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_grenade_launcher_green"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(4, 1, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blue</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_grenade_launcher_blue }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_grenade_launcher_blue"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(4, 2, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>

                            <div class="settings-display-row settings-control-divider settings-color-weapon">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Pistol</div>
                                    <div class="settings-control-description">
                                        Streak color for pistol shots.
                                    </div>
                                </div>
                                <div class="settings-color-swatch"
                                    data-style-background-color="'rgb(' + trail_color_pistol_red + ',' + trail_color_pistol_green + ',' + trail_color_pistol_blue + ')'"></div>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Red</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_pistol_red }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_pistol_red"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(5, 0, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Green</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_pistol_green }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_pistol_green"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(5, 1, ev.value)" />
                                <span class="settings-range-bound settings-range-maximum">{{ trail_color_channel_maximum }}</span>
                            </div>
                            <div class="settings-display-row settings-control-divider">
                                <div class="settings-control-copy">
                                    <div class="settings-control-title">Blue</div>
                                </div>
                                <div class="settings-value">
                                    <span class="settings-value-number">{{ trail_color_pistol_blue }}</span>
                                </div>
                            </div>
                            <div class="settings-range-row">
                                <span class="settings-range-bound">{{ trail_color_channel_minimum }}</span>
                                <input class="settings-range"
                                    type="range"
                                    min="0"
                                    max="255"
                                    step="1"
                                    data-attr-min="trail_color_channel_minimum"
                                    data-attr-max="trail_color_channel_maximum"
                                    data-attr-value="trail_color_pistol_blue"
                                    data-attrif-disabled="!trail_colors_available"
                                    data-event-change="select_trail_color_channel(5, 2, ev.value)" />
