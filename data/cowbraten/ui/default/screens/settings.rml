                                    <span>Range&nbsp;&nbsp;{{ ammobar_label_size_minimum }} - {{ ammobar_label_size_maximum }}</span>
                                </div>

                                <div class="settings-display-row settings-control-divider">
                                    <div class="settings-control-copy">
                                        <div class="settings-control-title">Label Offset</div>
                                        <div class="settings-control-description">
