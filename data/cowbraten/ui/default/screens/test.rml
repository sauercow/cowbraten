<rml>
<head>
    <title>Cowbraten UI Test</title>
    <style>
        body
        {
            margin: 0;
            width: 100%;
            height: 100%;
            background-color: transparent;
        }

        #panel
        {
            position: absolute;
            left: 64px;
            top: 64px;
            width: 360px;
            height: 240px;

            background-color: rgba(28, 32, 40, 220);

            border-width: 3px;
            border-color: rgb(70, 150, 220);
        }

        #accent
        {
            position: absolute;
            left: 24px;
            top: 24px;
            width: 8px;
            height: 192px;

            background-color: rgb(70, 150, 220);
        }

        #test-button
        {
            position: absolute;
            left: 56px;
            top: 40px;
            width: 240px;
            height: 48px;

            padding: 0;
            background-color: rgba(45, 52, 64, 240);

            border-width: 2px;
            border-color: rgb(95, 105, 120);

            font-family: Lato;
            font-size: 20px;
            color: #ffffff;
        }

        #test-button:hover
        {
            background-color: rgb(70, 150, 220);
            border-color: rgb(150, 210, 255);
        }

        #test-button.clicked
        {
            background-color: rgb(210, 115, 55);
            border-color: rgb(255, 185, 120);
        }

        #test-input
        {
            position: absolute;
            left: 56px;
            top: 112px;
            width: 240px;
            height: 40px;

            padding-left: 12px;
            background-color: rgba(18, 22, 28, 245);

            border-width: 2px;
            border-color: rgb(95, 105, 120);

            font-family: Lato;
            font-size: 18px;
            color: #ffffff;
        }

        #test-input:focus
        {
            border-color: rgb(70, 150, 220);
        }

        #title
        {
            position: absolute;
            left: 56px;
            top: 184px;

            font-family: Lato;
            font-size: 24px;
            color: #ffffff;
        }
    </style>
</head>

<body>
    <div id="panel">
        <div id="accent"></div>
        <button id="test-button">TEST BUTTON</button>
        <input id="test-input" type="text" maxlength="24" placeholder="TYPE HERE" />
        <div id="title">COWBRATEN UI</div>
    </div>
</body>
</rml>
